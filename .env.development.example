# =============================================================================
# 本地开发环境 — Windows 11
# 用法：复制为项目根目录 .env
#   copy .env.development.example .env
# 切勿将填好真实密钥的 .env 提交到 Git
# =============================================================================

APP_ENV=development
APP_NAME=SmartNoodleHouse
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# 本机 MySQL / Redis（Windows 上一般装在本机）
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=dev-only-change-me-to-random-32chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FACE_ENCRYPTION_KEY=dev-face-key-32bytes!!!!!!!!!!

# 开发沙箱（生产必须全部为 false）
ALLOW_PAYMENT_MOCK=true
ALLOW_AUTH_MOCK=true
ALLOW_OPENCV_FACE_FALLBACK=true
ALLOW_DELIVERY_MOCK=true
ENABLE_RATE_LIMIT=false

# 跨域与 H5 扫码落地页
# 模拟器：127.0.0.1；手机扫 H5 桌台码：加上局域网 IP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.110:5173
H5_PUBLIC_BASE_URL=http://192.168.1.110:5173
DEV_LAN_HOST=192.168.1.110
# 桌台码跳转小程序版本：develop | trial | release
MINI_PROGRAM_ENV_VERSION=develop

VITE_API_BASE_URL=/api/v1

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
STORAGE_BACKEND=local

JSON_LOGS=false
LOG_LEVEL=DEBUG

WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REQUIRE_ALLOWLIST=false

# 微信 / 支付宝 — 开发可留空，配合 ALLOW_AUTH_MOCK
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NOTIFY_URL=

ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

PROCESS_ROLE=leader
ENABLE_RECOGNITION_WORKER=1
