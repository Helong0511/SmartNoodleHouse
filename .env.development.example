# =============================================================================
# 本地开发环境 — Windows 11（联调 / 真机调试）
# 用法：copy .env.development.example .env
# 配套：miniprogram-*/config/env.js 的 DEV_LAN_HOST 与本文件一致
#
# 切勿将填好真实密钥的 .env 提交到 Git
# 字段真源：backend/app/core/config.py 的 Settings
# =============================================================================

# 分类目录（一级大类）
#   一、基础设施  —  进程监听、时区、数据库、缓存、日志 — 服务能跑起来的底座
#   二、安全与认证  —  JWT、业务加密、Mock 沙箱、Webhook / 反代信任 — 生产必须收紧
#   三、对外入口与前端  —  跨域、H5 一码通扫、桌台码、Vite 构建前缀
#   四、文件存储  —  本地上传目录或 S3/MinIO 对象存储
#   五、支付渠道  —  微信 / 支付宝登录与支付凭证（与小程序 AppID 对齐）
#   六、小程序能力开关  —  种子默认值；运行时优先 system_settings，经 GET /miniprogram/config 下发
#   七、外卖平台  —  美团 / 饿了么开放平台与门店兜底策略
#   八、门店现场设备  —  厨房打印、TTS、摄像头、识别进程角色
#   九、业务参数种子  —  写入 system_settings 的默认值；运行中以后台「业务参数 / 门店设置」为准
#   十、初始化超管  —  仅 scripts/初始化管理员.py，非运行时 Settings

#=============================================================================
# 【一、基础设施】
# 进程监听、时区、数据库、缓存、日志 — 服务能跑起来的底座
#=============================================================================

# ---------------------------------------------------------------------------
# >> 应用进程
# ---------------------------------------------------------------------------
# 运行环境：development | production（影响启动校验、mock 是否允许、小程序码默认版本）
# 生产必须为 production；误写成 development 会放宽安全校验
APP_ENV=development
# 应用名称，写入日志与部分对外标识
APP_NAME=SmartNoodleHouse
# 后端监听地址：开发真机调试用 0.0.0.0；生产经 Nginx 反代时常用 127.0.0.1
APP_HOST=0.0.0.0
# 后端 HTTP 端口（uvicorn），默认 8000
APP_PORT=8000
# 是否开启 FastAPI/调试行为：生产必须 false
# 注意：不控制 SQL 打印，SQL 见 DB_ECHO
APP_DEBUG=true
# 业务时区（订单超时、定时任务等），默认 Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# >> 数据库 MySQL
# ---------------------------------------------------------------------------
# 异步 MySQL 连接串（aiomysql）
# 格式：mysql+aiomysql://用户:密码@主机:端口/库名?charset=utf8mb4
# 密码含特殊字符须 URL 编码
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4
# 每进程 SQLAlchemy 连接池常驻连接数
# gunicorn -w N 时总连接约 N*(POOL+OVERFLOW)，注意 MySQL max_connections
DB_POOL_SIZE=5
# 连接池最大溢出连接数（峰值临时连接）
DB_MAX_OVERFLOW=10
# 是否打印 SQL：true 日志量极大，仅排障时临时开启
DB_ECHO=false

# ---------------------------------------------------------------------------
# >> 缓存 Redis
# ---------------------------------------------------------------------------
# Redis（缓存、活体挑战、Leader 锁、WebSocket Pub/Sub、限流等）
# 生产勿指向无关共享实例
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# >> 日志落盘
# ---------------------------------------------------------------------------
# 是否输出 JSON 结构化日志；生产建议 true 便于采集
JSON_LOGS=false
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# 日志根目录；子目录 backend/frontend/wechat/alipay
LOG_DIR=logs

#=============================================================================
# 【二、安全与认证】
# JWT、业务加密、Mock 沙箱、Webhook / 反代信任 — 生产必须收紧
#=============================================================================

# ---------------------------------------------------------------------------
# >> JWT 令牌
# ---------------------------------------------------------------------------
# JWT 签名密钥，至少 32 位高熵随机串；可用 python scripts/gen_secrets.py 生成
# 泄露须立即轮换并使旧 token 失效
JWT_SECRET=dev-only-change-me-to-random-32chars-min
# JWT 算法，仅允许 HS256（启动校验会拒绝其他算法）
JWT_ALGORITHM=HS256
# 员工后台 JWT 有效期（分钟），默认 1440=24 小时
JWT_EXPIRE_MINUTES=1440
# 顾客小程序 JWT 独立有效期（分钟），默认 1440；勿与员工令牌混用
CUSTOMER_JWT_EXPIRE_MINUTES=1440
# JWT aud 声明；解码时强制校验，防止跨系统令牌误用
JWT_AUDIENCE=smart-noodle-house

# ---------------------------------------------------------------------------
# >> 业务 / 人脸加密密钥
# ---------------------------------------------------------------------------
# 人脸特征向量加密材料（Fernet 派生）；须稳定高熵串
# 丢失则历史 face_profiles 无法解密
FACE_ENCRYPTION_KEY=dev-face-key-32bytes!!!!!!!!!!
# 密钥轮换：旧 FACE_ENCRYPTION_KEY，用于解密历史向量；新采集只用当前 KEY
# 调度重加密完成后可清空；无轮换需求保持空
FACE_ENCRYPTION_KEY_PREVIOUS=
# 平台 Token 等业务密钥加密材料；留空则回退 FACE_ENCRYPTION_KEY
# 生产建议单独设置高熵随机串
SECRET_ENCRYPTION_KEY=dev-secret-encryption-key-32bytes!!

# ---------------------------------------------------------------------------
# >> 沙箱 Mock（生产必须全部 false）
# ---------------------------------------------------------------------------
# 未开通真实支付时本地模拟入账；生产启动校验拒绝 true
ALLOW_PAYMENT_MOCK=true
# 允许 mock 微信/支付宝登录 code；生产必须 false
ALLOW_AUTH_MOCK=true
# 无 InsightFace 时用 OpenCV 弱特征兜底；仅开发，生产禁止
ALLOW_OPENCV_FACE_FALLBACK=true
# 外卖未配密钥时接口返回 mock 成功；生产必须 false
ALLOW_DELIVERY_MOCK=true
# 凭证不全时是否模拟打印成功（仅日志）；生产必须 false
ALLOW_PRINT_MOCK=true
# API 限流总开关；生产建议 true，本地可 false 便于压测
ENABLE_RATE_LIMIT=false

# ---------------------------------------------------------------------------
# >> Webhook 与反代信任
# ---------------------------------------------------------------------------
# 支付/外卖回调 IP 白名单，逗号分隔，支持 CIDR；空=不限制
WEBHOOK_IP_ALLOWLIST=
# true=必须命中白名单才接受回调；生产建议 true 并配齐 IP
WEBHOOK_REQUIRE_ALLOWLIST=false
# Webhook 请求体最大字节，超限 413；默认 524288=512KB
WEBHOOK_MAX_BODY_BYTES=524288
# 可信反代 peer（本机看到的直连 IP），仅这些才信任 X-Real-IP / X-Forwarded-For
# 逗号分隔，支持 CIDR；防客户端伪造转发头
TRUSTED_PROXY_IPS=127.0.0.1,::1

#=============================================================================
# 【三、对外入口与前端】
# 跨域、H5 一码通扫、桌台码、Vite 构建前缀
#=============================================================================

# ---------------------------------------------------------------------------
# >> 跨域 / H5 / 桌台码
# ---------------------------------------------------------------------------
# 允许的前端 Origin，逗号分隔；生产填 HTTPS 主站域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.110:5173
# 一码通扫/H5 桌台码对外域名；留空则用 CORS_ORIGINS 首项
# 真机扫码勿用 127.0.0.1，须局域网或公网可达地址
H5_PUBLIC_BASE_URL=http://192.168.1.110:5173
# 本机局域网 IP，与 miniprogram-*/config/env.js 的 DEV_LAN_HOST 一致
# 仅开发真机调试使用；生产留空
DEV_LAN_HOST=192.168.1.110
# 桌台码跳转小程序版本：develop | trial | release；留空则按 APP_ENV 推断
# 生产务必 release
MINI_PROGRAM_ENV_VERSION=develop

# ---------------------------------------------------------------------------
# >> 前端 Vite（构建时读取，非后端 Settings）
# ---------------------------------------------------------------------------
# 前端 Vite 构建时注入的 API 前缀（非后端 Settings）
# 开发常用 /api 或 /api/v1（由 vite 代理）；生产由 Nginx 反代
VITE_API_BASE_URL=/api

#=============================================================================
# 【四、文件存储】
# 本地上传目录或 S3/MinIO 对象存储
#=============================================================================

# ---------------------------------------------------------------------------
# >> 上传与对象存储
# ---------------------------------------------------------------------------
# 本地上传根目录（相对仓库根或绝对路径）；含 avatars/products/visitors 等
UPLOAD_DIR=uploads
# 单文件上传上限（MB）；后台 system_settings 可覆盖种子
MAX_UPLOAD_SIZE_MB=5
# 允许的图片扩展名，逗号分隔
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
# 存储后端：local=本地磁盘 | s3=S3/MinIO 兼容
STORAGE_BACKEND=local
# S3/MinIO Endpoint；STORAGE_BACKEND=local 时可留空
S3_ENDPOINT=
# S3 Access Key
S3_ACCESS_KEY=
# S3 Secret Key
S3_SECRET_KEY=
# S3 Bucket 名称
S3_BUCKET=
# S3 Region，默认 us-east-1
S3_REGION=us-east-1
# 对外访问 CDN/域名；留空则用 Endpoint 拼装
S3_PUBLIC_BASE_URL=

#=============================================================================
# 【五、支付渠道】
# 微信 / 支付宝登录与支付凭证（与小程序 AppID 对齐）
#=============================================================================

# ---------------------------------------------------------------------------
# >> 微信支付 / 微信小程序
# ---------------------------------------------------------------------------
# 微信小程序 AppID（须与 miniprogram-wechat 配置一致）
WECHAT_APP_ID=wx_REPLACE_WITH_YOUR_APPID
# 微信小程序 AppSecret；勿提交真实值到 Git
WECHAT_APP_SECRET=replace_with_wechat_app_secret_not_real
# 微信支付商户号 mch_id
WECHAT_MCH_ID=
# 微信支付 APIv3 密钥（32 字节）
WECHAT_API_V3_KEY=
# 微信支付 APIv2 密钥（付款码等 V2 接口独立密钥，勿与 V3 混用）
WECHAT_API_V2_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# 商户 API 私钥 PEM 路径（apiclient_key.pem）
WECHAT_PRIVATE_KEY_PATH=certs/wechat_apiclient_key.pem
# 支付结果异步通知 URL（须公网 HTTPS）
WECHAT_NOTIFY_URL=http://192.168.1.110:8000/api/payments/wechat/notify
# 退款结果回调 URL；留空则复用 WECHAT_NOTIFY_URL（按 event_type 分流）
WECHAT_REFUND_NOTIFY_URL=
# 微信平台公钥 PEM 内容（回调验签）；可与 CERT_PATH 二选一/互补
WECHAT_PLATFORM_PUBLIC_KEY=
# 微信平台证书 PEM 文件路径
WECHAT_PLATFORM_CERT_PATH=certs/wechat_platform_cert.pem
# 小程序订阅消息模板 ID：出餐/待取餐提醒；未申请可留空
WECHAT_SUBSCRIBE_TEMPLATE_ORDER_READY=

# ---------------------------------------------------------------------------
# >> 支付宝支付 / 支付宝小程序
# ---------------------------------------------------------------------------
# 支付宝开放平台应用 AppID（与小程序一致）
ALIPAY_APP_ID=2021000000000000
# 应用私钥 PKCS8 内容（勿提交真实密钥）；用于签名
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（验签用，非应用私钥）
ALIPAY_PUBLIC_KEY=
# 接口内容加密 AES Key（Base64）；一键取手机号等；开发可占位
ALIPAY_AES_KEY=replace_with_alipay_aes_key_base64==
# 支付宝网关，正式环境默认 openapi.alipay.com
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 支付宝异步通知 URL（须公网 HTTPS）
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payments/alipay/notify
# 支付完成同步跳转（H5/结果页）
ALIPAY_RETURN_URL=https://your-domain.com/order/result

#=============================================================================
# 【六、小程序能力开关】
# 种子默认值；运行时优先 system_settings，经 GET /miniprogram/config 下发
#=============================================================================

# ---------------------------------------------------------------------------
# >> 隐私授权入口（微信 / 支付宝）
# ---------------------------------------------------------------------------
# 支付宝头像授权入口；经 GET /miniprogram/config 下发
ENABLE_ALIPAY_AVATAR=true
# 支付宝昵称授权入口
ENABLE_ALIPAY_NICKNAME=true
# 支付宝一键手机号；个人主体通常 false；企业已开通能力可 true
ENABLE_ALIPAY_PHONE_BIND=false
# 微信头像 chooseAvatar 入口
ENABLE_WX_AVATAR=true
# 微信昵称 nickname 入口
ENABLE_WX_NICKNAME=true
# 微信一键手机号；个人主体通常 false
ENABLE_WX_PHONE_BIND=false

# ---------------------------------------------------------------------------
# >> 会员 / 点餐 / 叫号展示
# ---------------------------------------------------------------------------
# 会员中心「人脸迎宾」入口；false=隐藏并拒绝注册（默认关闭）
# 后台「平台·迎宾与人脸」可热更同名配置
ENABLE_FACE_WELCOME=false
# 点餐页搜索框种子默认；门店业务参数可覆盖
SHOW_MENU_SEARCH=false
# 点餐页智能口味条种子默认
SHOW_MENU_SMART_TASTE=false
# 点餐页猜你喜欢种子默认
SHOW_MENU_GUESS_YOU_LIKE=false
# 会员中心无可用券时隐藏券区
HIDE_MEMBER_EMPTY_WALLET=true
# 大厅叫号屏总开关种子；开启后使用 /display 与 DISPLAY_SCREEN_TOKEN
ENABLE_CUSTOMER_DISPLAY=false
# 注册会员自动赠券模板名，须与 coupon_templates.name 完全一致且启用
WELCOME_COUPON_NAME=新客满30减5

#=============================================================================
# 【七、外卖平台】
# 美团 / 饿了么开放平台与门店兜底策略
#=============================================================================

# ---------------------------------------------------------------------------
# >> 美团外卖
# ---------------------------------------------------------------------------
# 美团开放平台 app_id
MEITUAN_APP_ID=
# 美团 app_secret
MEITUAN_APP_SECRET=
# 全局默认美团门店/poi（多店优先用 platform_store_bindings）
MEITUAN_SHOP_ID=
# 美团回调通知 URL
MEITUAN_NOTIFY_URL=
# 美团 API 根地址
MEITUAN_API_BASE=https://waimaiopen.meituan.com

# ---------------------------------------------------------------------------
# >> 饿了么
# ---------------------------------------------------------------------------
# 饿了么 app_id
ELEME_APP_ID=
# 饿了么 app_secret
ELEME_APP_SECRET=
# 全局默认饿了么门店 ID
ELEME_SHOP_ID=
# 饿了么 access_token（可被门店绑定表覆盖）
ELEME_ACCESS_TOKEN=
# 饿了么回调 URL
ELEME_NOTIFY_URL=
# 饿了么 API 根地址
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1

# ---------------------------------------------------------------------------
# >> 外卖业务策略
# ---------------------------------------------------------------------------
# 新外卖单是否自动向平台 confirm；可按门店 system_settings 覆盖
DELIVERY_AUTO_CONFIRM=false
# 仅当库中无 platform_store_bindings 时，允许 .env 全局 Token 用于该本系统门店 ID
# 0=禁用；多店生产必须 0，强制走绑定表
DELIVERY_ENV_FALLBACK_STORE_ID=0

#=============================================================================
# 【八、门店现场设备】
# 厨房打印、TTS、摄像头、识别进程角色
#=============================================================================

# ---------------------------------------------------------------------------
# >> 厨房热敏打印（芯烨 XP-80T / 云打印）
# ---------------------------------------------------------------------------
# 打印总开关（历史名 XPYUN_ENABLED）；true 才实际出纸/调云 API
XPYUN_ENABLED=false
# local=局域网 ESC/POS（XP-80T WiFi+TCP 9100）；xpyun=芯烨云打印机 API
PRINTER_MODE=local
# 局域网打印机 IP（local 模式必填）
PRINTER_HOST=
# ESC/POS 端口，XP-80T 默认 9100
PRINTER_PORT=9100
# 芯烨云账号（仅 xpyun 模式）
XPYUN_USER=
# 芯烨云密钥
XPYUN_USER_KEY=
# 芯烨云打印机 SN
XPYUN_PRINTER_SN=
# 芯烨云 OpenAPI 根地址
XPYUN_API_BASE=https://open.xpyun.net/api/openapi/xprinter
# 每次打印份数 1～5
XPYUN_PRINT_COPIES=1
# 云打印语音：0取消单 1静音 2来单 3退单（仅 xpyun）
XPYUN_VOICE=2
# 制作单底部订单号：barcode=条码+单号 | text=仅文字 | off=不打印
KITCHEN_TICKET_ORDER_NO=barcode

# ---------------------------------------------------------------------------
# >> TTS 语音
# ---------------------------------------------------------------------------
# 迎宾 TTS 提供商；当前 local=本地合成占位
TTS_PROVIDER=local
# TTS 音色标识（预留配置位）
TTS_VOICE=zh-CN

# ---------------------------------------------------------------------------
# >> 摄像头与人脸识别进程
# ---------------------------------------------------------------------------
# 默认摄像头 RTSP/HTTP 地址（可被摄像头管理逐台覆盖）
# 禁止指向元数据/回环；允许店内私网 10/172/192.168
CAMERA_URL=
# 默认摄像头用户名
CAMERA_USERNAME=
# 默认摄像头密码（入库会加密）
CAMERA_PASSWORD=
# 多进程角色：auto=争抢 Redis Leader 锁（推荐）；worker=永不调度；leader=优先争抢
PROCESS_ROLE=auto
# Leader 进程是否启动人脸识别 worker：1/true 开启，0/false 关闭
ENABLE_RECOGNITION_WORKER=1

# ---------------------------------------------------------------------------
# >> 顾客叫号屏
# ---------------------------------------------------------------------------
# 叫号屏访问令牌；留空=不校验；生产开启叫号屏后建议设置，URL 加 ?token=
DISPLAY_SCREEN_TOKEN=

#=============================================================================
# 【九、业务参数种子】
# 写入 system_settings 的默认值；运行中以后台「业务参数 / 门店设置」为准
#=============================================================================

# ---------------------------------------------------------------------------
# >> 订单 / 厨房 / 审计保留
# ---------------------------------------------------------------------------
# 订单待支付超时（分钟），超时后查询平台真实状态
ORDER_PAYMENT_TIMEOUT_MINUTES=15
# 厨房 KDS 未处理自动出餐（分钟）；0=关闭自动出餐
KITCHEN_AUTO_COMPLETE_MINUTES=20
# 后台操作审计日志保留天数
OPERATION_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# >> 未知访客抓拍与保留
# ---------------------------------------------------------------------------
# 店内摄像头未匹配授权会员时抓拍存图（默认 true）
# 路径：UPLOAD_DIR/visitors/年/月/日/；可按日期目录手动删除
UNKNOWN_VISITOR_CAPTURE_ENABLED=true
# 未知访客事件与抓拍图保留天数；过期由定时任务清理
VISITOR_DATA_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# >> 人脸迎宾与活体
# ---------------------------------------------------------------------------
# 同一顾客两次迎宾最小间隔（秒）
WELCOME_COOLDOWN_SECONDS=60
# 人脸余弦相似度阈值，推荐 0.75
FACE_MATCH_THRESHOLD=0.75
# 连续匹配成功帧数后才触发迎宾
FACE_CONFIRM_FRAMES=3
# 小程序注册活体：challenge=动作挑战（须 Redis）| none=仅清晰度/亮度粗检
FACE_LIVENESS_MODE=challenge
# 活体挑战 token 有效期（秒）
FACE_LIVENESS_CHALLENGE_TIMEOUT=30

#=============================================================================
# 【十、初始化超管】
# 仅 scripts/初始化管理员.py；非运行时 Settings
#=============================================================================
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=你的强密码
# ADMIN_DISPLAY_NAME=系统管理员
