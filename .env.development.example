# =============================================================================
# 本地开发环境 — Windows 11（联调 / 真机调试）
#
# 用法：复制为项目根目录 .env
#   copy .env.development.example .env
#
# 配套配置（须同步修改）：
#   后端 API 地址    → 本文件 APP_HOST / APP_PORT
#   前端 H5 扫码     → H5_PUBLIC_BASE_URL、CORS_ORIGINS、DEV_LAN_HOST
#   桌台码跳小程序   → MINI_PROGRAM_ENV_VERSION=develop
#   微信小程序 API   → miniprogram-wechat/config/env.js（DEV_LAN_HOST）
#   支付宝小程序 API → miniprogram-alipay/config/env.js（DEV_LAN_HOST）
#
# 切勿将填好真实密钥的 .env 提交到 Git
# 启动命令：scripts/运行命令.txt
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
# 环境标识：development 时后端默认桌台码跳转 develop 版小程序
APP_ENV=development
APP_NAME=SmartNoodleHouse
# 真机调试须 0.0.0.0；仅模拟器可用 127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# 数据库 / 缓存（本机 MySQL / Redis）
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# 认证与安全（开发可用弱密钥，生产必须更换）
# -----------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me-to-random-32chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FACE_ENCRYPTION_KEY=dev-face-key-32bytes!!!!!!!!!!

# -----------------------------------------------------------------------------
# 开发沙箱开关（生产必须全部为 false）
# -----------------------------------------------------------------------------
ALLOW_PAYMENT_MOCK=true
ALLOW_AUTH_MOCK=true
ALLOW_OPENCV_FACE_FALLBACK=true
ALLOW_DELIVERY_MOCK=true
ENABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# 跨域、H5 一码通扫、桌台码
# -----------------------------------------------------------------------------
# 模拟器：127.0.0.1；手机扫 H5 桌台码：加上电脑局域网 IP
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.110:5173
# 生成桌台二维码内嵌 URL；手机无法访问 127.0.0.1，须用局域网 IP
H5_PUBLIC_BASE_URL=http://192.168.1.110:5173
# 与 miniprogram-*/config/env.js 的 DEV_LAN_HOST 保持一致
DEV_LAN_HOST=192.168.1.110
# 桌台码跳转小程序版本：develop（开发）| trial（体验）| release（正式）
MINI_PROGRAM_ENV_VERSION=develop

# -----------------------------------------------------------------------------
# 前端 Vite（npm run dev）
# -----------------------------------------------------------------------------
# 开发用相对路径，由 vite.config.ts 代理到 127.0.0.1:8000
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# 文件上传
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
STORAGE_BACKEND=local

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
JSON_LOGS=false
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Webhook 安全（本地一般关闭 IP 白名单）
# -----------------------------------------------------------------------------
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REQUIRE_ALLOWLIST=false

# -----------------------------------------------------------------------------
# 微信（小程序登录 + 支付；开发可留空，配合 ALLOW_AUTH_MOCK）
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wxd0964c5d02b1549d
WECHAT_APP_SECRET=35f34d83ed4a921c84ea38c4a451ac18
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=certs/wechat_apiclient_key.pem
WECHAT_NOTIFY_URL=http://192.168.1.110:8000/api/v1/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_CERT_PATH=certs/wechat_platform_cert.pem
# 出餐提醒订阅消息模板 ID（可选）
WECHAT_SUBSCRIBE_TEMPLATE_ORDER_READY=

# -----------------------------------------------------------------------------
# 支付宝（小程序 + 支付；开发可留空，配合 ALLOW_AUTH_MOCK）
# -----------------------------------------------------------------------------
ALIPAY_APP_ID=2021006196676140
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 开放平台「接口内容加密」AES；测授权手机号时填写，留空可手输手机号
ALIPAY_AES_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=http://192.168.1.110:8000/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=http://192.168.1.110:5173/order/result

# -----------------------------------------------------------------------------
# 美团 / 饿了么（外卖对接，本地可留空 + ALLOW_DELIVERY_MOCK）
# -----------------------------------------------------------------------------
MEITUAN_APP_ID=
MEITUAN_APP_SECRET=
MEITUAN_SHOP_ID=
MEITUAN_NOTIFY_URL=
MEITUAN_API_BASE=https://waimaiopen.meituan.com

ELEME_APP_ID=
ELEME_APP_SECRET=
ELEME_SHOP_ID=
ELEME_ACCESS_TOKEN=
ELEME_NOTIFY_URL=
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1

DELIVERY_AUTO_CONFIRM=false

# -----------------------------------------------------------------------------
# 芯烨云打印（厨房小票，推荐机型 XP-80T USB+WiFi）
# 用途：KDS 点「开始制作」自动出厨房单；「补打小票」；外卖催单/取消通知单
# 接入：后端调用芯烨云 Open API → 打印机联网后从云端拉单（非 USB 直连本机）
# 前置：在 https://www.xpyun.net/open/index.html 注册开发者（免费），
#       进入「打印管理 → 设备管理 → 添加打印机」，填写机身底部 SN
# 多门店：此处为默认 SN；单店可在后台 store_settings 键 xpyun_printer_sn 覆盖
# 注意：勿再用芯烨公众号绑同店美团/饿了么，否则会与本系统重复打单
# -----------------------------------------------------------------------------
# 总开关。开发机无打印机可保持 false；有测试机时改 true 并填写下方三项
XPYUN_ENABLED=false
# 开发者 ID（开放平台首页可见，API 参数名 user）
XPYUN_USER=
# 开发者密钥 UserKEY（与 user 配对做 SHA1 签名，勿提交到 git、勿泄露）
XPYUN_USER_KEY=
# 默认打印机序列号（机身底部标签，如 XPY123456789A），须已添加到本开发者账号下
XPYUN_PRINTER_SN=
# 芯烨云打印 API 根地址，官方默认即可，一般无需修改
XPYUN_API_BASE=https://open.xpyun.net/api/openapi/xprinter
# 每次打印份数，范围 1～5
XPYUN_PRINT_COPIES=1
# 厨房制作单提示音：0=取消单 1=静音 2=来单（推荐） 3=退单；催单/取消单由代码单独控制
XPYUN_VOICE=2
# 【开发环境推荐 true】未配齐 user/key/SN 时在后端日志输出 MOCK 小票内容，便于联调 KDS
# 即使三项为空，补打接口也会返回成功；有真实打印机联调时改 false
ALLOW_PRINT_MOCK=true

# -----------------------------------------------------------------------------
# TTS / 摄像头 / 人脸识别（门店可选）
# -----------------------------------------------------------------------------
TTS_PROVIDER=local
TTS_VOICE=zh-CN
CAMERA_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
# 多实例时仅 leader 跑调度/识别
PROCESS_ROLE=leader
ENABLE_RECOGNITION_WORKER=1

# -----------------------------------------------------------------------------
# 业务参数
# -----------------------------------------------------------------------------
ORDER_PAYMENT_TIMEOUT_MINUTES=15
KITCHEN_AUTO_COMPLETE_MINUTES=20
VISITOR_DATA_RETENTION_DAYS=7
OPERATION_LOG_RETENTION_DAYS=90
WELCOME_COOLDOWN_SECONDS=60
FACE_MATCH_THRESHOLD=0.75
FACE_CONFIRM_FRAMES=3

# -----------------------------------------------------------------------------
# 顾客叫号屏（留空=不校验；开发可留空）
# -----------------------------------------------------------------------------
DISPLAY_SCREEN_TOKEN=

# -----------------------------------------------------------------------------
# 初始化超管（python scripts/init_admin.py）
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=你的强密码
# ADMIN_DISPLAY_NAME=系统管理员
