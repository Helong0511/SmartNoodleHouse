<view class="bar {{compact ? 'compact' : ''}}" wx:if="{{storeName || tableName}}">
  <view class="bar-top">
    <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" />
    <view class="bar-main">
  <view class="row" wx:if="{{storeName}}">
    <text class="bar-label">门店</text>
    <view class="val">
      <text class="name">{{storeName}}</text>
      <text class="sub" wx:if="{{storeNo}}">#{{storeNo}}</text>
    </view>
  </view>
  <view class="row" wx:if="{{tableName}}">
    <text class="bar-label">桌号</text>
    <view class="val">
      <text class="name table">{{tableName}}</text>
      <text class="sub" wx:if="{{tableNo && tableNo != tableName}}">{{tableNo}}</text>
    </view>
  </view>
  <view class="extra" wx:if="{{!compact && (storeAddress || storePhone)}}">
    <text wx:if="{{storeAddress}}">{{storeAddress}}</text>
    <text wx:if="{{storePhone}}" class="phone">{{storePhone}}</text>
  </view>
    </view>
  </view>
</view>
<view class="bar empty" wx:else>
  <view class="bar-top">
    <image class="brand-logo" src="/assets/logo.png" mode="aspectFit" />
    <text class="hint">请扫描桌台二维码进入门店</text>
  </view>
</view>
