<view class="reco-wrap" wx:if="{{items.length}}">
  <view class="reco-head">
    <view class="reco-titles">
      <text class="reco-title">{{title}}</text>
      <text class="reco-sub">{{subtitle}}</text>
    </view>
  </view>
  <scroll-view class="reco-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="reco-list">
      <view
        class="reco-card"
        wx:for="{{items}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapCard"
      >
        <view class="card-thumb">
          <image wx:if="{{item.imageUrl}}" class="card-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <view wx:else class="card-img ph"><text>{{item.name[0] || '荐'}}</text></view>
          <view class="card-badges" wx:if="{{item.badges.length}}">
            <text class="badge {{b}}" wx:for="{{item.badges}}" wx:for-item="b" wx:key="*this">
              {{b === 'hot' ? '热销' : (b === 'new' ? '新品' : '推荐')}}
            </text>
          </view>
        </view>
        <view class="card-name">{{item.name}}</view>
        <view class="card-reason" wx:if="{{item.reason}}">{{item.reason}}</view>
        <view class="card-bottom">
          <text class="card-price">¥{{item.price}}</text>
          <view
            class="card-add"
            catchtap="onAdd"
            data-id="{{item.id}}"
          >+</view>
        </view>
      </view>
      <view class="reco-tail"></view>
    </view>
  </scroll-view>
</view>

<view class="reco-skel" wx:elif="{{loading}}">
  <view class="reco-head">
    <view class="skel-title"></view>
  </view>
  <view class="skel-row">
    <view class="skel-card" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
  </view>
</view>
