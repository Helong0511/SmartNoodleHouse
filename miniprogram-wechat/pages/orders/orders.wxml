<view class="page">
  <privacy-popup id="privacy-popup" />

  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    seatLabel="{{seatLabel}}"
    compact="{{true}}"
    bind:tablechange="onTableChange"
  />

  <view class="scope-tabs">
    <view
      class="scope-item {{orderScope === 'dine' ? 'active' : ''}}"
      data-scope="dine"
      bindtap="onScopeChange"
    >点餐订单</view>
    <view
      class="scope-item {{orderScope === 'recharge' ? 'active' : ''}}"
      data-scope="recharge"
      bindtap="onScopeChange"
    >充值订单</view>
  </view>

  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </scroll-view>

  <skeleton wx:if="{{loading && !list.length}}" type="order" rows="{{4}}" />

  <view class="empty" wx:elif="{{!loading && !list.length}}">
    <block wx:if="{{orderScope === 'recharge'}}">
      <view class="empty-title">暂无充值订单</view>
      <view class="empty-desc">充值成功后可在此查看到账明细</view>
      <button class="btn-primary" bindtap="goRecharge">去充值</button>
    </block>
    <block wx:else>
      <view class="empty-title">暂无订单</view>
      <view class="empty-desc">点餐完成后可在此查看进度，并一键再来一单</view>
      <button class="btn-primary" bindtap="goMenu">去点餐</button>
    </block>
  </view>

  <block wx:elif="{{orderScope === 'recharge'}}">
    <view class="order" wx:for="{{list}}" wx:key="id">
      <view class="order-head">
        <view class="head-left">
          <text class="ono">{{item.recharge_no}}</text>
        </view>
        <text class="st">{{item.status_label || item.status}}</text>
      </view>
      <view class="place" wx:if="{{item.store_name}}">{{item.store_name}}</view>
      <view class="order-body">
        {{item.package_name || '会员储值'}}
        <text wx:if="{{item.credit_gift > 0}}" class="gift"> · 到账 ¥{{item.credit_total}}</text>
      </view>
      <view class="order-foot">
        <text class="meta-t">{{item.timeText}} · ¥{{item.pay_amount}} · {{item.channel_label || item.channel || '充值'}}</text>
        <view class="btn-mini" catchtap="goRecharge">
          <text class="btn-mini-label">再充一笔</text>
        </view>
      </view>
    </view>
    <view class="list-foot">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:elif="{{noMore}}">— 没有更多了 —</text>
    </view>
  </block>

  <block wx:else>
    <view class="order" wx:for="{{list}}" wx:key="id" bindtap="openOrder" data-id="{{item.id}}">
      <view class="order-head">
        <view class="head-left">
          <text class="pickup-chip {{item.isReady ? 'ready' : ''}}" wx:if="{{item.showPickupBanner}}">
            {{item.isTakeaway ? item.pickupCode : item.pickupLabel}} · {{item.customerStatusLabel}}
          </text>
          <text class="ono" wx:else>{{item.order_no}}</text>
        </view>
        <text class="st">{{item.status_label || item.status}}</text>
      </view>
      <view class="place" wx:if="{{item.placeText}}">{{item.placeText}}</view>
      <view class="order-body">{{item.item_summary}}</view>
      <view class="order-foot">
        <text class="meta-t">{{item.timeText}} · ¥{{item.total_amount}}<text wx:if="{{item.discount_amount > 0}}" class="discount">（已优惠¥{{item.discount_amount}}）</text> · {{item.payLabel}}</text>
        <view
          class="btn-mini {{!item.can_reorder || reorderingId == item.id ? 'is-disabled' : ''}}"
          catchtap="reorderOrder"
          data-id="{{item.id}}"
        >
          <text class="btn-mini-label">再来一单</text>
        </view>
      </view>
    </view>
    <view class="list-foot">
      <text wx:if="{{loadingMore}}">加载中...</text>
      <text wx:elif="{{noMore}}">— 没有更多了 —</text>
    </view>
  </block>
</view>
