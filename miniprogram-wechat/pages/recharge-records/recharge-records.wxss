.page { padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; background: #f7f7f7; }
.scope-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}
.scope-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}
.scope-item.active {
  background: #ff6b35;
  color: #fff;
  font-weight: 600;
}
.tabs { white-space: nowrap; margin-bottom: 16rpx; }
.tab-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
}
.tab-item.active { background: #ff6b35; color: #fff; font-weight: 600; }
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; }
.empty-desc { color: #999; font-size: 26rpx; margin: 16rpx 0 40rpx; line-height: 1.5; }
.btn-primary {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.card-head { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.ono { font-size: 24rpx; color: #666; word-break: break-all; }
.st { font-size: 24rpx; font-weight: 600; color: #999; }
.st.paid { color: #389e0d; }
.st.pending { color: #ff6b35; }
.title { margin-top: 12rpx; font-size: 30rpx; font-weight: 600; color: #333; }
.meta { margin-top: 6rpx; font-size: 24rpx; color: #888; }
.foot { margin-top: 16rpx; }
.amount { font-size: 28rpx; color: #333; font-weight: 560; }
.gift { color: #e85d4c; font-weight: 500; }
.time { margin-top: 8rpx; font-size: 22rpx; color: #999; }
.list-foot { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
