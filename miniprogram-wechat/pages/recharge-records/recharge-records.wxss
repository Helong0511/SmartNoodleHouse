.page { padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.scope-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}
.scope-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}
.scope-item.active {
  background: #ff6b35;
  color: #fff;
  font-weight: 600;
}
.tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.tab-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  line-height: 1.4;
}
.tab-item.active {
  background: #ff6b35;
  color: #fff;
  font-weight: 600;
}
.empty { text-align: center; padding: 120rpx 40rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; }
.empty-desc { color: #999; font-size: 26rpx; margin: 16rpx 0 40rpx; line-height: 1.5; }
.btn-primary {
  background: #ff6b35;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}
.order {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.head-left { flex: 1; min-width: 0; }
.ono { font-size: 24rpx; color: #666; word-break: break-all; }
.st { font-size: 24rpx; color: #ff6b35; font-weight: 600; }
.place { font-size: 22rpx; color: #888; margin-top: 8rpx; }
.order-body { margin-top: 10rpx; font-size: 28rpx; font-weight: 560; line-height: 1.4; }
.gift { color: #e85d4c; font-weight: 500; }
.order-foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.meta-t { color: #999; font-size: 22rpx; flex: 1; }
.btn-mini {
  margin: 0;
  background: #ff6b35;
  color: #fff;
  border-radius: 24rpx;
  font-size: 22rpx;
  height: 48rpx;
  padding: 0 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
}
.btn-mini-label { line-height: 1; }
.list-foot { text-align: center; color: #bbb; font-size: 24rpx; padding: 24rpx 0 40rpx; }
