.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f7f7f7;
}

.search-wrap {
  flex-shrink: 0;
  padding: 0 24rpx 12rpx;
}

.scan-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7e6;
  color: #d48806;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
}
.scan-bar .scan-icon { font-size: 32rpx; }

.search {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.pref-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff3ee;
  color: #ff6b35;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.pref-bar .more { color: #999; }

.loading-tip, .empty-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.menu-layout {
  flex: 1;
  min-height: 0;
  display: flex;
  margin: 0 0 0 0;
  overflow: hidden;
}

.cat-nav {
  width: 168rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  height: 100%;
}

.cat-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.4;
  border-left: 6rpx solid transparent;
}

.cat-item.on {
  background: #fff;
  color: #ff6b35;
  font-weight: 600;
  border-left-color: #ff6b35;
}

.menu-body {
  flex: 1;
  height: 100%;
  background: #fff;
}

.cat-section { padding: 0 16rpx; }
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 8rpx 12rpx;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}

.product {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1px solid #f5f5f5;
}
.main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.quick-add {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  align-self: center;
  line-height: 52rpx;
  text-align: center;
  background: #ffe8df;
  color: #ff6b35;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 700;
}

.thumb-wrap {
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.thumb { width: 100%; height: 100%; display: block; }

.thumb.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffe8df, #f5f5f5);
}

.ph-text { font-size: 36rpx; color: #ff6b35; font-weight: 700; }

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.body-pad { height: 140rpx; }

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #333;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  z-index: 20;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.cart-icon { font-size: 32rpx; }
.cart-total { margin-left: auto; font-weight: 700; font-size: 32rpx; color: #ffd4a8; }

@media (min-width: 600px) {
  .cat-nav { width: 200rpx; }
  .product.wide { padding: 20rpx 12rpx; }
  .name { font-size: 30rpx; }
}
