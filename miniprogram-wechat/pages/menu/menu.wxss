.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f7f7f7;
}

.search-wrap {
  flex-shrink: 0;
  padding: 0 24rpx 12rpx;
}

.scan-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7e6;
  color: #d48806;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
}
.scan-bar .scan-icon { font-size: 32rpx; }

.search {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.pref-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  background: #fff3ee;
  color: #ff6b35;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.pref-main {
  flex: 1;
  min-width: 0;
}

.pref-title {
  display: block;
  font-weight: 600;
  font-size: 22rpx;
  margin-bottom: 6rpx;
  color: #ff6b35;
}

.pref-brief {
  color: #666;
  line-height: 1.5;
  word-break: break-all;
}

.pref-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pref-tag {
  background: #fff;
  color: #666;
  border: 1rpx solid #ffd4c2;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.pref-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.pref-toggle,
.pref-link {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 0;
}

.pref-link {
  color: #ff6b35;
}

.loading-tip, .empty-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.menu-layout {
  flex: 1;
  min-height: 0;
  display: flex;
  margin: 0 0 0 0;
  overflow: hidden;
}

.cat-nav {
  width: 168rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  height: 100%;
}

.cat-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.4;
  border-left: 6rpx solid transparent;
}

.cat-item.on {
  background: #fff;
  color: #ff6b35;
  font-weight: 600;
  border-left-color: #ff6b35;
}

.menu-body {
  flex: 1;
  height: 100%;
  background: #fff;
}

.cat-section { padding: 0 16rpx; }
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 8rpx 12rpx;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}

.product {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1px solid #f5f5f5;
}
.main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.quick-add {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  align-self: center;
  line-height: 52rpx;
  text-align: center;
  background: #ffe8df;
  color: #ff6b35;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 700;
}

.thumb-wrap {
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.thumb { width: 100%; height: 100%; display: block; }

.thumb.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #ffe8df, #f5f5f5);
}

.ph-text { font-size: 36rpx; color: #ff6b35; font-weight: 700; }

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.special-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ff6b35;
  border: 1rpx solid #ffb899;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  line-height: 1.4;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.flag-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  line-height: 1.4;
}

.flag-tag.hot {
  color: #cf1322;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
}

.flag-tag.reco {
  color: #389e0d;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.desc {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.body-pad { height: 180rpx; }

.cart-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 40;
}

.cart-sheet {
  position: fixed;
  left: 0; right: 0;
  bottom: 112rpx;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  background: #f7f7f7;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 45;
  pointer-events: none;
  transition: max-height 0.22s ease, opacity 0.18s ease;
}

.cart-sheet.open {
  max-height: 62vh;
  opacity: 1;
  pointer-events: auto;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.cart-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
  background: #fff;
}

.cart-sheet-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.cart-sheet-clear {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 600;
}

.cart-sheet-body {
  max-height: calc(62vh - 80rpx);
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
}

.cart-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.cart-item.invalid { opacity: 0.72; background: #fafafa; }

.cart-thumb-wrap {
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.cart-thumb { width: 100%; height: 100%; display: block; }
.cart-thumb.placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: #ff6b35; font-weight: 700; font-size: 32rpx;
  background: #ffe8df;
}

.cart-info { flex: 1; min-width: 0; }
.cart-name-row { display: flex; align-items: center; gap: 8rpx; }
.cart-name { font-size: 30rpx; font-weight: 600; flex: 1; min-width: 0; }
.cart-opts { font-size: 24rpx; color: #888; margin-top: 8rpx; line-height: 1.45; }
.cart-unit { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.cart-invalid { font-size: 24rpx; color: #e64340; margin-top: 8rpx; }

.cart-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 8rpx;
  align-self: stretch;
}

.actions-top {
  flex-shrink: 0;
  width: 100%;
  text-align: right;
}

.qty { display: flex; align-items: center; justify-content: flex-end; }
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
}
.qty-num {
  min-width: 40rpx;
  margin: 0 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #333;
}
.line-total {
  font-size: 28rpx;
  color: #e64340;
  margin-top: 12rpx;
  font-weight: 600;
  text-align: right;
  width: 100%;
}

.del-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  min-height: 0;
}

.del {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  background: transparent;
  border: none;
  padding: 0;
}

.checkout-footer {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  z-index: 50;
}

.footer-action {
  width: 168rpx;
  flex-shrink: 0;
}

.sum-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.sum {
  font-size: 28rpx;
  font-weight: 600;
  color: #e64340;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.sum-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
  white-space: nowrap;
}

.footer-link,
.footer-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
}

.footer-link {
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  background: #fff;
}

.footer-link-hover { opacity: 0.82; }

.footer-btn {
  color: #fff;
  background: #ff6b35;
}

.footer-btn-hover { opacity: 0.88; }

.footer-btn.is-disabled { opacity: 0.5; }

@media (min-width: 600px) {
  .cat-nav { width: 200rpx; }
  .product.wide { padding: 20rpx 12rpx; }
  .name { font-size: 30rpx; }
}

/* 菜品收藏 */
.thumb-wrap { position: relative; }
.fav-bar {
  flex-shrink: 0;
  padding: 0 24rpx 12rpx;
  display: flex;
}
.fav-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #999;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}
.fav-chip.on {
  background: #fff1ea;
  color: #ff4d6d;
  border-color: #ff4d6d;
  font-weight: 600;
}
.fav-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.25);
  z-index: 2;
}
.fav-btn.on {
  color: #ff4d6d;
  background: rgba(255, 255, 255, 0.92);
}
