.page { padding: 24rpx 24rpx 140rpx; }
.top { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.table { font-weight: 600; }
.member { color: #ff6b35; }
.cat { font-size: 30rpx; font-weight: 600; margin: 24rpx 0 8rpx; }
.product {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; padding: 24rpx; border-radius: 16rpx; margin-bottom: 12rpx;
}
.name { font-size: 30rpx; font-weight: 500; }
.desc { color: #999; font-size: 24rpx; margin-top: 6rpx; }
.price { color: #ff6b35; font-size: 34rpx; font-weight: 700; }
.cart-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 40rpx;
  background: #333; color: #fff; text-align: center; padding: 28rpx;
  border-radius: 48rpx;
}
