<view class="page">
  <privacy-popup id="privacy-popup" />
  <store-bar compact="{{true}}" bind:tablechange="onTableChange" />

  <view class="scan-bar" wx:if="{{!hasTable && !loading}}" bindtap="scanTable">
    <text class="scan-icon">📷</text>
    <text>未绑定桌台，点击扫描桌台二维码</text>
  </view>

  <view
    class="table-order-bar"
    wx:if="{{hasTable && !isTakeawayChannel && (tableOrderCount || sharedCartOn)}}"
    bindtap="goOrders"
  >
    <view class="table-order-main">
      <text class="table-order-title">{{sharedCartOn ? '本桌共享车' : '本桌已下单'}}</text>
      <text class="table-order-brief" wx:if="{{sharedCartOn}}">{{sharedMemberCount || 1}} 人协同{{tableOrderCount ? ' · ' + tableOrdersBrief : ''}}</text>
      <text class="table-order-brief" wx:elif="{{tableOrdersBrief}}">{{tableOrdersBrief}}</text>
    </view>
    <text class="table-order-link">{{tableOrderCount ? '订单 ›' : '点餐中'}}</text>
  </view>

  <view class="search-wrap" wx:if="{{showMenuSearch}}">
    <input
      class="search"
      placeholder="搜索菜品"
      value="{{keyword}}"
      bindinput="onSearch"
      confirm-type="search"
    />
  </view>

  <!-- favoritesOnly 时即使 favCount=0 也保留入口，防止筛选死局 -->
  <view class="fav-bar" wx:if="{{favCount || favoritesOnly}}">
    <view class="fav-chip {{favoritesOnly ? 'on' : ''}}" catchtap="toggleFavFilter">♥ 收藏 · {{favCount}}</view>
  </view>

  <view class="pref-bar compact" wx:if="{{showMenuSmartTaste && prefCount}}">
    <view class="pref-main" bindtap="togglePrefExpand">
      <text class="pref-title">智能口味 · {{prefCount}}</text>
      <view class="pref-tags" wx:if="{{prefExpanded}}">
        <text class="pref-tag" wx:for="{{prefItems}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="pref-brief" wx:else>{{prefSummary}}</text>
    </view>
    <view class="pref-actions">
      <text class="pref-toggle" catchtap="togglePrefExpand">{{prefExpanded ? '收起' : '展开'}}</text>
      <text class="pref-link" catchtap="goMember">会员</text>
    </view>
  </view>

  <view
    class="reco-fold"
    wx:if="{{showMenuGuessYouLike && recoReady && recoStoreId}}"
    bindtap="toggleRecoExpand"
  >
    <text class="reco-fold-title">猜你喜欢</text>
    <text class="reco-fold-chevron">{{recoExpanded ? '▾' : '›'}}</text>
  </view>
  <recommend-strip
    wx:if="{{showMenuGuessYouLike && recoReady && recoStoreId && recoExpanded}}"
    store-id="{{recoStoreId}}"
    scene="recommend_menu"
    track-scene="recommend"
    bind:open="onRecommendOpen"
    bind:add="onRecommendAdd"
  />

  <skeleton wx:if="{{loading && !categories.length}}" type="menu" rows="{{5}}" />

  <view class="menu-layout" wx:elif="{{categories.length}}">
    <scroll-view class="cat-nav" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        class="cat-item {{activeCat === item.id ? 'on' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCatTap"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view
      class="menu-body"
      scroll-y
      scroll-into-view="{{scrollInto}}"
      scroll-with-animation
      enhanced
      show-scrollbar="{{false}}"
      bindscroll="onMenuBodyScroll"
      bindscrolltoupper="onMenuBodyScrollTop"
    >
      <block wx:for="{{categories}}" wx:key="id">
        <view id="cat-{{item.id}}" class="cat-section">
          <view class="cat-title">{{item.name}}</view>
          <view
            class="product {{isWide ? 'wide' : ''}} {{p.unavailable ? 'is-unavailable' : ''}}"
            wx:for="{{item.products}}"
            wx:for-item="p"
            wx:key="id"
          >
            <view class="main" bindtap="openProduct" data-id="{{p.id}}">
              <view class="thumb-wrap" style="{{p.thumbStyle}}">
                <image wx:if="{{p.imageUrl}}" class="thumb" src="{{p.imageUrl}}" mode="aspectFill" lazy-load webp="{{true}}" />
                <view wx:else class="thumb placeholder">
                  <text class="ph-text">{{p.name[0] || '餐'}}</text>
                </view>
                <view class="sold-mask" wx:if="{{p.unavailable}}">{{p.unavailableLabel || '已售罄'}}</view>
                <view class="fav-btn {{p.fav ? 'on' : ''}}" catchtap="toggleFav" data-id="{{p.id}}">♥</view>
              </view>
              <view class="info">
                <view class="name-row">
                  <view class="name">{{p.name}}</view>
                  <view class="tag-row">
                    <text class="flag-tag sold" wx:if="{{p.unavailable}}">{{p.unavailableLabel || '已售罄'}}</text>
                    <text class="flag-tag hot" wx:elif="{{p.is_hot}}">热销</text>
                    <text class="flag-tag reco" wx:if="{{!p.unavailable && p.is_recommended}}">推荐</text>
                    <text class="special-tag" wx:if="{{!p.unavailable && p.no_member_discount}}">特价</text>
                  </view>
                </view>
                <view class="desc" wx:if="{{p.description && !p.unavailable}}">{{p.description}}</view>
                <view class="price">¥{{p.price}}</view>
              </view>
            </view>
            <view
              wx:if="{{!p.unavailable}}"
              class="quick-add"
              catchtap="quickAdd"
              data-id="{{p.id}}"
              data-name="{{p.name}}"
              data-price="{{p.price}}"
              data-image="{{p.imageUrl}}"
              data-has-options="{{p.has_options}}"
              data-no-member-discount="{{p.no_member_discount}}"
            >+</view>
            <view wx:else class="quick-add is-disabled">+</view>
          </view>
        </view>
      </block>
      <view class="body-pad"></view>
    </scroll-view>
  </view>

  <view
    class="empty-tip {{favoritesOnly ? 'empty-tip-action' : ''}}"
    wx:elif="{{!loading && !categories.length}}"
    catchtap="exitFavFilter"
  >{{favoritesOnly ? '暂无收藏菜品，点击查看全部' : '暂无菜品'}}</view>

  <!-- 已选清单（无删除按钮；减到 0 即移除） -->
  <view class="cart-mask" wx:if="{{cartSheetOpen && cart.length}}" catchtap="closeCartSheet"></view>
  <view class="cart-sheet {{cartSheetOpen ? 'open' : ''}}" wx:if="{{cart.length}}">
    <view class="cart-sheet-head">
      <text class="cart-sheet-title">{{sharedCartOn ? '本桌共享明细' : '点餐明细'}}</text>
      <view class="cart-sheet-ops">
        <text class="cart-sheet-clear" wx:if="{{invalidCount > 0}}" catchtap="clearInvalidCart">清除失效</text>
        <text class="cart-sheet-clear" wx:if="{{sharedCartOn && sharedIsHost}}" catchtap="clearSharedCart">清空共享车</text>
      </view>
    </view>
    <scroll-view class="cart-sheet-body" scroll-y>
      <view class="cart-item {{item.invalid ? 'invalid' : ''}} {{sharedCartOn && !item.can_edit ? 'readonly' : ''}}" wx:for="{{cart}}" wx:key="cartKey">
        <view class="cart-thumb-wrap" style="{{cartThumbStyle}}">
          <image wx:if="{{item.imageUrl}}" class="cart-thumb" src="{{item.imageUrl}}" mode="aspectFill" lazy-load webp="{{true}}" />
          <view wx:else class="cart-thumb placeholder">{{item.name[0] || '餐'}}</view>
        </view>
        <view class="cart-info">
          <view class="cart-name-row">
            <view class="cart-name">{{item.name}}</view>
            <text class="special-tag" wx:if="{{item.no_member_discount}}">特价</text>
          </view>
          <view class="cart-adder" wx:if="{{sharedCartOn && item.added_by_label}}">{{item.mine ? '我' : item.added_by_label}}</view>
          <view class="cart-invalid" wx:if="{{item.invalid}}">{{item.invalidReason}}</view>
          <view class="cart-opts" wx:elif="{{item.option_text}}">{{item.option_text}}</view>
          <view class="cart-unit" wx:if="{{!item.invalid}}">单价 ¥{{item.unit_price}}</view>
        </view>
        <view class="cart-actions">
          <view class="actions-top">
            <view class="qty" wx:if="{{!item.invalid && (!sharedCartOn || item.can_edit)}}">
              <view class="qty-btn" data-index="{{index}}" data-delta="-1" catchtap="changeCartQty">−</view>
              <text class="qty-num">{{item.quantity}}</text>
              <view class="qty-btn" data-index="{{index}}" data-delta="1" catchtap="changeCartQty">+</view>
            </view>
            <view class="qty" wx:elif="{{!item.invalid}}">
              <text class="qty-num">×{{item.quantity}}</text>
            </view>
            <view class="line-total" wx:if="{{!item.invalid}}">¥{{item.subtotal}}</view>
          </view>
          <view class="del-wrap" wx:if="{{!sharedCartOn || item.can_edit}}">
            <view class="del" data-index="{{index}}" catchtap="removeCartItem">删除</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部：点餐明细/继续点餐 | 合计 | 去结算 -->
  <view class="checkout-footer" wx:if="{{cart.length}}">
    <view class="footer-action">
      <view class="footer-link" hover-class="footer-link-hover" catchtap="onFooterLeftTap">{{cartSheetOpen ? '继续点餐' : '点餐明细'}}</view>
    </view>
    <view class="sum-wrap" catchtap="onFooterLeftTap">
      <text class="sum">合计 ¥{{cartTotal}}</text>
      <text class="sum-sub" wx:if="{{cartCount}}">共 {{cartCount}} 件</text>
    </view>
    <view class="footer-action">
      <view
        class="footer-btn {{invalidCount > 0 || cartCount === 0 ? 'is-disabled' : ''}}"
        hover-class="{{invalidCount > 0 || cartCount === 0 ? 'none' : 'footer-btn-hover'}}"
        catchtap="goCheckout"
      >去结算</view>
    </view>
  </view>
</view>
