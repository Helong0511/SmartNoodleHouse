.page { padding: 24rpx; padding-bottom: 48rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.profile { display: flex; align-items: center; gap: 20rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; }
.avatar.placeholder {
  display: flex; align-items: center; justify-content: center;
  background: #fff3ee; color: #ff6b35; font-weight: 700; font-size: 36rpx;
}
.meta { flex: 1; min-width: 0; }
.name { font-size: 36rpx; font-weight: 700; }
.no { color: #999; margin-top: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.tip { color: #999; font-size: 24rpx; margin-top: 16rpx; line-height: 1.5; }
.title { font-weight: 600; margin-bottom: 4rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }
.title-row .title { margin-bottom: 0; }
.link { color: #ff6b35; font-size: 24rpx; }
.tag { display: inline-block; background: #fff3ee; color: #ff6b35; padding: 8rpx 16rpx; border-radius: 20rpx; margin: 12rpx 12rpx 0 0; }
.btn-primary { margin-top: 20rpx; }

.order {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #f2f2f2;
}
.order:first-of-type { border-top: none; padding-top: 12rpx; }
.order-head { display: flex; justify-content: space-between; align-items: center; }
.ono { font-size: 24rpx; color: #666; }
.st { font-size: 24rpx; color: #ff6b35; }
.order-body { margin-top: 10rpx; font-size: 28rpx; font-weight: 560; line-height: 1.4; }
.order-foot {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.meta-t { color: #999; font-size: 22rpx; flex: 1; }
.btn-mini {
  margin: 0;
  background: #ff6b35;
  color: #fff;
  border-radius: 24rpx;
  font-size: 22rpx;
  padding: 0 20rpx;
  line-height: 48rpx;
}
.btn-mini[disabled] { opacity: 0.45; }
