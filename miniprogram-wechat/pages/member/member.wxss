.page { padding: 24rpx; padding-bottom: 48rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.profile { display: flex; align-items: center; gap: 20rpx; }
.avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: visible;
}
.avatar-btn::after { border: none; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; display: block; }
.avatar.placeholder {
  display: flex; align-items: center; justify-content: center;
  background: #fff3ee; color: #ff6b35; font-weight: 700; font-size: 36rpx;
  width: 96rpx; height: 96rpx; border-radius: 50%;
}
.avatar-edit-hint {
  position: absolute;
  bottom: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #ff6b35;
  white-space: nowrap;
  opacity: 0.7;
}
.meta { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 16rpx; }
.name { font-size: 36rpx; font-weight: 700; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-name { flex-shrink: 0; font-size: 24rpx; }
.name-edit { margin-top: 4rpx; }
.name-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  background: #fff;
}
.name-edit-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}
.name-edit-actions .muted { color: #999; }
.btn-save-name {
  margin: 0;
  background: #ff6b35;
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
}
.no { color: #999; margin-top: 8rpx; font-size: 24rpx; }
.level-row { margin-top: 12rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.badge {
  display: inline-block;
  background: linear-gradient(135deg, #ff6b35, #f7b733);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.discount { color: #ff6b35; font-size: 24rpx; font-weight: 600; }
.hint { color: #999; font-size: 24rpx; }
.points-line { color: #666; font-size: 24rpx; margin-top: 10rpx; }
.balance-line { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.recharge-link { color: #ff6b35; font-size: 24rpx; }
.pts { color: #ff6b35; font-weight: 700; font-size: 28rpx; }
.muted-disc { color: #999; font-weight: 400; }
.progress-box { margin-top: 24rpx; padding-top: 20rpx; border-top: 1px solid #f0f0f0; }
.progress-box.done { margin-top: 20rpx; }
.progress-head { display: flex; justify-content: space-between; font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.pct { color: #ff6b35; font-weight: 600; }
.progress-track { height: 12rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #ff6b35, #f7b733); border-radius: 8rpx; }
.progress-tip { margin-top: 10rpx; font-size: 22rpx; color: #bbb; line-height: 1.4; }
.level-item { padding: 16rpx 0; border-bottom: 1px solid #f5f5f5; }
.level-item:last-child { border-bottom: none; }
.level-item.current { background: #fff8f5; margin: 0 -12rpx; padding: 16rpx 12rpx; border-radius: 12rpx; }
.level-item.unlocked .lv-name { color: #333; }
.lv-head { display: flex; align-items: center; gap: 12rpx; }
.lv-name { font-weight: 600; font-size: 28rpx; color: #999; }
.lv-meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.lv-tag { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 16rpx; background: #ff6b35; color: #fff; }
.lv-tag.locked { background: #eee; color: #aaa; }
.coupon-note { margin-top: 16rpx; font-size: 22rpx; color: #ccc; }
.points { color: #bbb; font-size: 22rpx; margin-top: 8rpx; }
.phone { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.link-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
}
.link-card .arrow { color: #ccc; font-size: 40rpx; line-height: 1; }
.member-card { background: linear-gradient(135deg, #fff8f5, #fff); }
.auth-tip { color: #ff6b35; font-size: 24rpx; line-height: 1.5; padding: 8rpx 4rpx 16rpx; }
.phone-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  font-size: 30rpx;
}
.dev-tip { color: #999; font-size: 22rpx; line-height: 1.5; margin-bottom: 12rpx; }
.wx-phone { margin-bottom: 8rpx; }
.or { text-align: center; color: #bbb; font-size: 24rpx; margin: 20rpx 0 8rpx; }
.manual-phone { margin-top: 20rpx; padding-top: 20rpx; border-top: 1px dashed #e5e5e5; }
.or-line { color: #999; font-size: 24rpx; margin-bottom: 12rpx; text-align: center; }
.manual-phone-btn { margin-top: 12rpx; }
.btn-ghost { margin-top: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.tip { color: #999; font-size: 24rpx; margin-top: 16rpx; line-height: 1.5; }
.title { font-weight: 600; margin-bottom: 4rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }
.title-row .title { margin-bottom: 0; }
.link { color: #ff6b35; font-size: 24rpx; }
.tag { display: inline-block; background: #fff3ee; color: #ff6b35; padding: 8rpx 16rpx; border-radius: 20rpx; margin: 12rpx 12rpx 0 0; }
.pref-section { margin-top: 20rpx; }
.pref-section-title { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.pref-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.pref-item:last-child { border-bottom: none; }
.pref-main { flex: 1; min-width: 0; }
.pref-name { display: block; font-size: 28rpx; color: #333; }
.pref-meta { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.pref-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.pref-badge.confirmed { background: #fff3ee; color: #ff6b35; }
.pref-badge.learning { background: #f5f5f5; color: #999; }
.btn-primary { margin-top: 20rpx; }

.order {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid #f2f2f2;
}
.order:first-of-type { border-top: none; padding-top: 12rpx; }
.order-head { display: flex; justify-content: space-between; align-items: center; }
.ono { font-size: 24rpx; color: #666; }
.st { font-size: 24rpx; color: #ff6b35; }
.order-body { margin-top: 10rpx; font-size: 28rpx; font-weight: 560; line-height: 1.4; }
.order-foot {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.meta-t { color: #999; font-size: 22rpx; flex: 1; }
.btn-mini {
  margin: 0;
  background: #ff6b35;
  color: #fff;
  border-radius: 24rpx;
  font-size: 22rpx;
  height: 48rpx;
  padding: 0 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn-mini[disabled] { opacity: 0.45; }
.wallet-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1px solid #f0f0f0;
}
.wallet-item.coupon { background: linear-gradient(90deg, #fff5f5 0%, #fff 50%); border-color: #fde2e2; }
.wallet-item.voucher { background: linear-gradient(90deg, #fff8f0 0%, #fff 50%); border-color: #ffe7ba; }
.wallet-main { flex: 1; min-width: 0; }
.wallet-name { font-size: 28rpx; font-weight: 600; color: #333; }
.wallet-rule { margin-top: 6rpx; font-size: 24rpx; color: #666; line-height: 1.4; }
.wallet-expire { flex-shrink: 0; font-size: 22rpx; color: #999; white-space: nowrap; }

/* TR-13 个性化推荐与隐私 */
.privacy-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1px solid #f2f2f2; }
.privacy-row:last-child { border-bottom: none; }
.privacy-row .privacy-label { font-size: 28rpx; color: #333; }
.privacy-row.link-row { cursor: pointer; }
.privacy-row.link-row text:first-child { font-size: 28rpx; color: #333; }
.privacy-row.link-row.danger text:first-child { color: #e6433a; }
.privacy-row .arrow { color: #bbb; font-size: 32rpx; }
.consent-tip { margin-top: 12rpx; color: #999; font-size: 22rpx; }

.profile-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex; align-items: flex-end;
}
.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  max-height: 70vh;
  display: flex; flex-direction: column;
}
.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; text-align: center; }
.sheet-body { flex: 1; max-height: 50vh; }
.dim-group { margin-bottom: 24rpx; }
.dim-title { font-size: 26rpx; color: #ff6b35; font-weight: 600; margin-bottom: 8rpx; }
.dim-item { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.dim-name { color: #333; }
.dim-score { color: #999; }
