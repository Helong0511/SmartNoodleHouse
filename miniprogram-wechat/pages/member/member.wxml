<view class="page">
  <privacy-popup id="privacy-popup" />

  <store-bar compact="{{true}}" bind:tablechange="onTableChange" />

  <view class="page-body">
  <skeleton wx:if="{{loading}}" type="member" />



  <block wx:else>

  <view class="card member-card">

    <view class="auth-tip">授权头像、昵称、手机号，用于累计积分、会员打折及出餐提醒</view>

    <view class="profile">

      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" webp="{{true}}" />
        <view class="avatar placeholder" wx:else>{{avatarLetter}}</view>
        <view class="avatar-edit-hint">点击授权头像</view>
      </button>

      <view class="meta">

        <view class="name-row" wx:if="{{!editingName}}">
          <view class="name">{{displayName}}</view>
          <text class="link edit-name" bindtap="startEditName">修改</text>
        </view>
        <view class="name-edit" wx:else>
          <form bindsubmit="onSaveNicknameForm">
          <input
            wx:if="{{useWxNickname}}"
            class="name-input"
            type="nickname"
            name="nickname"
            maxlength="20"
            placeholder="微信昵称（点此授权）"
            value="{{nicknameDraft}}"
            bindinput="onNicknameDraft"
            bindblur="onNicknameDraft"
            bindnicknamereview="onNicknameDraftReview"
          />
          <input
            wx:else
            class="name-input"
            type="text"
            name="nickname"
            maxlength="20"
            placeholder="请输入昵称（2-20字）"
            value="{{nicknameDraft}}"
            bindinput="onNicknameDraft"
            focus="{{editingName}}"
          />
          <view class="name-edit-actions">
            <text class="link muted" bindtap="cancelEditName">取消</text>
            <button class="btn-save-name" size="mini" form-type="submit" loading="{{savingName}}">保存</button>
          </view>
          </form>
        </view>

        <view class="no">编号 {{customerNo}}</view>

        <view class="level-row" wx:if="{{isMember && memberLevelName}}">

          <text class="badge">{{memberLevelName}}</text>

          <text class="discount" wx:if="{{memberDiscountText}}">享 {{memberDiscountText}}</text>

          <text class="discount muted-disc" wx:else>当前等级无额外折扣</text>

        </view>

        <view class="activate-block" wx:elif="{{!isMember}}">
          <text class="activate-title">开通智能会员</text>
          <view class="benefit-row">
            <text class="benefit-chip">会员折扣</text>
            <text class="benefit-chip">积分升级</text>
            <text class="benefit-chip">新客券</text>
            <text class="benefit-chip">储值权益</text>
          </view>
          <text class="hint">不影响点餐；开通后即可享等级折扣与积分，资料仅用于会员服务</text>
          <button class="btn-primary activate-btn" size="mini" loading="{{activatingMember}}" bindtap="activateSmartMember">立即开通</button>
        </view>
        <view class="phone" wx:if="{{phone}}">手机 {{phone}}</view>
      </view>
    </view>

    <view class="asset-strip">
      <view class="asset-cell" bindtap="onAssetBalanceTap">
        <text class="asset-val">{{balanceDisplay}}</text>
        <text class="asset-label">{{balanceLabel}}</text>
      </view>
      <view class="asset-cell" bindtap="onAssetPointsTap">
        <text class="asset-val">{{memberPoints}}</text>
        <text class="asset-label">积分</text>
      </view>
      <view class="asset-cell" bindtap="goMenu">
        <text class="asset-val">{{walletAssetCount}}</text>
        <text class="asset-label">可用券</text>
      </view>
    </view>
    <view class="quick-actions">
      <view class="quick-btn primary" bindtap="goMenu">去点餐</view>
      <view class="quick-btn" wx:if="{{isMember}}" bindtap="goRecharge">去充值</view>
      <view class="quick-btn" bindtap="goOrders">我的订单</view>
    </view>

    <view class="progress-box" wx:if="{{nextLevelName}}">
      <view class="progress-head">
        <text>距 {{nextLevelName}} 还差 {{pointsToNext}} 积分</text>
        <text class="pct">{{levelProgress}}%</text>
      </view>
      <view class="progress-track"><view class="progress-fill" style="width:{{levelProgress}}%"></view></view>
      <view class="progress-tip">{{pointsRule}}</view>
    </view>
    <view class="progress-box done" wx:elif="{{isMember}}">
      <view class="progress-tip">已达最高等级；积分可用于兑券（不可结算抵现）</view>
    </view>

    <view class="exchange-box" id="points-exchange" wx:if="{{isMember && pointsExchangeEnabled}}">
      <view class="exchange-title">积分兑券</view>
      <view class="tip" wx:if="{{!exchangeOptions.length}}">暂无兑换档位，请稍后再来</view>
      <view class="exchange-item" wx:for="{{exchangeOptions}}" wx:key="id">
        <view class="exchange-main">
          <view class="wallet-name">{{item.name || item.coupon_name}}</view>
          <view class="wallet-rule">{{item.coupon_summary || item.coupon_name}}</view>
          <view class="wallet-expire">需 {{item.points_cost}} 积分</view>
        </view>
        <view
          class="wallet-use {{exchangingId == item.id ? 'is-disabled' : ''}}"
          data-id="{{item.id}}"
          catchtap="exchangePoints"
        >{{exchangingId == item.id ? '兑换中' : '兑换'}}</view>
      </view>
    </view>

    <view class="birthday-box">
      <view class="phone birthday-line">
        <text>生日历法</text>
        <radio-group class="cal-group" bindchange="onBirthdayCalendarChange">
          <label class="cal-opt"><radio value="SOLAR" checked="{{birthdayCalendar === 'SOLAR'}}" color="#e67e22" disabled="{{birthdayLocked}}"/>公历</label>
          <label class="cal-opt"><radio value="LUNAR" checked="{{birthdayCalendar === 'LUNAR'}}" color="#e67e22" disabled="{{birthdayLocked}}"/>农历</label>
        </radio-group>
      </view>
      <picker mode="date" end="{{birthdayEnd}}" value="{{birthday}}" bindchange="onBirthdayChange" disabled="{{birthdayLocked}}">
        <view class="phone birthday-line {{birthdayLocked ? 'birthday-locked' : ''}}" bindtap="onBirthdayTap">
          生日 {{birthdayDisplay || birthday || '未填写 · 点击设置'}}
        </view>
      </picker>
      <view class="phone birthday-hint" wx:if="{{birthdayLocked}}">生日已确认，不可自行修改；如需更正请联系门店</view>
      <view class="phone birthday-hint" wx:elif="{{birthdayCalendar === 'LUNAR'}}">农历：所选月日即为农历月日（如五月初一）；确认后不可自行修改，更正请联系门店</view>
      <view class="phone birthday-hint" wx:else>设置后需确认；确认后不可自行修改，如需更正请联系门店</view>
      <view class="phone birthday-benefit" wx:if="{{birthdayBenefitText}}">{{birthdayBenefitText}}</view>
    </view>

  </view>



  <view class="card" wx:if="{{memberLevels.length}}">

    <view class="title">{{isMember ? '会员等级与权益' : '开通后可享等级权益'}}</view>

    <view class="level-ladder">
      <view class="ladder-rail">
        <view class="ladder-fill" style="width:{{levelLadderFill}}%"></view>
      </view>
      <view class="ladder-nodes">
        <view
          class="ladder-node {{item.is_current ? 'current' : ''}} {{item.unlocked ? 'on' : ''}}"
          wx:for="{{memberLevels}}"
          wx:key="id"
        >
          <view class="ladder-dot"></view>
          <text class="ladder-name">{{item.shortName}}</text>
          <text class="ladder-disc">{{item.discLabel}}</text>
          <text class="ladder-pts">{{item.ptsLabel}}</text>
        </view>
      </view>
    </view>

    <view class="coupon-note">结算页可选优惠券与代金券（可叠加）；主动开通会员后自动获赠新客券。</view>

  </view>

  <view class="card" wx:if="{{showSocialBenefit}}">
    <view class="title-row social-toggle" bindtap="toggleSocialExpand">
      <view class="social-title-wrap">
        <view class="title">社会贡献公益</view>
        <view class="social-summary" wx:if="{{socialSummary}}">{{socialSummary}}</view>
      </view>
      <text class="social-chevron">{{socialExpanded ? '▾' : '›'}}</text>
    </view>
    <view wx:if="{{socialExpanded}}">
      <view class="tip" wx:if="{{socialLoading}}">加载中...</view>
      <block wx:else>
        <view class="tip" wx:if="{{socialRevoked}}">您的公益身份已被取消，不可再次申请；如有疑问请到店咨询。</view>
        <view class="tip" wx:elif="{{socialApproved}}">您的公益身份已审核通过，结算时可选用公益折扣。</view>
        <view class="tip" wx:elif="{{!socialIdentities.length}}">到店出示工牌，可由收银员当场认定；也可在此申请（提交后进后台「社会贡献 → 待审认定」）。</view>
        <view class="wallet-item" wx:for="{{socialIdentities}}" wx:key="id">
          <view class="wallet-main">
            <view class="wallet-name">{{item.displayLabel}} · {{item.statusLabel}}</view>
            <view class="wallet-rule">{{item.credential_note || '已提交'}}</view>
          </view>
        </view>
        <view class="tip">公益与优惠券互斥；与会员折结算时取更优（折扣更低者）。开启公益后不可用券。</view>
        <view class="social-apply-grid" wx:if="{{socialCanApply && socialApplyTypes.length}}">
          <button
            class="social-apply-btn"
            plain
            hover-class="social-apply-btn--active"
            loading="{{socialApplying}}"
            wx:for="{{socialApplyTypes}}"
            wx:key="code"
            data-code="{{item.code}}"
            bindtap="applySocialIdentity"
          >申请{{item.name}}</button>
        </view>
        <view class="tip" wx:elif="{{socialCanApply && !socialApplyTypes.length}}">暂无可申请身份，请稍后重试或到店核验。
        </view>
      </block>
    </view>
  </view>



  <view class="card" wx:if="{{walletLoading || coupons.length || !hideMemberEmptyWallet}}">

    <view class="title-row">

      <view class="title">我的优惠券</view>

      <text class="link" bindtap="loadWallet">刷新</text>

    </view>

    <view class="tip" wx:if="{{walletLoading}}">加载中...</view>

    <view class="tip" wx:elif="{{!coupons.length}}">暂无可用优惠券</view>

    <view class="wallet-item coupon {{item.expiringSoon ? 'expiring' : ''}}" wx:for="{{coupons}}" wx:key="id">
      <view class="wallet-main">
        <view class="wallet-name">{{item.displayName}}<text class="expire-tag" wx:if="{{item.expiringSoon}}">即将到期</text></view>
        <view class="wallet-rule">{{item.summary}}</view>
        <view class="wallet-expire {{item.expiringSoon ? 'warn' : ''}}">{{item.expireText}}<text wx:if="{{item.expiringSoon && item.daysLeft != null}}"> · 剩{{item.daysLeft}}天</text></view>
      </view>
      <view class="wallet-use" catchtap="goMenu">去使用</view>
    </view>

  </view>



  <view class="card" wx:if="{{walletLoading || vouchers.length || !hideMemberEmptyWallet}}">

    <view class="title">我的代金券</view>

    <view class="tip" wx:if="{{walletLoading}}">加载中...</view>

    <view class="tip" wx:elif="{{!vouchers.length}}">暂无可用代金券</view>

    <view class="wallet-item voucher {{item.expiringSoon ? 'expiring' : ''}}" wx:for="{{vouchers}}" wx:key="id">
      <view class="wallet-main">
        <view class="wallet-name">{{item.displayName}}<text class="expire-tag" wx:if="{{item.expiringSoon}}">即将到期</text></view>
        <view class="wallet-rule">{{item.summary}}</view>
        <view class="wallet-expire {{item.expiringSoon ? 'warn' : ''}}">{{item.expireText}}<text wx:if="{{item.expiringSoon && item.daysLeft != null}}"> · 剩{{item.daysLeft}}天</text></view>
      </view>
      <view class="wallet-use" catchtap="goMenu">去使用</view>
    </view>

  </view>



  <view class="card" wx:if="{{!phone}}">

    <view class="title">绑定手机号</view>

    <view class="tip">授权头像、昵称、手机号用于累计积分、会员打折及出餐提醒。手机号仅来自微信官方授权，防止被冒用。</view>

    <button
      wx:if="{{canWxPhone && needPrivacyAgree}}"
      class="btn-primary wx-phone"
      open-type="getPhoneNumber|agreePrivacyAuthorization"
      bindgetphonenumber="onGetPhoneNumber"
      bindagreeprivacyauthorization="onPrivacyAgree"
    >同意隐私并绑定手机号</button>

    <button
      wx:elif="{{canWxPhone}}"
      class="btn-primary wx-phone"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
    >微信一键绑定手机号</button>

    <block wx:if="{{showDevTips}}">
      <view class="manual-phone">
        <view class="or-line">调试用（仅开发环境，生产走官方授权）</view>
        <button class="btn-primary manual-phone-btn" size="mini" bindtap="mockPhoneAuthorize">模拟一键授权获取手机号</button>
        <input
          class="phone-input"
          type="number"
          maxlength="11"
          placeholder="或手动输入11位手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
        <button class="btn-primary manual-phone-btn" size="mini" loading="{{savingPhone}}" bindtap="bindManualPhone">保存手输手机号</button>
      </view>
    </block>

    <view class="tip" wx:else>当前小程序主体暂未开通微信一键取号能力，暂不能绑定手机号，不影响正常点餐。</view>

  </view>



  <view class="card">
    <view class="title-row social-toggle" bindtap="toggleMoreServices">
      <view class="social-title-wrap">
        <view class="title">更多服务</view>
        <view class="social-summary">口味偏好 · 隐私设置{{showQueueEntry ? ' · 排队' : ''}}</view>
      </view>
      <text class="social-chevron">{{moreServicesExpanded ? '▾' : '›'}}</text>
    </view>
    <block wx:if="{{moreServicesExpanded}}">
      <view class="more-block">
        <view class="pref-section-title">智能口味爱好</view>
        <view class="tip" wx:if="{{prefsEmpty}}">完成订单后，系统会自动累计您常点的规格口味，点餐时智能预选。</view>
        <block wx:else>
          <view class="tip">订单「已完成」后更新画像，点餐时智能预选。</view>
          <view class="pref-section" wx:if="{{prefsConfirmed.length}}">
            <view class="pref-item" wx:for="{{prefsConfirmed}}" wx:key="key">
              <view class="pref-main">
                <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
                <text class="pref-meta">{{item.freqText}}</text>
              </view>
              <text class="pref-badge confirmed">{{item.statusText}}</text>
            </view>
          </view>
          <view class="pref-section" wx:if="{{prefsLearning.length}}">
            <view class="pref-item" wx:for="{{prefsLearning}}" wx:key="key">
              <view class="pref-main">
                <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
                <text class="pref-meta">{{item.freqText}}</text>
              </view>
              <text class="pref-badge learning">{{item.statusText}}</text>
            </view>
          </view>
          <button class="btn-primary" bindtap="goMenu">按爱好去点餐</button>
        </block>
      </view>
      <view class="more-block">
        <view class="privacy-row link-row" bindtap="goFlashSale">
          <text>限量免费抢购</text>
          <text class="arrow">›</text>
        </view>
        <view class="tip">射洪霸王面限量免费，抢到资格后到店出示核销码，逾期自动作废。</view>
      </view>
      <view class="more-block" wx:if="{{showQueueEntry}}">
        <view class="privacy-row link-row" bindtap="goQueue">
          <text>排队取号</text>
          <text class="arrow">›</text>
        </view>
        <view class="tip">高峰可先取号，叫号前提醒就近等位。</view>
      </view>
      <view class="more-block">
        <view class="pref-section-title">个性化推荐与隐私</view>
        <view class="tip">仅在同意时收集点餐行为以优化推荐；可随时关闭或清除画像。行为事件保留不超过 90 天。</view>
        <view class="privacy-row">
          <text class="privacy-label">个性化推荐</text>
          <switch
            checked="{{recommendOptIn === 1}}"
            bindchange="onToggleRecommend"
            color="#ff6b35"
            disabled="{{updatingOptIn}}"
          />
        </view>
        <view class="privacy-row" wx:if="{{showFaceWelcome}}">
          <text class="privacy-label">人脸迎宾</text>
          <switch
            checked="{{faceEnabled}}"
            bindchange="onToggleFace"
            color="#ff6b35"
            disabled="{{updatingFace}}"
          />
        </view>
        <view class="tip" wx:if="{{showFaceWelcome}}">开启后需动作挑战并用前置摄像头实拍；仅用于到店迎宾。</view>
        <view class="privacy-row link-row" bindtap="onViewTasteProfile">
          <text>查看我的口味画像</text>
          <text class="arrow">›</text>
        </view>
        <view class="privacy-row link-row danger" bindtap="onClearTasteProfile">
          <text>清除口味画像</text>
          <text class="arrow">›</text>
        </view>
        <view class="tip consent-tip" wx:if="{{consentVersion}}">同意版本 {{consentVersion}}<text wx:if="{{consentAt}}"> · {{consentAt}}</text></view>
      </view>
    </block>
  </view>

  </block>

  </view>

  <!-- 口味画像查看弹层 -->
  <view class="profile-mask" wx:if="{{showTasteProfile}}" bindtap="closeTasteProfile">
    <view class="profile-sheet" catchtap="">
      <view class="sheet-title">我的口味画像</view>
      <scroll-view scroll-y class="sheet-body">
        <view wx:if="{{!tasteProfile || (!tasteProfile.dimensions.CATEGORY.length && !tasteProfile.dimensions.PRODUCT.length && !tasteProfile.dimensions.TASTE_TAG.length && !tasteProfile.spec_preferences.length)}}" class="tip">暂无画像数据，完成订单后会自动学习。</view>
        <block wx:else>
          <view class="dim-group" wx:if="{{tasteProfile.dimensions.CATEGORY.length}}">
            <view class="dim-title">品类偏好</view>
            <view class="dim-item" wx:for="{{tasteProfile.dimensions.CATEGORY}}" wx:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" wx:if="{{tasteProfile.dimensions.PRODUCT.length}}">
            <view class="dim-title">单品偏好</view>
            <view class="dim-item" wx:for="{{tasteProfile.dimensions.PRODUCT}}" wx:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" wx:if="{{tasteProfile.dimensions.TASTE_TAG.length}}">
            <view class="dim-title">口味标签</view>
            <view class="dim-item" wx:for="{{tasteProfile.dimensions.TASTE_TAG}}" wx:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" wx:if="{{tasteProfile.spec_preferences.length}}">
            <view class="dim-title">规格偏好</view>
            <view class="dim-item" wx:for="{{tasteProfile.spec_preferences}}" wx:key="option_code">
              <text class="dim-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
              <text class="dim-score">下单 {{item.order_count}} 次</text>
            </view>
          </view>
        </block>
      </scroll-view>
      <button class="btn-primary" bindtap="closeTasteProfile">关闭</button>
    </view>
  </view>

</view>

