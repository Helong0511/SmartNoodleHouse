.page { padding-bottom: 48rpx; background: #f7f7f7; min-height: 100vh; }

.hero-wrap {
  width: 100%;
  background: #eee;
  overflow: hidden;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero {
  width: 100%;
  height: 100%;
  display: block;
}

.hero.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #ffe8df, #f0f0f0);
}

.ph-text { font-size: 80rpx; color: #ff6b35; font-weight: 700; }
.ph-sub { margin-top: 12rpx; color: #999; font-size: 26rpx; }

.body {
  margin-top: -24rpx;
  padding: 32rpx 28rpx 48rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
}

.title { font-size: 40rpx; font-weight: 700; }
.desc { color: #888; font-size: 26rpx; margin-top: 12rpx; line-height: 1.5; }
.pref-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff3ee;
  color: #ff6b35;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.price { color: #ff6b35; font-size: 40rpx; font-weight: 700; margin: 16rpx 0 28rpx; }
.base { font-size: 24rpx; color: #999; margin-left: 8rpx; font-weight: 400; }

.group { margin-bottom: 28rpx; }
.gname { font-weight: 600; margin-bottom: 12rpx; }
.opt {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f2f2f2;
  border-radius: 32rpx;
}
.opt.on { background: #ffe8df; color: #ff6b35; border: 1px solid #ff6b35; }

.btn-primary { margin-top: 12rpx; }

@media (min-width: 600px) {
  .body { max-width: 720px; margin-left: auto; margin-right: auto; }
}
