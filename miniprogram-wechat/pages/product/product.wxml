<view class="page" wx:if="{{product}}">
  <view class="title">{{product.name}}</view>
  <view class="price">¥{{product.price}}</view>
  <view class="group" wx:for="{{product.option_groups}}" wx:key="id">
    <view class="gname">{{item.name}}</view>
    <block wx:if="{{item.selection_type === 'SINGLE'}}">
      <view
        class="opt {{selected[item.id] === o.id ? 'on' : ''}}"
        wx:for="{{item.options}}"
        wx:for-item="o"
        wx:key="id"
        data-gid="{{item.id}}"
        data-oid="{{o.id}}"
        bindtap="selectSingle"
      >
        {{o.name}}<text wx:if="{{o.extra_price > 0}}"> +¥{{o.extra_price}}</text>
      </view>
    </block>
    <block wx:else>
      <view
        class="opt {{(multi[item.id] || []).indexOf(o.id) >= 0 ? 'on' : ''}}"
        wx:for="{{item.options}}"
        wx:for-item="o"
        wx:key="id"
        data-gid="{{item.id}}"
        data-oid="{{o.id}}"
        bindtap="selectMulti"
      >
        {{o.name}}<text wx:if="{{o.extra_price > 0}}"> +¥{{o.extra_price}}</text>
      </view>
    </block>
  </view>
  <button class="btn-primary" bindtap="addCart">加入购物车</button>
</view>
