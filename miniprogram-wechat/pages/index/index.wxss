.page { padding: 32rpx; }
.hero {
  background: linear-gradient(135deg, #ff6b35, #f7b733);
  color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}
.brand { font-size: 48rpx; font-weight: 700; }
.sub { margin-top: 12rpx; opacity: 0.95; }
.sub.addr { font-size: 24rpx; opacity: 0.85; }
.sub.table-line { font-size: 32rpx; font-weight: 600; margin-top: 16rpx; }
.sub.no-table { font-size: 28rpx; opacity: 0.9; margin-top: 12rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { color: #666; line-height: 1.6; margin-bottom: 24rpx; }

.profile-block {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.avatar-wrap {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nick-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 微信 button 默认 width:100%，必须强制锁死圆形尺寸 */
.avatar-btn {
  width: 96rpx !important;
  height: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  overflow: hidden;
  background: #ffe8df;
  line-height: 1 !important;
  display: block !important;
  box-sizing: border-box;
  border: none;
  position: relative;
}
.avatar-btn::after { border: none; }
.avatar-btn-hover { opacity: 0.85; }
.avatar-inner {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
  display: block;
  border-radius: 50%;
}
.avatar-ph {
  color: #ff6b35;
  font-weight: 700;
  font-size: 32rpx;
  line-height: 1;
}
.avatar-static {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffe8df;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  display: block;
  border-radius: 50%;
}
.avatar.ph {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffe8df;
  color: #ff6b35;
  font-weight: 700;
  font-size: 32rpx;
}
.avatar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 1.3;
}
.input.nick {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  height: 96rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.dev-tip {
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
  margin: 8rpx 0 24rpx;
}
.dev-tip.debug {
  color: #bbb;
  font-size: 20rpx;
  word-break: break-all;
}
.phone-btn { margin-bottom: 8rpx; }
.privacy-box {
  background: #fff8f5;
  border: 1px solid #ffe0d4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.mp-config-hint {
  background: #fffbe6;
  border: 1px solid #ffe58f;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.mp-config-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ad6800;
  margin-bottom: 8rpx;
}
.mp-config-desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8c6d1f;
}
.privacy-text {
  color: #666;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.privacy-text .link { color: #ff6b35; }
.privacy-agree { margin: 0; }
.album-btn { margin-bottom: 20rpx; }
.phone-box { margin: 8rpx 0 16rpx; }
.phone-title { font-weight: 600; margin-bottom: 12rpx; }
.phone-ok { color: #07c160; font-size: 26rpx; margin-bottom: 8rpx; }
.phone-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  font-size: 30rpx;
  background: #fafafa;
}
.skip { margin-top: 20rpx; }
