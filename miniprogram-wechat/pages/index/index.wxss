.page { padding: 32rpx; }
.hero {
  background: linear-gradient(135deg, #ff6b35, #f7b733);
  color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}
.brand { font-size: 48rpx; font-weight: 700; }
.sub { margin-top: 12rpx; opacity: 0.95; }
.sub.addr { font-size: 24rpx; opacity: 0.85; }
.sub.table-line { font-size: 32rpx; font-weight: 600; margin-top: 16rpx; }
.sub.no-table { font-size: 28rpx; opacity: 0.9; margin-top: 12rpx; }
.scan-card { text-align: center; }
.scan-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.scan-card .title { text-align: center; }
.scan-card .desc { text-align: left; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { color: #666; line-height: 1.6; margin-bottom: 24rpx; }
.input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.avatar-btn {
  padding: 0;
  margin: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
}
.avatar-btn::after { border: none; }
.avatar-static {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f5f5f5;
  flex-shrink: 0;
}
.avatar { width: 96rpx; height: 96rpx; display: block; }
.avatar.ph {
  width: 96rpx; height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  background: #ffe8df; color: #ff6b35; font-weight: 700;
}
.input.nick { flex: 1; margin-bottom: 0; }
.welcome-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.avatar-sm { width: 64rpx; height: 64rpx; border-radius: 50%; }
.dev-tip { color: #999; font-size: 22rpx; line-height: 1.5; margin-top: 8rpx; }
.skip { margin-top: 20rpx; }
