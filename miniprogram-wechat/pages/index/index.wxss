.page { padding: 32rpx; }
.hero {
  background: linear-gradient(135deg, #ff6b35, #f7b733);
  color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}
.brand-logo {
  display: block;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
}
.sub { margin-top: 12rpx; opacity: 0.95; }
.sub.table-line { font-size: 32rpx; font-weight: 600; margin-top: 16rpx; }

.boot-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx;
}
.boot-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe8dc;
  border-top-color: #ff6b35;
  border-radius: 50%;
  animation: boot-spin 0.8s linear infinite;
}
@keyframes boot-spin {
  to { transform: rotate(360deg); }
}
.boot-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.boot-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
}
