<view class="page">
  <privacy-popup id="privacy-popup" />

  <view class="hero">
    <image class="brand-logo" src="/assets/logo.png" mode="aspectFill" />
    <view class="sub" wx:if="{{storeName}}">{{storeName}}</view>
    <view class="sub addr" wx:if="{{storeAddress}}">{{storeAddress}}</view>
    <view class="sub table-line" wx:if="{{hasTable}}">{{seatLabel}} {{tableName}}</view>
    <view class="sub no-table" wx:elif="{{!loading && ready}}">尚未绑定桌台</view>
    <view class="sub" wx:elif="{{loading}}">正在识别桌台...</view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <text>登录中，请稍候...</text>
  </view>

  <view class="card" wx:elif="{{ready}}">
    <view class="title">{{showMemberPrompt ? '注册会员，智能记住您的口味' : '欢迎回来'}}</view>
    <view class="desc">{{showMemberPrompt ? memberText : '完善头像、昵称、手机号后开始点餐。'}}</view>

    <view class="mp-config-hint" wx:if="{{showDevTips && debugInfo}}">
      <text class="mp-config-title">真机微信头像/昵称报错？</text>
      <text class="mp-config-desc">须登录 mp.weixin.qq.com，在 AppID wxd0964c5d02b1549d 下配置「用户隐私保护指引」，勾选「收集你的昵称、头像」并提交审核。审核通过后约 5 分钟生效。等待期间请用「从相册选择头像」+ 手输昵称。</text>
    </view>

    <view class="privacy-box" wx:if="{{needPrivacyAgree}}">
      <view class="privacy-text">
        使用微信头像、昵称、手机号前，请先阅读并同意
        <text class="link" bindtap="openPrivacyContract">《用户隐私保护指引》</text>
      </view>
      <button
        id="agree-btn"
        class="btn-primary privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onPrivacyAgree"
      >同意隐私指引</button>
    </view>

    <form bindsubmit="onFormSubmit">
    <view class="profile-block">
      <view class="avatar-wrap">
        <button
          wx:if="{{canChooseAvatar}}"
          class="avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          hover-class="avatar-btn-hover"
        >
          <view class="avatar-inner">
            <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
            <text class="avatar-ph" wx:else>头</text>
          </view>
        </button>
        <view wx:else class="avatar-btn avatar-static" bindtap="onPickLocalAvatar">
          <view class="avatar-inner">
            <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
            <text class="avatar-ph" wx:else>头</text>
          </view>
        </view>
        <text class="avatar-label">{{canChooseAvatar ? '微信头像' : '点选头像'}}</text>
      </view>

      <view class="nick-wrap">
        <input
          wx:if="{{useWxNickname}}"
          class="input nick"
          type="nickname"
          name="nickname"
          maxlength="20"
          placeholder="点此获取微信昵称"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          bindchange="onNicknameChange"
          bindblur="onNicknameBlur"
          bindnicknamereview="onNicknameReview"
        />
        <input
          wx:else
          class="input nick"
          type="text"
          name="nickname"
          maxlength="20"
          placeholder="请输入昵称（2-20字）"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
        />
        <text class="avatar-label">{{useWxNickname ? '点输入框→键盘上方选「用微信昵称」' : '手动输入昵称'}}</text>
      </view>
    </view>

    <button class="btn-ghost album-btn" catchtap="onPickLocalAvatar">从相册选择头像</button>

    <view class="phone-box">
      <view class="phone-title">手机号</view>
      <view class="phone-ok" wx:if="{{phone}}">已绑定 {{phone}}</view>
      <block wx:else>
        <button
          wx:if="{{canWxPhone && needPrivacyAgree}}"
          class="btn-ghost phone-btn"
          open-type="getPhoneNumber|agreePrivacyAuthorization"
          bindgetphonenumber="onGetPhoneNumber"
          bindagreeprivacyauthorization="onPrivacyAgree"
        >同意隐私并授权手机号</button>
        <button
          wx:elif="{{canWxPhone}}"
          class="btn-ghost phone-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="onGetPhoneNumber"
        >微信授权手机号</button>
        <input
          class="input phone-input"
          type="number"
          maxlength="11"
          placeholder="或手动输入11位手机号"
          value="{{phoneInput}}"
          bindinput="onPhoneInput"
        />
      </block>
    </view>

    <view class="dev-tip" wx:if="{{showDevTips && privacyTip}}">{{privacyTip}}</view>
    <view class="dev-tip debug" wx:if="{{showDevTips && debugInfo}}">{{debugInfo}}</view>

    <button class="btn-primary" catchtap="onSubmitRegister" loading="{{saving}}">{{showMemberPrompt ? '注册并开始点餐' : '保存并开始点餐'}}</button>
    </form>
    <button class="btn-ghost skip" bindtap="goMenu">先点餐，稍后再改</button>
    <button class="btn-ghost skip" bindtap="scanTable">{{hasTable ? '重新扫码换桌' : '扫一扫绑桌'}}</button>
    <button class="btn-ghost skip" bindtap="goMember">会员中心 · 口味爱好</button>
  </view>
</view>
