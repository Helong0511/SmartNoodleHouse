<view class="page">
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    compact="{{true}}"
  />

  <view class="loading-tip" wx:if="{{loading}}">正在校验购物车...</view>

  <view class="empty" wx:elif="{{!cart.length}}">
    <view class="empty-icon">🛒</view>
    <view class="empty-title">购物车是空的</view>
    <view class="empty-desc">去菜单挑选喜欢的面食吧</view>
    <button class="btn-ghost empty-btn" bindtap="goMenu">继续点餐</button>
  </view>

  <block wx:else>
    <view class="warn-bar" wx:if="{{invalidCount > 0}}">
      <text>{{invalidCount}} 件商品不可下单（下架/售罄）</text>
      <text class="warn-action" bindtap="clearInvalid">清除</text>
    </view>

    <view class="item {{item.invalid ? 'invalid' : ''}}" wx:for="{{cart}}" wx:key="index">
      <view class="thumb-wrap" style="{{thumbStyle}}">
        <image wx:if="{{item.imageUrl}}" class="thumb" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="thumb placeholder">{{item.name[0] || '餐'}}</view>
      </view>
      <view class="info">
        <view class="name-row">
          <view class="name">{{item.name}}</view>
          <text class="special-tag" wx:if="{{item.no_member_discount}}">特价</text>
        </view>
        <view class="invalid-tag" wx:if="{{item.invalid}}">{{item.invalidReason}}</view>
        <view class="opts" wx:elif="{{item.option_text}}">{{item.option_text}}</view>
        <view class="special-tip" wx:elif="{{item.no_member_discount}}">不参与会员/券优惠</view>
        <view class="unit" wx:if="{{!item.invalid}}">单价 ¥{{item.unit_price}}</view>
      </view>
      <view class="actions">
        <view class="actions-top">
          <view class="qty" wx:if="{{!item.invalid}}">
            <text class="btn" data-index="{{index}}" data-delta="-1" bindtap="changeQty">−</text>
            <text class="num">{{item.quantity}}</text>
            <text class="btn" data-index="{{index}}" data-delta="1" bindtap="changeQty">+</text>
          </view>
          <view class="line-total" wx:if="{{!item.invalid}}">¥{{item.subtotal}}</view>
        </view>
        <view class="del-wrap">
          <text class="del" data-index="{{index}}" bindtap="removeItem">删除</text>
        </view>
      </view>
    </view>

    <view class="footer">
      <view class="footer-action">
        <view class="footer-link" hover-class="footer-link-hover" bindtap="goMenu">继续点餐</view>
      </view>
      <view class="sum-wrap">
        <text class="sum">合计 ¥{{total}}</text>
        <text class="sum-sub" wx:if="{{count}}">共 {{count}} 件</text>
      </view>
      <view class="footer-action">
        <view
          class="footer-btn {{invalidCount > 0 || count === 0 ? 'is-disabled' : ''}}"
          hover-class="{{invalidCount > 0 || count === 0 ? 'none' : 'footer-btn-hover'}}"
          bindtap="goConfirm"
        >去结算</view>
      </view>
    </view>
  </block>
</view>
