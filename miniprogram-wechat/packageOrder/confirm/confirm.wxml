<view class="page">
  <privacy-popup id="privacy-popup" />
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    storeLogo="{{storeLogo}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    seatLabel="{{seatLabel}}"
    compact="{{true}}"
    autoSync="{{false}}"
    bind:tablechange="onTableChange"
  />

  <view class="tip">金额由服务器重新计算，防止篡改</view>

  <view class="member-bar" wx:if="{{isMember && memberLevelName}}">
    <text class="badge">{{memberLevelName}}</text>
    <text wx:if="{{memberDiscountText}}">享 {{memberDiscountText}} 优惠（与结算金额一致）</text>
    <text wx:elif="{{nextLevelName}}">再积 {{pointsToNext}} 分升级 {{nextLevelName}}{{nextLevelDiscountText ? '（' + nextLevelDiscountText + '）' : ''}}</text>
    <text wx:else>会员身份已识别</text>
  </view>

  <view class="coupon-box" wx:if="{{hasSocialBenefit && payMethod !== 'BALANCE'}}">
    <view class="label">社会贡献公益</view>
    <view class="pack-row" style="justify-content:space-between;align-items:center">
      <view>
        <view>{{socialBenefitLabel || '公益折扣'}}</view>
        <view class="pack-tip">与会员折取更优（折扣更低者）；开启后不可用券</view>
        <view class="pack-tip" wx:if="{{socialRecommendTip && !useSocialBenefit}}">{{socialRecommendTip}}</view>
      </view>
      <switch checked="{{useSocialBenefit}}" bindchange="onToggleSocial" color="#ff6b35" />
    </view>
  </view>

  <view class="table-box" wx:if="{{!needPack}}">
    <view class="label">堂食桌号（必选）</view>
    <view wx:if="{{tableToken}}" class="table-on">{{tableName || pickedLabel || '已绑桌'}}</view>
    <block wx:elif="{{!tableToken}}">
      <view class="scan-btn" hover-class="scan-btn-hover" bindtap="scanTable">扫码绑桌</view>
      <picker wx:if="{{tableOptions.length}}" mode="selector" range="{{tableOptions}}" range-key="label" bindchange="onPickTable">
        <view class="table-pick">{{pickedLabel || '或手动选择桌号'}}</view>
      </picker>
      <view wx:elif="{{needScanHint}}" class="scan-hint">请先扫描桌台二维码，或联系店员协助选桌</view>
    </block>
  </view>

  <view class="cart-box">
    <view class="label">已选商品</view>
    <view class="cart-line" wx:for="{{cartPreview}}" wx:key="index">
      <image wx:if="{{item.imageUrl}}" class="mini" src="{{item.imageUrl}}" mode="aspectFill" lazy-load webp="{{true}}" />
      <view class="mini placeholder" wx:else>{{item.name[0] || '餐'}}</view>
      <view class="cart-info">
        <view class="cart-name-row">
          <text>{{item.name}} ×{{item.quantity}}</text>
          <text class="special-tag" wx:if="{{item.no_member_discount}}">特价</text>
        </view>
        <text class="cart-price">¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="special-hint" wx:if="{{hasSpecialItems}}">含特价商品：不参与会员折扣、优惠券及代金券</view>
    <view class="sum-row">
      <text>小计</text>
      <text>¥{{subtotal}}</text>
    </view>
    <view class="sum-row discount" wx:if="{{hasDiscount}}">
      <text>会员优惠{{memberDiscountText ? '（' + memberDiscountText + '）' : ''}}</text>
      <text>-¥{{discountAmount}}</text>
    </view>
    <view class="sum-row discount" wx:if="{{hasSocialDiscount}}">
      <text>公益折扣{{socialBenefitLabel ? '（' + socialBenefitLabel + '）' : ''}}</text>
      <text>-¥{{socialDiscountAmount}}</text>
    </view>
    <view class="sum-row discount" wx:if="{{hasCouponDiscount}}">
      <text>优惠券{{selectedCouponLabel && selectedCouponLabel != '不使用优惠券' ? '（' + selectedCouponLabel + '）' : ''}}</text>
      <text>-¥{{couponDiscountAmount}}</text>
    </view>
    <view class="sum-row discount" wx:if="{{hasVoucherDiscount}}">
      <text>代金券{{selectedVoucherLabel && selectedVoucherLabel != '不使用代金券' ? '（' + selectedVoucherLabel + '）' : ''}}</text>
      <text>-¥{{voucherDiscountAmount}}</text>
    </view>
    <view class="sum-row" wx:if="{{needPack}}">
      <text>打包费（预估）</text>
      <text>¥{{packingFee}}</text>
    </view>
    <view class="sum-row hint-row" wx:if="{{!hasDiscount && nextLevelName}}">
      <text>升级提示</text>
      <text class="hint-text">再积 {{pointsToNext}} 分可升 {{nextLevelName}}{{nextLevelDiscountText ? '（' + nextLevelDiscountText + '）' : ''}}</text>
    </view>
    <view class="sum-row total">
      <text>应付约</text>
      <text>¥{{payEstimate}}</text>
    </view>
  </view>

  <view class="coupon-box" wx:if="{{coupons.length && !useSocialBenefit}}">
    <view class="label">优惠券</view>
    <picker mode="selector" range="{{couponPickerLabels}}" bindchange="onPickCoupon">
      <view class="coupon-pick">{{selectedCouponLabel}}</view>
    </picker>
  </view>

  <view class="coupon-box" wx:if="{{vouchers.length && !useSocialBenefit}}">
    <view class="label">代金券</view>
    <picker mode="selector" range="{{voucherPickerLabels}}" bindchange="onPickVoucher">
      <view class="coupon-pick">{{selectedVoucherLabel}}</view>
    </picker>
  </view>

  <view class="pack-box">
    <view class="label">用餐方式</view>
    <view class="pack-row">
      <view class="pack-opt {{!needPack ? 'on' : ''}}" data-pack="0" bindtap="onPack">堂食</view>
      <view class="pack-opt {{needPack ? 'on' : ''}}" data-pack="1" bindtap="onPack">打包外带</view>
    </view>
    <view class="pack-tip" wx:if="{{needPack}}">打包按商品餐盒费加收，以服务器结算为准</view>
  </view>

  <view class="schedule-box" wx:if="{{needPack}}">
    <view class="schedule-head">
      <view>
        <view class="label">预约取餐</view>
        <view class="schedule-sub">{{scheduleEnabled ? '到点开始制作，请按时到店取餐' : '关闭则下单后立即制作'}}</view>
      </view>
      <switch checked="{{scheduleEnabled}}" bindchange="onScheduleToggle" color="#ff6b35" />
    </view>
    <block wx:if="{{scheduleEnabled}}">
      <view class="schedule-day-row">
        <view class="schedule-day {{scheduleDayIdx === 0 ? 'on' : ''}}" data-day="0" bindtap="onScheduleDay">今天</view>
        <view class="schedule-day {{scheduleDayIdx === 1 ? 'on' : ''}}" data-day="1" bindtap="onScheduleDay">明天</view>
      </view>
      <view class="schedule-slots" wx:if="{{scheduleSlots.length}}">
        <view
          class="schedule-slot {{scheduleSlotIdx === index ? 'on' : ''}}"
          wx:for="{{scheduleSlots}}"
          wx:key="label"
          data-idx="{{index}}"
          bindtap="onScheduleSlot"
        >{{item.label}}</view>
      </view>
      <view class="schedule-empty" wx:else>当前时段已无可约，请选明天</view>
    </block>
  </view>

  <view class="quick-remarks" wx:if="{{quickRemarks.length}}">
    <view class="label">快捷备注</view>
    <view class="qr-tags">
      <view
        class="qr-tag {{item.on ? 'on' : ''}}"
        wx:for="{{quickRemarks}}"
        wx:key="label"
        data-label="{{item.label}}"
        bindtap="toggleQuickRemark"
      >{{item.label}}</view>
    </view>
  </view>

  <textarea class="remark" placeholder="备注（如不要香菜）" value="{{remark}}" bindinput="onRemark" maxlength="50" />

  <recommend-strip
    wx:if="{{settleReady && settleStoreId}}"
    store-id="{{settleStoreId}}"
    scene="settle_addon"
    track-scene="settle_addon"
    cart-item-ids="{{cartIds}}"
    limit="6"
    bind:open="onRecommendOpen"
    bind:add="onRecommendAdd"
  />

  <view class="pay-box">
    <view class="label">支付方式</view>
    <view class="pay-row">
      <view class="pay-opt {{payMethod === 'WECHAT' ? 'on' : ''}}" data-m="WECHAT" bindtap="onPayMethod">微信支付</view>
      <view
        class="pay-opt {{payMethod === 'BALANCE' ? 'on' : ''}} {{!canPayBalance ? 'disabled' : ''}}"
        data-m="BALANCE"
        bindtap="onPayMethod"
      >余额支付¥{{balanceTotal}}</view>
    </view>
    <view class="pay-tip" wx:if="{{payMethod === 'BALANCE'}}">余额支付按原价结算，不叠加会员折扣与优惠券（充值赠送已计入）</view>
    <view class="pay-tip" wx:elif="{{isMember && !canPayBalance}}">余额不足时可先到「会员」页充值</view>
  </view>
  <button class="btn-primary" loading="{{loading}}" disabled="{{loading || !settleReady}}" bindtap="submit">提交并支付</button>
</view>
