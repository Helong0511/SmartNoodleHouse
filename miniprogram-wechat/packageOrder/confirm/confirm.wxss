.page { padding: 32rpx; }
.tip { color: #999; margin-bottom: 20rpx; font-size: 24rpx; }
.member-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff3ee;
  color: #ff6b35;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}
.member-bar .badge {
  background: #ff6b35;
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.scan-btn {
  margin: 0 0 16rpx;
  padding: 0;
  background: #fff;
  color: #ff6b35;
  border: 1px solid #ff6b35;
  border-radius: 48rpx;
  height: 72rpx;
  font-size: 28rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.scan-btn-hover { opacity: 0.82; }
.sum-row { display: flex; justify-content: space-between; margin-top: 12rpx; color: #666; font-size: 26rpx; }
.sum-row.discount { color: #ff6b35; }
.label {
  display: block;
  width: 100%;
  color: #666;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  white-space: nowrap;
}
.table-on { font-size: 36rpx; font-weight: 600; color: #ff6b35; }
.table-pick { font-size: 32rpx; color: #333; padding: 8rpx 0; border-bottom: 1px solid #eee; }
.scan-hint { color: #ff6b35; font-size: 26rpx; line-height: 1.5; padding: 8rpx 0; }
.cart-line { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; border-bottom: 1px solid #f5f5f5; }
.mini { width: 72rpx; height: 72rpx; border-radius: 8rpx; flex-shrink: 0; }
.mini.placeholder {
  width: 72rpx; height: 72rpx; border-radius: 8rpx; flex-shrink: 0;
  background: #ffe8df; color: #ff6b35; font-weight: 700;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.cart-info { flex: 1; display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; }
.cart-name-row { display: flex; align-items: center; gap: 8rpx; flex: 1; min-width: 0; }
.special-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ff6b35;
  border: 1rpx solid #ffb899;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.special-hint {
  margin-top: 12rpx;
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
}
.cart-price { color: #ff6b35; font-weight: 600; }
.coupon-box { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.coupon-pick { margin-top: 8rpx; padding: 16rpx; background: #fff8f5; border-radius: 8rpx; color: #ff6b35; font-size: 26rpx; }
.table-box, .pack-box, .cart-box { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.sum-row.total { color: #333; font-size: 30rpx; font-weight: 700; margin-top: 16rpx; }
.sum-row.hint-row { color: #999; font-size: 24rpx; }
.hint-text { color: #ff6b35; }
.pack-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.pack-opt {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 10rpx;
  border: 1px solid #ddd; color: #666;
}
.pack-opt.on { border-color: #ff6b35; color: #ff6b35; background: #fff5f0; font-weight: 600; }
.pack-tip { margin-top: 12rpx; color: #999; font-size: 24rpx; }

/* 预约取餐（打包单） */
.schedule-box { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.schedule-head { display: flex; align-items: center; justify-content: space-between; }
.schedule-sub { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.schedule-day-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.schedule-day {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 10rpx;
  border: 1px solid #ddd; color: #666; font-size: 26rpx;
}
.schedule-day.on { border-color: #ff6b35; color: #ff6b35; background: #fff5f0; font-weight: 600; }
.schedule-slots { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.schedule-slot {
  min-width: 128rpx; text-align: center; padding: 12rpx 16rpx; border-radius: 8rpx;
  border: 1px solid #e5e5e5; color: #555; font-size: 26rpx; box-sizing: border-box;
}
.schedule-slot.on { border-color: #ff6b35; color: #ff6b35; background: #fff5f0; font-weight: 600; }
.schedule-empty { margin-top: 16rpx; color: #999; font-size: 24rpx; }

/* 快捷备注标签 */
.quick-remarks { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.qr-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.qr-tag {
  padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx;
  border: 1px solid #e0e0e0; color: #666; background: #fafafa;
}
.qr-tag.on { border-color: #ff6b35; color: #ff6b35; background: #fff5f0; font-weight: 600; }
.remark { width: 100%; background: #fff; border-radius: 12rpx; padding: 20rpx; box-sizing: border-box; min-height: 160rpx; }
.pay-box { margin: 24rpx 0; background: #fff; border-radius: 12rpx; padding: 20rpx; }
.pay-row { display: flex; gap: 16rpx; margin-top: 12rpx; }
.pay-opt {
  flex: 1; text-align: center; padding: 18rpx 8rpx; border: 1px solid #e5e5e5;
  border-radius: 12rpx; font-size: 26rpx; color: #333;
}
.pay-opt.on { border-color: #ff6b35; color: #ff6b35; background: #fff5f0; font-weight: 600; }
.pay-opt.disabled { opacity: 0.45; }
.pay-tip { margin-top: 10rpx; color: #999; font-size: 22rpx; }
.pay { margin: 24rpx 0; }
