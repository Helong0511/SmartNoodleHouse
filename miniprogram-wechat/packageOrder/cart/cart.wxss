.page { padding: 24rpx 24rpx 200rpx; }
.loading-tip { text-align: center; color: #999; padding: 80rpx 0; font-size: 26rpx; }
.warn-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7e6;
  color: #d48806;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.warn-action { color: #ff6b35; font-weight: 600; }
.item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}
.item.invalid { opacity: 0.72; background: #fafafa; }
.thumb-wrap {
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f3f3f3;
}
.thumb { width: 100%; height: 100%; display: block; }
.thumb.placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: #ff6b35; font-weight: 700; font-size: 32rpx;
  background: #ffe8df;
}
.info { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 600; }
.invalid-tag { font-size: 24rpx; color: #e64340; margin-top: 8rpx; }
.opts { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.unit { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.actions { text-align: right; flex-shrink: 0; margin-left: 8rpx; }
.qty { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.btn {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  background: #f5f5f5; border-radius: 8rpx; font-size: 32rpx;
}
.num { min-width: 40rpx; text-align: center; font-size: 28rpx; }
.line-total { font-size: 28rpx; color: #e64340; margin-top: 12rpx; font-weight: 600; }
.del { display: inline-block; font-size: 24rpx; color: #999; margin-top: 12rpx; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06);
  display: flex; align-items: center; justify-content: space-between;
}
.sum-wrap { display: flex; flex-direction: column; }
.sum { font-size: 32rpx; font-weight: 600; color: #e64340; }
.sum-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.footer-btn { margin: 0; width: 240rpx; }
.footer-btn[disabled] { opacity: 0.5; }
.empty { text-align: center; margin-top: 100rpx; padding: 0 48rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; }
.empty-desc { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.empty-btn { margin-top: 40rpx; }
