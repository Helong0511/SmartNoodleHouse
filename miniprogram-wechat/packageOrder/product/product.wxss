.page { padding-bottom: 48rpx; background: #f7f7f7; min-height: 100vh; padding-bottom: 160rpx; }

.hero-wrap {
  width: 100%;
  background: #eee;
  overflow: hidden;
}

.hero-swiper {
  width: 100%;
  height: 100%;
}

.hero {
  width: 100%;
  height: 100%;
  display: block;
}

.hero.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #ffe8df, #f0f0f0);
}

.ph-text { font-size: 80rpx; color: #ff6b35; font-weight: 700; }
.ph-sub { margin-top: 12rpx; color: #999; font-size: 26rpx; }

.body {
  margin-top: -24rpx;
  padding: 32rpx 28rpx 48rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
}

.title-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.title { font-size: 40rpx; font-weight: 700; }
.tag-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.special-tag {
  font-size: 22rpx;
  color: #ff6b35;
  border: 1rpx solid #ffb899;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  line-height: 1.3;
}
.flag-tag {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  line-height: 1.3;
}
.flag-tag.hot {
  color: #cf1322;
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
}
.flag-tag.reco {
  color: #389e0d;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}
.flag-tip {
  margin-top: 12rpx;
  color: #666;
  font-size: 24rpx;
  line-height: 1.5;
}
.special-tip {
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}
.desc { color: #888; font-size: 26rpx; margin-top: 12rpx; line-height: 1.5; }
.pref-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff3ee;
  color: #ff6b35;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.price { color: #ff6b35; font-size: 40rpx; font-weight: 700; margin: 16rpx 0 28rpx; }
.base { font-size: 24rpx; color: #999; margin-left: 8rpx; font-weight: 400; }

.group { margin-bottom: 28rpx; }
.gname { font-weight: 600; margin-bottom: 12rpx; }
.opt {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f2f2f2;
  border-radius: 32rpx;
}
.opt.on { background: #ffe8df; color: #ff6b35; border: 1px solid #ff6b35; }

.qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0;
  padding: 20rpx 0;
  border-top: 1px solid #f5f5f5;
}
.qty-label { font-weight: 600; }
.qty-ctrl { display: flex; align-items: center; gap: 24rpx; }
.qty-btn {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  background: #f5f5f5; border-radius: 12rpx; font-size: 36rpx;
}
.qty-num { min-width: 48rpx; text-align: center; font-size: 32rpx; font-weight: 600; }

.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 20rpx 28rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06);
  display: flex; align-items: center; gap: 20rpx;
}
.footer-sum { flex: 1; font-size: 32rpx; font-weight: 700; color: #e64340; }
.footer-btn { flex-shrink: 0; width: 280rpx; margin: 0; }

@media (min-width: 600px) {
  .body { max-width: 720px; margin-left: auto; margin-right: auto; }
}
