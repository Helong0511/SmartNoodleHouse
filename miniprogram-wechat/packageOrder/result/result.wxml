<view class="page">
  <privacy-popup id="privacy-popup" />
  <skeleton wx:if="{{loading}}" type="order" rows="{{2}}" />

  <!-- P2-18：加载失败态 + 重试按钮 -->
  <view wx:elif="{{loadError}}" class="error-state">
    <view class="error-icon">!</view>
    <view class="error-text">加载失败，请重试</view>
    <button class="btn-primary mini" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <store-bar
      storeName="{{storeName}}"
      storeNo="{{storeNo}}"
      storeLogo="{{storeLogo}}"
      tableName="{{tableName}}"
      tableNo="{{tableNo}}"
      seatLabel="{{seatLabel}}"
      compact="{{true}}"
      changeable="{{false}}"
      autoSync="{{false}}"
    />

    <view class="header {{order.status === 'CANCELLED' || order.status === 'REFUNDED' ? 'muted' : ''}}">
      <view class="ok">{{headerIcon}}</view>
      <view class="title">{{pageTitle}}</view>
      <view class="sub" wx:if="{{pickupHint}}">{{pickupHint}}</view>
      <view class="sub" wx:elif="{{order.status === 'READY'}}">请前往取餐台领取</view>
    </view>

    <view class="pickup-banner {{isReady ? 'ready' : ''}}" wx:if="{{showPickupBanner}}" bindtap="copyPickupCode">
      <view class="pickup-banner-head">
        <text class="pickup-type">{{pickupSub}}</text>
        <text class="pickup-status">{{customerStatusLabel}}</text>
      </view>
      <view class="pickup-main">
        <text class="pickup-label">{{isTakeaway ? pickupCode : pickupLabel}}</text>
        <text class="pickup-unit">{{isTakeaway ? '取餐号' : '桌号'}}</text>
      </view>
      <view class="pickup-foot" wx:if="{{pickupFoot}}">{{pickupFoot}}</view>
    </view>

    <view class="info-card">
      <view class="info-row" wx:if="{{storeName}}">
        <text class="k">门店</text>
        <text class="v">{{storeName}}<text wx:if="{{storeNo}}" class="sub"> #{{storeNo}}</text></text>
      </view>
      <view class="info-row" wx:if="{{tableName}}">
        <text class="k">桌号</text>
        <text class="v highlight">{{tableName}}</text>
      </view>
      <view class="info-row" bindtap="copyOrderNo">
        <text class="k">订单号</text>
        <text class="v copy">{{order.order_no}} <text class="copy-hint">复制</text></text>
      </view>
      <view class="info-row">
        <text class="k">用餐</text>
        <text class="v">{{order.dining_type === 'TAKEAWAY' ? '打包外带' : '堂食'}}</text>
      </view>
      <view class="info-row" wx:if="{{hasDiscount}}">
        <text class="k">会员优惠</text>
        <text class="v discount">-¥{{discountAmount}}<text wx:if="{{memberLevelName}}" class="sub">（{{memberLevelName}}）</text></text>
      </view>
      <view class="info-row" wx:if="{{hasCouponDiscount}}">
        <text class="k">优惠券</text>
        <text class="v discount">-¥{{couponDiscountAmount}}</text>
      </view>
      <view class="info-row" wx:if="{{hasVoucherDiscount}}">
        <text class="k">代金券</text>
        <text class="v discount">-¥{{voucherDiscountAmount}}</text>
      </view>
      <view class="info-row" wx:if="{{scheduledPickupText}}">
        <text class="k">预约取餐</text>
        <text class="v highlight">{{scheduledPickupText}}</text>
      </view>
      <view class="info-row" wx:if="{{hasPacking}}">
        <text class="k">打包费</text>
        <text class="v">¥{{order.packing_fee}}</text>
      </view>
      <view class="info-row" wx:if="{{pointsEarned > 0}}">
        <text class="k">本单积分</text>
        <text class="v highlight">+{{pointsEarned}} 分</text>
      </view>
      <view class="info-row">
        <text class="k">应付</text>
        <text class="v price">¥{{order.total_amount}}</text>
      </view>
      <view class="info-row">
        <text class="k">支付</text>
        <text class="v">{{payLabel}}</text>
      </view>
    </view>

    <view class="items-card" wx:if="{{orderItems.length}}">
      <view class="card-title">餐品明细</view>
      <view class="item-row" wx:for="{{orderItems}}" wx:key="index">
        <text class="item-name">{{item.name}}{{item.optionText}}</text>
        <text class="item-qty">×{{item.quantity}}</text>
        <text class="item-price">¥{{item.subtotal}}</text>
      </view>
    </view>

    <view class="feedback-card" wx:if="{{feedbackVisible}}">
      <view class="card-title">口味反馈</view>
      <view class="feedback-tip">点选真实感受，下次推荐更懂你（可跳过）</view>
      <view class="fb-item" wx:for="{{feedbackItems}}" wx:for-item="fb" wx:for-index="fidx" wx:key="product_id">
        <view class="fb-name">{{fb.product_name}}</view>
        <view class="fb-tags">
          <view
            wx:for="{{fb.tags}}"
            wx:for-item="tag"
            wx:key="code"
            class="fb-tag {{tag.tone}} {{tag.on ? 'on' : ''}}"
            data-idx="{{fidx}}"
            data-code="{{tag.code}}"
            bindtap="toggleFeedbackTag"
          >{{tag.label}}</view>
        </view>
      </view>
      <view class="fb-actions">
        <button class="btn-ghost mini" bindtap="skipFeedback">跳过</button>
        <button class="btn-primary mini" loading="{{feedbackSubmitting}}" bindtap="submitFeedback">提交反馈</button>
      </view>
    </view>

    <view class="coupon-claim-card" wx:if="{{showCouponCard}}">
      <view class="coupon-claim-main">
        <view class="coupon-claim-title">支付成功赠券</view>
        <view class="coupon-claim-name">{{claimCouponName}}</view>
      </view>
      <button class="btn-primary mini coupon-claim-btn" loading="{{claimingCoupon}}" bindtap="claimCoupon">领取</button>
    </view>

    <view class="timeline" wx:if="{{statusSteps.length}}">
      <view class="tl-title">订单进度</view>
      <view class="tl-item {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}" wx:for="{{statusSteps}}" wx:key="key">
        <view class="dot"></view>
        <text>{{item.label}}</text>
      </view>
    </view>

    <view class="order-actions" wx:if="{{canAddDish || canUrge || canSelfRefund || canInvoice}}">
      <button class="btn-primary mini add-dish-btn" wx:if="{{canAddDish}}" bindtap="addDishNow">加菜</button>
      <button class="btn-ghost mini invoice-btn" wx:if="{{canInvoice}}" bindtap="goInvoice">申请开票</button>
      <button class="btn-ghost mini urge-btn {{urgeOnCooldown ? 'is-disabled' : ''}}" wx:if="{{canUrge}}" disabled="{{urgeOnCooldown}}" bindtap="urgeOrderNow">催单</button>
      <button class="btn-ghost mini refund-btn" wx:if="{{canSelfRefund}}" loading="{{refunding}}" bindtap="selfRefundOrder">申请退款</button>
    </view>

    <view class="member-banner" wx:if="{{showMemberBanner}}">
      <view class="member-banner-title">开启智能会员</view>
      <view class="member-banner-desc">我们已经记住您的口味：{{tasteHint}}。开通后下次可自动推荐常点规格。</view>
      <view class="member-banner-actions">
        <button class="btn-ghost mini" bindtap="dismissMemberBanner">暂时不用</button>
        <button class="btn-primary mini" loading="{{activatingMember}}" bindtap="activateMemberFromResult">开启智能会员</button>
      </view>
    </view>

    <button class="btn-primary" wx:if="{{order.payment_status === 'UNPAID' || order.payment_status === 'PENDING'}}" loading="{{repaying}}" disabled="{{repaying}}" bindtap="repay">继续支付</button>
    <button class="btn-ghost" open-type="share">分享给好友</button>
    <button class="btn-primary" bindtap="goMenu">继续点餐</button>
  </block>
</view>
