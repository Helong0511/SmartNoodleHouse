# =============================================================================
# SmartNoodleHouse API — systemd 单元（Ubuntu 22.04.5）
#
# 安装：见同目录 安装说明.txt
# 使用 Uvicorn 内置多进程管理器（spawn），监听 127.0.0.1:8000，由 Nginx 反代
#
# 部署前必改：
#   REPLACE_DEPLOY_ROOT  → 项目根目录，默认 /var/www/smart-noodle
#
# 多进程说明：
#   - 本单元 PROCESS_ROLE=auto（或 worker）：Uvicorn 多 worker 争抢 Redis Leader 锁
#   - 仅抢到锁的进程启动 scheduler / TTS；人脸识别另受后端全局 hard-stop 禁止启动，避免重复 Worker
# =============================================================================

[Unit]
Description=SmartNoodleHouse API (FastAPI + Uvicorn)
Documentation=file://REPLACE_DEPLOY_ROOT/README.md
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data

WorkingDirectory=REPLACE_DEPLOY_ROOT/backend
EnvironmentFile=REPLACE_DEPLOY_ROOT/.env
Environment=PYTHONPATH=REPLACE_DEPLOY_ROOT/backend:REPLACE_DEPLOY_ROOT
Environment=PYTHONUNBUFFERED=1
# 覆盖 .env 中可能误写的 PROCESS_ROLE=leader：多 worker 必须用 auto/worker + Redis 锁
Environment=PROCESS_ROLE=auto

# Uvicorn 原生多进程管理器使用 spawn；无需 Gunicorn 或已弃用的 uvicorn.workers 导入路径。
# worker 数可按 CPU 与内存实测调整（建议先从 2 开始）；所有 worker 通过 Redis Leader 锁选主。
ExecStart=REPLACE_DEPLOY_ROOT/backend/.venv/bin/uvicorn app.main:app \
  --host 127.0.0.1 \
  --port 8000 \
  --workers 2 \
  --timeout-keep-alive 5 \
  --timeout-graceful-shutdown 30 \
  --no-access-log

ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

# 上传目录与文件日志需可写
ReadWritePaths=REPLACE_DEPLOY_ROOT/uploads
ReadWritePaths=REPLACE_DEPLOY_ROOT/logs

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
