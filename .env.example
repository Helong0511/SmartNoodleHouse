# 应用环境
APP_ENV=development
APP_NAME=SmartNoodleHouse
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# 数据库
DATABASE_URL=mysql+aiomysql://remote:kb7$rL3d8!tQ@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=NeofZ7iF8tNW6GzkyMZfsGmitY6r6Gwn6D5BU433Vu9lkFwciS2PApBkPMurQuexc9ZgWUjxQA6ZBHMx_bdvHQ
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif

# 微信（含小程序）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=certs/wechat_apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payments/wechat/notify
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 支付宝（含小程序）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/order/result
ALIPAY_MINI_APP_ID=

# 美团外卖开放平台（申请后填写）
# 文档: https://developer.waimai.meituan.com
MEITUAN_APP_ID=
MEITUAN_APP_SECRET=
MEITUAN_SHOP_ID=
MEITUAN_NOTIFY_URL=https://your-domain.com/api/v1/delivery/meituan/notify
MEITUAN_API_BASE=https://waimaiopen.meituan.com

# 饿了么商家开放平台（申请后填写）
# 文档: https://open.shop.ele.me
ELEME_APP_ID=
ELEME_APP_SECRET=
ELEME_SHOP_ID=
ELEME_ACCESS_TOKEN=
ELEME_REFRESH_TOKEN=
ELEME_NOTIFY_URL=https://your-domain.com/api/v1/delivery/eleme/notify
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1
# 门店级 Token 优先存 platform_store_bindings 表；以上为全局兜底
# 外卖回调事件：新单/取消/退款/催单/配送/完成/隐私号；开发模式 JSON 带 "_dev_simulate": true

# TTS
TTS_PROVIDER=local
TTS_VOICE=zh-CN

# 摄像头（海康威视 RTSP 示例）
# 主码流(高清): /Streaming/Channels/101  子码流(识别用): /Streaming/Channels/102
CAMERA_URL=rtsp://admin:your_password@192.168.1.64:554/Streaming/Channels/102
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_password
# 海康默认端口554，需在摄像机 Web 管理界面开启 RTSP

# 人脸加密
FACE_ENCRYPTION_KEY=change-me-face-encryption-key-32bytes!!

# 前端
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
