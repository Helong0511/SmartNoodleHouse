# 应用环境
APP_ENV=development
APP_NAME=SmartNoodleHouse
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# 数据库（请替换为本地凭证，切勿提交真实口令）
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（必填：至少 32 字符随机串）
JWT_SECRET=replace-with-a-long-random-secret-at-least-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 仅开发可开：假支付 / mock 登录（生产启动校验拒绝）
# 本地调试小程序：未配置 WECHAT_APP_ID/SECRET 时，开发环境会自动 mock 登录；
# 若已配置密钥但仍想强制 mock，可设 ALLOW_AUTH_MOCK=true
# 本地调试支付：未配置 WECHAT_MCH_ID 等商户参数时，开发环境自动 mock 并直接入账；
# 若已配置商户但仍想强制 mock，可设 ALLOW_PAYMENT_MOCK=true
ALLOW_PAYMENT_MOCK=false
ALLOW_AUTH_MOCK=false
# 开发：未装 InsightFace 时可 OpenCV 弱特征兜底（true）；生产必须 false
ALLOW_OPENCV_FACE_FALLBACK=false

# 微信平台证书（回调验签）
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_CERT_PATH=certs/wechat_platform_cert.pem

# 人脸加密（必填：至少 32 字符）
FACE_ENCRYPTION_KEY=replace-with-face-encryption-key-32bytes!!

# 外卖
DELIVERY_AUTO_CONFIRM=false
ALLOW_DELIVERY_MOCK=false
ENABLE_RATE_LIMIT=true

# 对象存储 local|s3（生产建议 s3）
STORAGE_BACKEND=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=smart-noodle
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Webhook IP 白名单
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REQUIRE_ALLOWLIST=false

# 日志
JSON_LOGS=false
LOG_LEVEL=INFO

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif

# 微信（小程序登录：须与 miniprogram-wechat/project.config.json 的 appid 一致）
# 留空 + APP_ENV=development → 自动 mock；真机联调请填写开放平台 AppSecret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=certs/wechat_apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payments/wechat/notify
# 退款回调；留空则复用 WECHAT_NOTIFY_URL（同一入口按 event_type 分流）
WECHAT_REFUND_NOTIFY_URL=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/order/result
ALIPAY_MINI_APP_ID=

# 美团
MEITUAN_APP_ID=
MEITUAN_APP_SECRET=
MEITUAN_SHOP_ID=
MEITUAN_NOTIFY_URL=https://your-domain.com/api/v1/delivery/meituan/notify
MEITUAN_API_BASE=https://waimaiopen.meituan.com

# 饿了么
ELEME_APP_ID=
ELEME_APP_SECRET=
ELEME_SHOP_ID=
ELEME_ACCESS_TOKEN=
ELEME_REFRESH_TOKEN=
ELEME_NOTIFY_URL=https://your-domain.com/api/v1/delivery/eleme/notify
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1

# TTS / 摄像头
TTS_PROVIDER=local
TTS_VOICE=zh-CN
CAMERA_URL=rtsp://admin:your_password@192.168.1.64:554/Streaming/Channels/102
CAMERA_USERNAME=admin
CAMERA_PASSWORD=your_password

# 多进程：仅一个 worker 为 leader
PROCESS_ROLE=leader
ENABLE_RECOGNITION_WORKER=1

# 业务参数默认值（写入 system_settings 种子；正式以后台「业务参数」为准）
ORDER_PAYMENT_TIMEOUT_MINUTES=15
VISITOR_DATA_RETENTION_DAYS=7
OPERATION_LOG_RETENTION_DAYS=90
WELCOME_COOLDOWN_SECONDS=60
FACE_MATCH_THRESHOLD=0.75
FACE_CONFIRM_FRAMES=3

# 前端（开发用绝对地址；生产构建请设为 /api/v1 走 Nginx 同源反代）
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
