# =============================================================================
# SmartNoodleHouse 环境配置总览模板
#
# 请按运行环境选择其一，复制为项目根目录 .env：
#   本地开发 Windows 11    →  copy .env.development.example .env
#   生产部署 Ubuntu 22.04  →  cp .env.production.example .env
#
# 切勿将填好真实密钥的 .env 提交到 Git
#
# 配置文件对照：
#   后端 API / 桌台码 / 支付    → 本文件（项目根 .env）
#   微信/支付宝小程序 API 地址  → miniprogram-*/config/env.js
#   微信开发者工具域名校验      → miniprogram-wechat/project.config.json
#   前端开发代理                → frontend/vite.config.ts
#   启动与上线清单              → scripts/运行命令.txt
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=SmartNoodleHouse
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# 数据库 / 缓存
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# 认证与安全
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-at-least-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FACE_ENCRYPTION_KEY=replace-with-face-encryption-key-32bytes!!
# 平台 Token 等业务密钥加密（可选；未配置时回退 FACE_ENCRYPTION_KEY）
SECRET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 沙箱开关（生产必须全部为 false；开发见 .env.development.example）
# -----------------------------------------------------------------------------
# ALLOW_PAYMENT_MOCK：未开通真实支付产品时，开发可 true；生产必须 false
ALLOW_PAYMENT_MOCK=false
ALLOW_AUTH_MOCK=false
ALLOW_OPENCV_FACE_FALLBACK=false
ALLOW_DELIVERY_MOCK=false
ENABLE_RATE_LIMIT=true

# -----------------------------------------------------------------------------
# 跨域、H5 一码通扫、桌台码
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 一码通扫链接域名；留空则用 CORS_ORIGINS 首项
H5_PUBLIC_BASE_URL=http://127.0.0.1:5173
# 本地真机扫 H5 桌台码：与 miniprogram-*/config/env.js 的 DEV_LAN_HOST 一致
DEV_LAN_HOST=192.168.1.110
# 桌台码跳转小程序版本：develop | trial | release；留空则按 APP_ENV 自动推断
MINI_PROGRAM_ENV_VERSION=

# -----------------------------------------------------------------------------
# 前端（Vite）
# -----------------------------------------------------------------------------
# 开发：/api/v1 由 vite 代理到后端；生产：Nginx 反代
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# 文件上传 / 对象存储
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
STORAGE_BACKEND=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=smart-noodle
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# -----------------------------------------------------------------------------
# 日志（文件落盘 logs/{backend,frontend,wechat,alipay}；5MB滚动/7天明文/月打包/最长90天）
# -----------------------------------------------------------------------------
JSON_LOGS=false
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Webhook 安全
# -----------------------------------------------------------------------------
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REQUIRE_ALLOWLIST=false

# -----------------------------------------------------------------------------
# 微信（小程序 + 支付）
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wx_REPLACE_WITH_YOUR_APPID
WECHAT_APP_SECRET=replace_with_wechat_app_secret_not_real
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=certs/wechat_apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_CERT_PATH=certs/wechat_platform_cert.pem
WECHAT_SUBSCRIBE_TEMPLATE_ORDER_READY=

# -----------------------------------------------------------------------------
# 支付宝（小程序登录/资料 + 支付；可分开开通）
# -----------------------------------------------------------------------------
# AppID/私钥可先只用于真机登录、头像、昵称、手机号。
# 小程序内支付须另签约「JSAPI支付」并关联本 AppID；未开通前开发用 ALLOW_PAYMENT_MOCK=true。
ALIPAY_APP_ID=2021000000000000

# 应用私钥：粘贴 PKCS8 私钥内容，勿提交真实密钥（勿粘贴以 MIIE 开头的真实材料）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（支付宝公钥，非应用私钥）
ALIPAY_PUBLIC_KEY=

# 开放平台「接口内容加密」AES；测支付宝授权手机号时填写，留空可手输手机号
ALIPAY_AES_KEY=replace_with_alipay_aes_key_base64==
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/order/result
# -----------------------------------------------------------------------------
# 小程序隐私能力开关（经 GET /api/v1/miniprogram/config 下发；改后须重启后端）
# -----------------------------------------------------------------------------
# 【支付宝】头像 chooseAvatar / 昵称 nickname / 一键手机号
# true=显示平台授权入口；false=仅手输或相册（个人主体手机号须 false）
ENABLE_ALIPAY_AVATAR=true
ENABLE_ALIPAY_NICKNAME=true
ENABLE_ALIPAY_PHONE_BIND=false
# 【微信】头像 chooseAvatar / 昵称 nickname / 一键手机号
ENABLE_WX_AVATAR=true
ENABLE_WX_NICKNAME=true
ENABLE_WX_PHONE_BIND=false
# -----------------------------------------------------------------------------
# 注册欢迎券（微信/支付宝完成会员注册时自动发 1 张）
# -----------------------------------------------------------------------------
# 须与 coupon_templates.name 完全一致，且模板 status=1
# 换券：后台改模板名，或新建模板后把本项改成新名称并重启后端
WELCOME_COUPON_NAME=新客满30减5

# -----------------------------------------------------------------------------
# 美团外卖
# -----------------------------------------------------------------------------
MEITUAN_APP_ID=
MEITUAN_APP_SECRET=
MEITUAN_SHOP_ID=
MEITUAN_NOTIFY_URL=https://your-domain.com/api/v1/delivery/meituan/notify
MEITUAN_API_BASE=https://waimaiopen.meituan.com

# -----------------------------------------------------------------------------
# 饿了么
# -----------------------------------------------------------------------------
ELEME_APP_ID=
ELEME_APP_SECRET=
ELEME_SHOP_ID=
ELEME_ACCESS_TOKEN=
ELEME_NOTIFY_URL=https://your-domain.com/api/v1/delivery/eleme/notify
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1

# -----------------------------------------------------------------------------
# 外卖业务
# -----------------------------------------------------------------------------
DELIVERY_AUTO_CONFIRM=false

# -----------------------------------------------------------------------------
# 厨房热敏小票打印（推荐芯烨 XP-80T USB+WiFi）
# XP-80T WiFi = 局域网 ESC/POS（PRINTER_MODE=local + PRINTER_HOST），不是云打印
# 芯烨云 API（PRINTER_MODE=xpyun）仅用于云打印机型号，见 https://www.xpyun.net
# -----------------------------------------------------------------------------
# 打印总开关
XPYUN_ENABLED=false
PRINTER_MODE=local
PRINTER_HOST=
PRINTER_PORT=9100
XPYUN_PRINT_COPIES=1
# 芯烨云模式专用（XP-80T 局域网版不需要）
XPYUN_USER=
XPYUN_USER_KEY=
XPYUN_PRINTER_SN=
XPYUN_API_BASE=https://open.xpyun.net/api/openapi/xprinter
XPYUN_VOICE=2
# 制作单底部订单号：barcode=CODE-128条码+单号 | text=仅打印单号 | off=不打印
KITCHEN_TICKET_ORDER_NO=barcode
# 未配齐 user/key/SN 时是否仅在后端日志模拟打印（true=不出纸）
# 本地无打印机可临时 true 测 KDS 流程；正式门店有打印机时必须 false
ALLOW_PRINT_MOCK=false

# -----------------------------------------------------------------------------
# TTS / 摄像头 / 人脸识别
# -----------------------------------------------------------------------------
TTS_PROVIDER=local
TTS_VOICE=zh-CN
CAMERA_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
PROCESS_ROLE=leader
ENABLE_RECOGNITION_WORKER=1

# -----------------------------------------------------------------------------
# 业务参数默认值
# -----------------------------------------------------------------------------
ORDER_PAYMENT_TIMEOUT_MINUTES=15
KITCHEN_AUTO_COMPLETE_MINUTES=20
VISITOR_DATA_RETENTION_DAYS=7
OPERATION_LOG_RETENTION_DAYS=90
WELCOME_COOLDOWN_SECONDS=60
FACE_MATCH_THRESHOLD=0.75
FACE_CONFIRM_FRAMES=3

# -----------------------------------------------------------------------------
# 顾客叫号屏（留空=不校验；生产建议设置）
# -----------------------------------------------------------------------------
DISPLAY_SCREEN_TOKEN=

# -----------------------------------------------------------------------------
# 初始化超管（python scripts/init_admin.py）
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=你的强密码
# ADMIN_DISPLAY_NAME=系统管理员
