<view class="page">
  <privacy-popup id="privacy-popup" />
  <skeleton a:if="{{loading}}" type="order" rows="{{2}}" />

  <!-- P2-18：加载失败态 + 重试按钮 -->
  <view a:elif="{{loadError}}" class="error-state">
    <view class="error-icon">!</view>
    <view class="error-text">加载失败，请重试</view>
    <button class="btn-primary mini" onTap="retryLoad">重新加载</button>
  </view>

  <block a:else>
    <store-bar
      storeName="{{storeName}}"
      storeNo="{{storeNo}}"
      storeLogo="{{storeLogo}}"
      tableName="{{tableName}}"
      tableNo="{{tableNo}}"
      seatLabel="{{seatLabel}}"
      compact="{{true}}"
      changeable="{{false}}"
      autoSync="{{false}}"
    />

    <view class="header {{order.status === 'CANCELLED' || order.status === 'REFUNDED' ? 'muted' : ''}}">
      <view class="ok">{{headerIcon}}</view>
      <view class="title">{{pageTitle}}</view>
      <view class="sub" a:if="{{pickupHint}}">{{pickupHint}}</view>
      <view class="sub" a:elif="{{order.status === 'READY'}}">请前往取餐台领取</view>
    </view>

    <view class="pickup-banner {{isReady ? 'ready' : ''}}" a:if="{{showPickupBanner}}" onTap="copyPickupCode">
      <view class="pickup-banner-head">
        <text class="pickup-type">{{pickupSub}}</text>
        <text class="pickup-status">{{customerStatusLabel}}</text>
      </view>
      <view class="pickup-main">
        <text class="pickup-label">{{isTakeaway ? pickupCode : pickupLabel}}</text>
        <text class="pickup-unit">{{isTakeaway ? '取餐号' : '桌号'}}</text>
      </view>
      <view class="pickup-foot" a:if="{{pickupFoot}}">{{pickupFoot}}</view>
    </view>

    <view class="info-card">
      <view class="info-row" a:if="{{storeName}}">
        <text class="k">门店</text>
        <text class="v">{{storeName}}<text a:if="{{storeNo}}" class="sub-inline"> #{{storeNo}}</text></text>
      </view>
      <view class="info-row" a:if="{{tableName}}">
        <text class="k">桌号</text>
        <text class="v highlight">{{tableName}}</text>
      </view>
      <view class="info-row" onTap="copyOrderNo">
        <text class="k">订单号</text>
        <text class="v copy">{{order.order_no}} <text class="copy-hint">复制</text></text>
      </view>
      <view class="info-row">
        <text class="k">用餐</text>
        <text class="v">{{order.dining_type === 'TAKEAWAY' ? '打包外带' : '堂食'}}</text>
      </view>
      <view class="info-row" a:if="{{hasDiscount}}">
        <text class="k">会员优惠</text>
        <text class="v discount">-¥{{discountAmount}}<text a:if="{{memberLevelName}}" class="sub-inline">（{{memberLevelName}}）</text></text>
      </view>
      <view class="info-row" a:if="{{hasCouponDiscount}}">
        <text class="k">优惠券</text>
        <text class="v discount">-¥{{couponDiscountAmount}}</text>
      </view>
      <view class="info-row" a:if="{{hasVoucherDiscount}}">
        <text class="k">代金券</text>
        <text class="v discount">-¥{{voucherDiscountAmount}}</text>
      </view>
      <view class="info-row" a:if="{{scheduledPickupText}}">
        <text class="k">预约取餐</text>
        <text class="v highlight">{{scheduledPickupText}}</text>
      </view>
      <view class="info-row" a:if="{{hasPacking}}">
        <text class="k">打包费</text>
        <text class="v">¥{{order.packing_fee}}</text>
      </view>
      <view class="info-row" a:if="{{pointsEarned > 0}}">
        <text class="k">本单积分</text>
        <text class="v highlight">+{{pointsEarned}} 分</text>
      </view>
      <view class="info-row">
        <text class="k">应付</text>
        <text class="v price">¥{{order.total_amount}}</text>
      </view>
      <view class="info-row">
        <text class="k">支付</text>
        <text class="v">{{payLabel}}</text>
      </view>
    </view>

    <view class="items-card" a:if="{{orderItems.length}}">
      <view class="card-title">商品明细</view>
      <view class="item-row" a:for="{{orderItems}}" a:key="index">
        <text class="item-name">{{item.name}}{{item.optionText}}</text>
        <text class="item-qty">×{{item.quantity}}</text>
        <text class="item-price">¥{{item.subtotal}}</text>
      </view>
    </view>

    <view class="feedback-card" a:if="{{feedbackVisible}}">
      <view class="card-title">口味反馈</view>
      <view class="feedback-tip">点选真实感受，下次推荐更懂你（可跳过）</view>
      <view class="fb-item" a:for="{{feedbackItems}}" a:for-item="fb" a:for-index="fidx" a:key="product_id">
        <view class="fb-name">{{fb.product_name}}</view>
        <view class="fb-tags">
          <view
            a:for="{{fb.tags}}"
            a:for-item="tag"
            a:key="code"
            class="fb-tag {{tag.tone}} {{tag.on ? 'on' : ''}}"
            data-idx="{{fidx}}"
            data-code="{{tag.code}}"
            onTap="toggleFeedbackTag"
          >{{tag.label}}</view>
        </view>
      </view>
      <view class="fb-actions">
        <button class="btn-ghost mini" onTap="skipFeedback">跳过</button>
        <button class="btn-primary mini" loading="{{feedbackSubmitting}}" onTap="submitFeedback">提交反馈</button>
      </view>
    </view>

    <view class="coupon-claim-card" a:if="{{showCouponCard}}">
      <view class="coupon-claim-main">
        <view class="coupon-claim-title">支付成功赠券</view>
        <view class="coupon-claim-name">{{claimCouponName}}</view>
      </view>
      <button class="btn-primary mini coupon-claim-btn" loading="{{claimingCoupon}}" onTap="claimCoupon">领取</button>
    </view>

    <view class="timeline" a:if="{{statusSteps.length}}">
      <view class="tl-title">订单进度</view>
      <view class="tl-item {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}" a:for="{{statusSteps}}" a:key="key">
        <view class="dot"></view>
        <text>{{item.label}}</text>
      </view>
    </view>

    <view class="order-actions" a:if="{{canUrge || canSelfRefund || canInvoice}}">
      <button class="btn-ghost mini invoice-btn" a:if="{{canInvoice}}" onTap="goInvoice">申请开票</button>
      <button class="btn-ghost mini urge-btn {{urgeOnCooldown ? 'is-disabled' : ''}}" a:if="{{canUrge}}" disabled="{{urgeOnCooldown}}" onTap="urgeOrderNow">催单</button>
      <button class="btn-ghost mini refund-btn" a:if="{{canSelfRefund}}" loading="{{refunding}}" onTap="selfRefundOrder">申请退款</button>
    </view>

    <view class="member-banner" a:if="{{showMemberBanner}}">
      <view class="member-banner-title">开启智能会员</view>
      <view class="member-banner-desc">我们已经记住您的口味：{{tasteHint}}。开通后下次可自动推荐常点规格。</view>
      <view class="member-banner-actions">
        <button class="btn-ghost mini" onTap="dismissMemberBanner">暂时不用</button>
        <button class="btn-primary mini" loading="{{activatingMember}}" onTap="activateMemberFromResult">开启智能会员</button>
      </view>
    </view>

    <button class="btn-primary" a:if="{{order.payment_status === 'UNPAID' || order.payment_status === 'PENDING'}}" loading="{{repaying}}" disabled="{{repaying}}" onTap="repay">继续支付</button>
    <button class="btn-primary" onTap="goMenu">继续点餐</button>
  </block>
</view>
