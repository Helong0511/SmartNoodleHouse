<view class="page">
  <skeleton a:if="{{loading}}" type="order" rows="{{2}}" />

  <block a:else>
    <store-bar
      storeName="{{storeName}}"
      storeNo="{{storeNo}}"
      tableName="{{tableName}}"
      tableNo="{{tableNo}}"
      seatLabel="{{seatLabel}}"
      compact="{{true}}"
      changeable="{{false}}"
    />

    <view class="header {{order.status === 'CANCELLED' || order.status === 'REFUNDED' ? 'muted' : ''}}">
      <view class="ok">{{headerIcon}}</view>
      <view class="title">{{pageTitle}}</view>
      <view class="sub" a:if="{{pickupHint}}">{{pickupHint}}</view>
      <view class="sub" a:elif="{{order.status === 'READY'}}">请前往取餐台领取</view>
    </view>

    <view class="pickup-banner {{isReady ? 'ready' : ''}}" a:if="{{showPickupBanner}}" onTap="copyPickupCode">
      <view class="pickup-banner-head">
        <text class="pickup-type">{{pickupSub}}</text>
        <text class="pickup-status">{{customerStatusLabel}}</text>
      </view>
      <view class="pickup-main">
        <text class="pickup-label">{{isTakeaway ? pickupCode : pickupLabel}}</text>
        <text class="pickup-unit">{{isTakeaway ? '取餐号' : '桌号'}}</text>
      </view>
      <view class="pickup-foot" a:if="{{isTakeaway}}">完整订单号末 4 位，与大厅叫号屏一致 · 点击复制</view>
      <view class="pickup-foot" a:else>请在大厅叫号屏对照此桌号</view>
    </view>

    <view class="info-card">
      <view class="info-row" a:if="{{storeName}}">
        <text class="k">门店</text>
        <text class="v">{{storeName}}<text a:if="{{storeNo}}" class="sub-inline"> #{{storeNo}}</text></text>
      </view>
      <view class="info-row" a:if="{{tableName}}">
        <text class="k">桌号</text>
        <text class="v highlight">{{tableName}}</text>
      </view>
      <view class="info-row" onTap="copyOrderNo">
        <text class="k">订单号</text>
        <text class="v copy">{{order.order_no}} <text class="copy-hint">复制</text></text>
      </view>
      <view class="info-row">
        <text class="k">用餐</text>
        <text class="v">{{order.dining_type === 'TAKEAWAY' ? '打包外带' : '堂食'}}</text>
      </view>
      <view class="info-row" a:if="{{hasDiscount}}">
        <text class="k">会员优惠</text>
        <text class="v discount">-¥{{discountAmount}}<text a:if="{{memberLevelName}}" class="sub-inline">（{{memberLevelName}}）</text></text>
      </view>
      <view class="info-row" a:if="{{hasCouponDiscount}}">
        <text class="k">优惠券</text>
        <text class="v discount">-¥{{couponDiscountAmount}}</text>
      </view>
      <view class="info-row" a:if="{{hasVoucherDiscount}}">
        <text class="k">代金券</text>
        <text class="v discount">-¥{{voucherDiscountAmount}}</text>
      </view>
      <view class="info-row" a:if="{{hasPacking}}">
        <text class="k">打包费</text>
        <text class="v">¥{{order.packing_fee}}</text>
      </view>
      <view class="info-row" a:if="{{pointsEarned > 0}}">
        <text class="k">本单积分</text>
        <text class="v highlight">+{{pointsEarned}} 分</text>
      </view>
      <view class="info-row">
        <text class="k">应付</text>
        <text class="v price">¥{{order.total_amount}}</text>
      </view>
      <view class="info-row">
        <text class="k">支付</text>
        <text class="v">{{payLabel}}</text>
      </view>
    </view>

    <view class="items-card" a:if="{{orderItems.length}}">
      <view class="card-title">商品明细</view>
      <view class="item-row" a:for="{{orderItems}}" a:key="index">
        <text class="item-name">{{item.name}}{{item.optionText}}</text>
        <text class="item-qty">×{{item.quantity}}</text>
        <text class="item-price">¥{{item.subtotal}}</text>
      </view>
    </view>

    <view class="timeline" a:if="{{statusSteps.length}}">
      <view class="tl-title">订单进度</view>
      <view class="tl-item {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}" a:for="{{statusSteps}}" a:key="key">
        <view class="dot"></view>
        <text>{{item.label}}</text>
      </view>
    </view>

    <button class="btn-primary" a:if="{{order.payment_status === 'UNPAID' || order.payment_status === 'PENDING'}}" onTap="repay">继续支付</button>
    <button class="btn-primary" onTap="goMenu">继续点餐</button>
  </block>
</view>
