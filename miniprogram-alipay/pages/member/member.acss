.page { padding: 24rpx; padding-bottom: 48rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.name { font-size: 36rpx; font-weight: 700; }
.no { color: #999; margin-top: 8rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.tip { color: #999; font-size: 24rpx; margin-top: 16rpx; line-height: 1.5; }
.title { font-weight: 600; margin-bottom: 4rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }
.link { color: #1677ff; font-size: 24rpx; }
.tag { display: inline-block; background: #e6f4ff; color: #1677ff; padding: 8rpx 16rpx; border-radius: 20rpx; margin: 12rpx 12rpx 0 0; }
.btn-primary { margin-top: 20rpx; }
.order { margin-top: 20rpx; padding-top: 20rpx; border-top: 1px solid #f2f2f2; }
.order-head { display: flex; justify-content: space-between; }
.ono { font-size: 24rpx; color: #666; }
.st { font-size: 24rpx; color: #1677ff; }
.order-body { margin-top: 10rpx; font-size: 28rpx; font-weight: 560; }
.order-foot { margin-top: 12rpx; display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.meta-t { color: #999; font-size: 22rpx; flex: 1; }
.btn-mini { margin: 0; background: #1677ff; color: #fff; border-radius: 24rpx; font-size: 22rpx; }
