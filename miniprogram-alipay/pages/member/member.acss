.page {
  padding: 0;
  padding-bottom: 48rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}
.page-body {
  padding: 12rpx 24rpx 0;
}
.loading-tip { text-align: center; padding: 80rpx 0; color: #999; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.member-card { background: linear-gradient(135deg, #f0f7ff, #fff); }
.profile { display: flex; align-items: center; gap: 20rpx; padding-bottom: 12rpx; }
.avatar-btn {
  position: relative;
  padding: 0 !important;
  margin: 0 !important;
  border: none;
  background: transparent;
  line-height: normal;
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  height: 96rpx !important;
  min-height: 96rpx !important;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
  box-sizing: content-box;
}
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  flex-shrink: 0; background: #f5f5f5; display: block;
}
.avatar.placeholder {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #e6f4ff; color: #1677ff; font-weight: 700; font-size: 36rpx;
}
.avatar-edit-hint {
  position: absolute;
  bottom: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #1677ff;
  white-space: nowrap;
  opacity: 0.7;
}
.meta { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 16rpx; }
.name { font-size: 36rpx; font-weight: 700; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-name { flex-shrink: 0; font-size: 24rpx; }
.name-edit { margin-top: 4rpx; }
.name-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  background: #fff;
}
.name-edit-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}
.name-edit-actions .muted { color: #999; }
.btn-save-name {
  margin: 0;
  background: #1677ff;
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
}
.no { color: #999; margin-top: 8rpx; font-size: 24rpx; word-break: break-all; }
.level-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
}
.activate-row {
  flex-direction: column;
  align-items: flex-start;
  flex-wrap: nowrap;
  gap: 16rpx;
}
.activate-btn {
  width: auto !important;
  min-width: 0 !important;
  height: 56rpx !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
  font-size: 24rpx !important;
  line-height: 56rpx !important;
  border-radius: 28rpx !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
}
.badge {
  display: inline-block;
  flex-shrink: 0;
  background: linear-gradient(135deg, #1677ff, #69b1ff);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.discount {
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.muted-disc { color: #999; font-weight: 400; }
.hint { color: #999; font-size: 24rpx; line-height: 1.45; }
.points-line { color: #666; font-size: 24rpx; margin-top: 10rpx; text-align: left; }
.balance-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
}
.balance-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recharge-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: #1677ff;
  border-radius: 26rpx;
  line-height: 1;
  box-sizing: border-box;
}
.pts { color: #1677ff; font-weight: 700; font-size: 28rpx; flex-shrink: 0; }
.phone { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.birthday-line { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.cal-group { display: inline-flex; gap: 16rpx; margin-left: 8rpx; }
.cal-opt { display: inline-flex; align-items: center; gap: 4rpx; font-size: 24rpx; color: #444; }
.birthday-benefit { color: #e67e22; font-size: 22rpx; margin-top: 6rpx; line-height: 1.4; }
.birthday-hint { color: #999; font-size: 22rpx; margin-top: 4rpx; line-height: 1.4; }
.birthday-locked { color: #888; }
.progress-box { margin-top: 24rpx; padding-top: 20rpx; border-top: 1px solid #f0f0f0; }
.progress-box.done { margin-top: 20rpx; }
.progress-head { display: flex; justify-content: space-between; font-size: 24rpx; color: #666; margin-bottom: 10rpx; }
.pct { color: #1677ff; font-weight: 600; }
.progress-track { height: 12rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #1677ff, #69b1ff); border-radius: 8rpx; }
.progress-tip { margin-top: 10rpx; font-size: 22rpx; color: #bbb; line-height: 1.4; }
.level-ladder { position: relative; margin-top: 8rpx; padding: 8rpx 0 4rpx; }
.ladder-rail {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 22rpx;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  z-index: 0;
}
.ladder-fill {
  height: 100%;
  background: linear-gradient(90deg, #1677ff, #69b1ff);
  border-radius: 8rpx;
}
.ladder-nodes {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.ladder-node {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-width: 0;
}
.ladder-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ddd;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #ddd;
  margin-bottom: 10rpx;
  box-sizing: border-box;
}
.ladder-node.on .ladder-dot {
  background: #1677ff;
  box-shadow: 0 0 0 2rpx #1677ff;
}
.ladder-node.current .ladder-dot {
  width: 28rpx;
  height: 28rpx;
  background: #1677ff;
  box-shadow: 0 0 0 4rpx rgba(22, 119, 255, 0.25);
  margin-top: -4rpx;
  margin-bottom: 6rpx;
}
.ladder-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #999;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ladder-node.on .ladder-name,
.ladder-node.current .ladder-name { color: #333; }
.ladder-node.current .ladder-name { color: #1677ff; }
.ladder-disc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #bbb;
  line-height: 1.2;
}
.ladder-node.on .ladder-disc,
.ladder-node.current .ladder-disc { color: #1677ff; }
.ladder-pts {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #ccc;
  line-height: 1.2;
}
.coupon-note { margin-top: 16rpx; font-size: 22rpx; color: #ccc; }
.auth-tip { color: #1677ff; font-size: 24rpx; line-height: 1.5; padding: 8rpx 4rpx 16rpx; }
.phone-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  font-size: 30rpx;
}
.ali-phone { margin-top: 20rpx; }
.manual-phone { margin-top: 20rpx; padding-top: 20rpx; border-top: 1px dashed #e5e5e5; }
.or-line { color: #999; font-size: 24rpx; margin-bottom: 12rpx; text-align: center; }
.manual-phone-btn { margin-top: 12rpx; }
.social-apply-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}
.social-apply-btn {
  margin: 0;
  padding: 18rpx 8rpx;
  width: 100%;
  min-height: 76rpx;
  height: auto;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
  color: #c2571a;
  background: linear-gradient(180deg, #fffaf7 0%, #fff3eb 100%);
  border: none;
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 1px rgba(230, 126, 34, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.social-apply-btn--active {
  background: #ffe8d9;
  box-shadow: inset 0 0 0 1px rgba(230, 126, 34, 0.45);
}
.social-toggle { cursor: pointer; }
.social-title-wrap { flex: 1; min-width: 0; }
.social-summary { margin-top: 6rpx; font-size: 24rpx; color: #999; line-height: 1.4; }
.social-chevron { flex-shrink: 0; color: #bbb; font-size: 32rpx; margin-left: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.tip { color: #999; font-size: 24rpx; margin-top: 16rpx; line-height: 1.5; }
.dev-tip { color: #999; font-size: 22rpx; line-height: 1.5; margin-bottom: 12rpx; }
.title { font-weight: 600; margin-bottom: 4rpx; }
.title-row { display: flex; justify-content: space-between; align-items: center; }
.title-row .title { margin-bottom: 0; }
.link { color: #1677ff; font-size: 24rpx; }
.pref-section { margin-top: 20rpx; }
.pref-section-title { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.pref-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid #f5f5f5;
}
.pref-item:last-child { border-bottom: none; }
.pref-main { flex: 1; min-width: 0; }
.pref-name { display: block; font-size: 28rpx; color: #333; }
.pref-meta { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.pref-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.pref-badge.confirmed { background: #e6f4ff; color: #1677ff; }
.pref-badge.learning { background: #f5f5f5; color: #999; }
.btn-primary { margin-top: 20rpx; }
.wallet-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  border: 1px solid #f0f0f0;
}
.wallet-item.coupon { background: linear-gradient(90deg, #f0f7ff 0%, #fff 50%); border-color: #d6e4ff; }
.wallet-item.voucher { background: linear-gradient(90deg, #fff8f0 0%, #fff 50%); border-color: #ffe7ba; }
.wallet-main { flex: 1; min-width: 0; }
.wallet-name { font-size: 28rpx; font-weight: 600; color: #333; }
.wallet-rule { margin-top: 6rpx; font-size: 24rpx; color: #666; line-height: 1.4; }
.wallet-expire { flex-shrink: 0; font-size: 22rpx; color: #999; white-space: nowrap; }

/* TR-13 个性化推荐与隐私 */
.privacy-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1px solid #f2f2f2; }
.privacy-row:last-child { border-bottom: none; }
.privacy-row .privacy-label { font-size: 28rpx; color: #333; }
.privacy-row.link-row text:first-child { font-size: 28rpx; color: #333; }
.privacy-row.link-row.danger text:first-child { color: #e6433a; }
.privacy-row .arrow { color: #bbb; font-size: 32rpx; }
.consent-tip { margin-top: 12rpx; color: #999; font-size: 22rpx; }

.profile-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex; align-items: flex-end;
}
.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  max-height: 70vh;
  display: flex; flex-direction: column;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; text-align: center; }
.sheet-body { flex: 1; max-height: 50vh; }
.dim-group { margin-bottom: 24rpx; }
.dim-title { font-size: 26rpx; color: #ff6b35; font-weight: 600; margin-bottom: 8rpx; }
.dim-item { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.dim-name { color: #333; }
.dim-score { color: #999; }
