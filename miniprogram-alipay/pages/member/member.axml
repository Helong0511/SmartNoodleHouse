<view class="page">
  <privacy-popup id="privacy-popup" />

  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    onTableChange="onTableChange"
  />

  <skeleton a:if="{{loading}}" type="member" />

  <block a:else>
    <view class="card member-card">
      <view class="profile">
        <image a:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view class="avatar placeholder" a:else>{{avatarLetter}}</view>
        <view class="meta">
          <view class="name-row" a:if="{{!editingName}}">
            <view class="name">{{displayName}}</view>
            <text class="link edit-name" onTap="startEditName">修改</text>
          </view>
          <view class="name-edit" a:else>
            <form onSubmit="onSaveNicknameForm">
            <input
              a:if="{{useAlipayNickname}}"
              class="name-input"
              type="nickname"
              name="nickname"
              maxlength="20"
              placeholder="支付宝昵称（点此授权）"
              value="{{nicknameDraft}}"
              onInput="onNicknameDraft"
              onNicknameReview="onNicknameDraftReview"
            />
            <input
              a:else
              class="name-input"
              type="text"
              name="nickname"
              maxlength="20"
              placeholder="请输入昵称（2-20字）"
              value="{{nicknameDraft}}"
              onInput="onNicknameDraft"
            />
            <view class="name-edit-actions">
              <text class="link muted" onTap="cancelEditName">取消</text>
              <button class="btn-save-name" size="mini" formType="submit" loading="{{savingName}}">保存</button>
            </view>
            </form>
          </view>
          <view class="no">编号 {{customerNo}}</view>
          <view class="level-row" a:if="{{isMember && memberLevelName}}">
            <text class="badge">{{memberLevelName}}</text>
            <text class="discount" a:if="{{memberDiscountText}}">享 {{memberDiscountText}}</text>
            <text class="discount muted-disc" a:else>当前等级无额外折扣</text>
          </view>
          <view class="level-row" a:elif="{{!isMember}}">
            <text class="hint">注册会员享积分升级与专属折扣</text>
          </view>
          <view class="points-line">当前积分 <text class="pts">{{memberPoints}}</text></view>
          <view class="phone" a:if="{{phone}}">手机 {{phone}}</view>
        </view>
      </view>
      <view class="progress-box" a:if="{{nextLevelName}}">
        <view class="progress-head">
          <text>距 {{nextLevelName}} 还差 {{pointsToNext}} 积分</text>
          <text class="pct">{{levelProgress}}%</text>
        </view>
        <view class="progress-track"><view class="progress-fill" style="width:{{levelProgress}}%"></view></view>
        <view class="progress-tip">{{pointsRule}}</view>
      </view>
      <view class="progress-box done" a:elif="{{isMember}}">
        <view class="progress-tip">已达最高等级，继续消费可累积积分</view>
      </view>
    </view>

    <view class="card">
      <view class="title">会员等级与权益</view>
      <view class="level-item {{item.is_current ? 'current' : ''}} {{item.unlocked ? 'unlocked' : ''}}" a:for="{{memberLevels}}" a:key="id">
        <view class="lv-head">
          <text class="lv-name">{{item.name}}</text>
          <text class="lv-tag" a:if="{{item.is_current}}">当前</text>
          <text class="lv-tag locked" a:elif="{{!item.unlocked}}">未达成</text>
        </view>
        <view class="lv-meta">{{item.min_points}} 积分起 · {{item.discount_text || '无额外折扣'}}</view>
      </view>
      <view class="coupon-note">结算页可选优惠券与代金券（可叠加）；新注册会员自动获赠新客券。</view>
    </view>

    <view class="card">
      <view class="title-row">
        <view class="title">我的优惠券</view>
        <text class="link" onTap="loadWallet">刷新</text>
      </view>
      <view class="tip" a:if="{{walletLoading}}">加载中...</view>
      <view class="tip" a:elif="{{!coupons.length}}">暂无可用优惠券</view>
      <view class="wallet-item coupon" a:for="{{coupons}}" a:key="id">
        <view class="wallet-main">
          <view class="wallet-name">{{item.displayName}}</view>
          <view class="wallet-rule">{{item.summary}}</view>
        </view>
        <view class="wallet-expire">{{item.expireText}}</view>
      </view>
    </view>

    <view class="card">
      <view class="title">我的代金券</view>
      <view class="tip" a:if="{{walletLoading}}">加载中...</view>
      <view class="tip" a:elif="{{!vouchers.length}}">暂无可用代金券</view>
      <view class="wallet-item voucher" a:for="{{vouchers}}" a:key="id">
        <view class="wallet-main">
          <view class="wallet-name">{{item.displayName}}</view>
          <view class="wallet-rule">{{item.summary}}</view>
        </view>
        <view class="wallet-expire">{{item.expireText}}</view>
      </view>
    </view>

    <view class="card" a:if="{{!phone}}">
      <view class="title">绑定手机号</view>
      <view class="tip">绑定后可接收出餐提醒，并合并历史会员账号</view>
      <button
        a:if="{{canAlipayPhone && needPrivacyAgree}}"
        id="agree-phone-btn"
        class="btn-primary ali-phone"
        open-type="agreePrivacyAuthorization"
        onAgreePrivacyAuthorization="onPrivacyAgreeForPhone"
      >同意隐私并绑定手机号</button>
      <button
        a:elif="{{canAlipayPhone}}"
        class="btn-primary ali-phone"
        open-type="getAuthorize"
        scope="phoneNumber"
        onGetAuthorize="onGetPhoneAuthorize"
        onError="onGetPhoneAuthorizeFail"
      >支付宝一键绑定手机号</button>
      <view class="or" a:if="{{canAlipayPhone}}">或手动输入</view>
      <view class="tip dev-tip" a:if="{{showDevTips && !canAlipayPhone}}">开发提示：未在开放平台配置隐私/手机号能力时，请直接手动输入；配置完成后将 config/env.js 中 ENABLE_ALIPAY_PRIVACY_APIS 改为 true。</view>
      <input class="phone-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phoneInput}}" onInput="onPhoneInput" />
      <button class="btn-ghost" onTap="bindPhone">确认绑定</button>
    </view>

    <view class="card link-card" onTap="goOrders">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>

    <view class="card">
      <view class="title">智能记录的口味爱好</view>
      <view class="tip" a:if="{{prefsEmpty}}">支付成功后，系统会自动累计您常点的规格口味（辣度、面量、加料等），点餐时智能预选。</view>
      <block a:else>
        <view class="tip">根据历史订单自动学习；支付成功后更新画像，点餐时会智能预选常点规格。</view>
        <view class="pref-section" a:if="{{prefsConfirmed.length}}">
          <view class="pref-section-title">已确认偏好</view>
          <view class="pref-item" a:for="{{prefsConfirmed}}" a:key="key">
            <view class="pref-main">
              <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
              <text class="pref-meta">{{item.freqText}}</text>
            </view>
            <text class="pref-badge confirmed">{{item.statusText}}</text>
          </view>
        </view>
        <view class="pref-section" a:if="{{prefsLearning.length}}">
          <view class="pref-section-title">学习中</view>
          <view class="pref-item" a:for="{{prefsLearning}}" a:key="key">
            <view class="pref-main">
              <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
              <text class="pref-meta">{{item.freqText}}</text>
            </view>
            <text class="pref-badge learning">{{item.statusText}}</text>
          </view>
        </view>
        <button class="btn-primary" onTap="goMenu">按爱好去点餐</button>
      </block>
    </view>
  </block>
</view>
