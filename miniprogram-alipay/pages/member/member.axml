<view class="page">
  <view class="card">
    <view class="name">{{nickname || '面馆会员'}}</view>
    <view class="no">编号 {{customerNo}}</view>
  </view>
  <view class="card">
    <view class="row">
      <text>人脸迎宾</text>
      <switch checked="{{faceOn}}" onChange="onFaceSwitch" color="#1677ff" />
    </view>
    <view class="tip">需您主动授权。关闭后立即失效特征。</view>
  </view>
  <view class="card" a:if="{{prefs.length}}">
    <view class="title">根据您之前的口味</view>
    <view class="tag" a:for="{{prefs}}" a:key="option_code">{{item.category}} · {{item.option_code}}</view>
    <button class="btn-primary" onTap="reorder">一键复购去点餐</button>
  </view>
</view>
