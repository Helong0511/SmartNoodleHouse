<view class="page">
  <privacy-popup id="privacy-popup" />

  <store-bar compact="{{true}}" onTableChange="onTableChange" />

  <view class="page-body">
  <skeleton a:if="{{loading}}" type="member" />

  <block a:else>
    <view class="card member-card">
      <view class="auth-tip">授权头像、昵称、手机号，用于累计积分、会员打折及出餐提醒</view>
      <view class="profile">
        <button
          class="avatar-btn"
          open-type="getAuthorize"
          scope="userInfo"
          onGetAuthorize="onGetUserInfoAuthorize"
          onAuthError="onGetUserInfoFail"
        >
          <image a:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
          <view class="avatar placeholder" a:else>{{avatarLetter}}</view>
          <view class="avatar-edit-hint">点击授权头像</view>
        </button>
        <view class="meta">
          <view class="name-row" a:if="{{!editingName}}">
            <view class="name">{{displayName}}</view>
            <text class="link edit-name" onTap="startEditName">修改</text>
          </view>
          <view class="name-edit" a:else>
            <form onSubmit="onSaveNicknameForm">
            <input
              a:if="{{useAlipayNickname}}"
              class="name-input"
              type="nickname"
              name="nickname"
              maxlength="20"
              placeholder="支付宝昵称（点此授权）"
              value="{{nicknameDraft}}"
              onInput="onNicknameDraft"
              onNicknameReview="onNicknameDraftReview"
            />
            <input
              a:else
              class="name-input"
              type="text"
              name="nickname"
              maxlength="20"
              placeholder="请输入昵称（2-20字）"
              value="{{nicknameDraft}}"
              onInput="onNicknameDraft"
            />
            <view class="name-edit-actions">
              <text class="link muted" onTap="cancelEditName">取消</text>
              <button class="btn-save-name" size="mini" formType="submit" loading="{{savingName}}">保存</button>
            </view>
            </form>
          </view>
          <view class="no">编号 {{customerNo}}</view>
          <view class="level-row" a:if="{{isMember && memberLevelName}}">
            <text class="badge">{{memberLevelName}}</text>
            <text class="discount" a:if="{{memberDiscountText}}">享 {{memberDiscountText}}</text>
            <text class="discount muted-disc" a:else>当前等级无额外折扣</text>
          </view>
          <view class="activate-block" a:elif="{{!isMember}}">
            <text class="activate-title">开通智能会员</text>
            <view class="benefit-row">
              <text class="benefit-chip">会员折扣</text>
              <text class="benefit-chip">积分升级</text>
              <text class="benefit-chip">新客券</text>
              <text class="benefit-chip">储值权益</text>
            </view>
            <text class="hint">不影响点餐；开通后即可享等级折扣与积分，资料仅用于会员服务</text>
            <button class="btn-primary activate-btn" size="mini" loading="{{activatingMember}}" onTap="activateSmartMember">立即开通</button>
          </view>
          <view class="phone" a:if="{{phone}}">手机 {{phone}}</view>
        </view>
      </view>
      <view class="asset-strip">
        <view class="asset-cell" onTap="onAssetBalanceTap">
          <text class="asset-val">{{balanceDisplay}}</text>
          <text class="asset-label">{{balanceLabel}}</text>
        </view>
        <view class="asset-cell" onTap="onAssetPointsTap">
          <text class="asset-val">{{memberPoints}}</text>
          <text class="asset-label">积分</text>
        </view>
        <view class="asset-cell" onTap="goMenu">
          <text class="asset-val">{{walletAssetCount}}</text>
          <text class="asset-label">可用券</text>
        </view>
      </view>
      <view class="quick-actions">
        <view class="quick-btn primary" onTap="goMenu">去点餐</view>
        <view class="quick-btn" a:if="{{isMember}}" onTap="goRecharge">去充值</view>
        <view class="quick-btn" onTap="goOrders">我的订单</view>
      </view>
      <view class="progress-box" a:if="{{nextLevelName}}">
        <view class="progress-head">
          <text>距 {{nextLevelName}} 还差 {{pointsToNext}} 积分</text>
          <text class="pct">{{levelProgress}}%</text>
        </view>
        <view class="progress-track"><view class="progress-fill" style="width:{{levelProgress}}%"></view></view>
        <view class="progress-tip">{{pointsRule}}</view>
      </view>
      <view class="progress-box done" a:elif="{{isMember}}">
        <view class="progress-tip">已达最高等级；积分可用于兑券（不可结算抵现）</view>
      </view>
      <view class="exchange-box" id="points-exchange" a:if="{{isMember && pointsExchangeEnabled}}">
        <view class="exchange-title">积分兑券</view>
        <view class="tip" a:if="{{!exchangeOptions.length}}">暂无兑换档位，请稍后再来</view>
        <view class="exchange-item" a:for="{{exchangeOptions}}" a:key="id">
          <view class="exchange-main">
            <view class="wallet-name">{{item.name || item.coupon_name}}</view>
            <view class="wallet-rule">{{item.coupon_summary || item.coupon_name}}</view>
            <view class="wallet-expire">需 {{item.points_cost}} 积分</view>
          </view>
          <view
            class="wallet-use {{exchangingId == item.id ? 'is-disabled' : ''}}"
            data-id="{{item.id}}"
            catchTap="exchangePoints"
          >{{exchangingId == item.id ? '兑换中' : '兑换'}}</view>
        </view>
      </view>
      <view class="birthday-box">
        <view class="phone birthday-line">
          <text>生日历法</text>
          <radio-group class="cal-group" onChange="onBirthdayCalendarChange">
            <label class="cal-opt"><radio value="SOLAR" checked="{{birthdayCalendar === 'SOLAR'}}" color="#e67e22" disabled="{{birthdayLocked}}"/>公历</label>
            <label class="cal-opt"><radio value="LUNAR" checked="{{birthdayCalendar === 'LUNAR'}}" color="#e67e22" disabled="{{birthdayLocked}}"/>农历</label>
          </radio-group>
        </view>
        <picker mode="date" end="{{birthdayEnd}}" value="{{birthday}}" onChange="onBirthdayChange" disabled="{{birthdayLocked}}">
          <view class="phone birthday-line {{birthdayLocked ? 'birthday-locked' : ''}}" onTap="onBirthdayTap">
            生日 {{birthdayDisplay || birthday || '未填写 · 点击设置'}}
          </view>
        </picker>
        <view class="phone birthday-hint" a:if="{{birthdayLocked}}">生日已确认，不可自行修改；如需更正请联系门店</view>
        <view class="phone birthday-hint" a:elif="{{birthdayCalendar === 'LUNAR'}}">农历：所选月日即为农历月日（如五月初一）；确认后不可自行修改，更正请联系门店</view>
        <view class="phone birthday-hint" a:else>设置后需确认；确认后不可自行修改，如需更正请联系门店</view>
        <view class="phone birthday-benefit" a:if="{{birthdayBenefitText}}">{{birthdayBenefitText}}</view>
      </view>
    </view>

    <view class="card" a:if="{{memberLevels.length}}">
      <view class="title">{{isMember ? '会员等级与权益' : '开通后可享等级权益'}}</view>
      <view class="level-ladder">
        <view class="ladder-rail">
          <view class="ladder-fill" style="width:{{levelLadderFill}}%"></view>
        </view>
        <view class="ladder-nodes">
          <view
            class="ladder-node {{item.is_current ? 'current' : ''}} {{item.unlocked ? 'on' : ''}}"
            a:for="{{memberLevels}}"
            a:key="id"
          >
            <view class="ladder-dot"></view>
            <text class="ladder-name">{{item.shortName}}</text>
            <text class="ladder-disc">{{item.discLabel}}</text>
            <text class="ladder-pts">{{item.ptsLabel}}</text>
          </view>
        </view>
      </view>
      <view class="coupon-note">结算页可选优惠券与代金券（可叠加）；主动开通会员后自动获赠新客券。</view>
    </view>

    <view class="card" a:if="{{showSocialBenefit}}">
      <view class="title-row social-toggle" onTap="toggleSocialExpand">
        <view class="social-title-wrap">
          <view class="title">社会贡献公益</view>
          <view class="social-summary" a:if="{{socialSummary}}">{{socialSummary}}</view>
        </view>
        <text class="social-chevron">{{socialExpanded ? '▾' : '›'}}</text>
      </view>
      <view a:if="{{socialExpanded}}">
        <view class="tip" a:if="{{socialLoading}}">加载中...</view>
        <block a:else>
          <view class="tip" a:if="{{socialRevoked}}">您的公益身份已被取消，不可再次申请；如有疑问请到店咨询。</view>
          <view class="tip" a:elif="{{socialApproved}}">您的公益身份已审核通过，结算时可选用公益折扣。</view>
          <view class="tip" a:elif="{{!socialIdentities.length}}">到店出示工牌，可由收银员当场认定；也可在此申请（提交后进后台「社会贡献 → 待审认定」）。</view>
          <view class="wallet-item" a:for="{{socialIdentities}}" a:key="id">
            <view class="wallet-main">
              <view class="wallet-name">{{item.displayLabel}} · {{item.statusLabel}}</view>
              <view class="wallet-rule">{{item.credential_note || '已提交'}}</view>
            </view>
          </view>
          <view class="tip">公益与优惠券互斥；与会员折结算时取更优（折扣更低者）。开启公益后不可用券。</view>
          <view class="social-apply-grid" a:if="{{socialCanApply && socialApplyTypes.length}}">
            <button
              class="social-apply-btn"
              hover-class="social-apply-btn--active"
              loading="{{socialApplying}}"
              a:for="{{socialApplyTypes}}"
              a:key="code"
              data-code="{{item.code}}"
              onTap="applySocialIdentity"
            >申请{{item.name}}</button>
          </view>
          <view class="tip" a:elif="{{socialCanApply && !socialApplyTypes.length}}">暂无可申请身份，请稍后重试或到店核验。
          </view>
        </block>
      </view>
    </view>

    <view class="card" a:if="{{walletLoading || coupons.length || !hideMemberEmptyWallet}}">
      <view class="title-row">
        <view class="title">我的优惠券</view>
        <text class="link" onTap="loadWallet">刷新</text>
      </view>
      <view class="tip" a:if="{{walletLoading}}">加载中...</view>
      <view class="tip" a:elif="{{!coupons.length}}">暂无可用优惠券</view>
      <view class="wallet-item coupon {{item.expiringSoon ? 'expiring' : ''}}" a:for="{{coupons}}" a:key="id">
        <view class="wallet-main">
          <view class="wallet-name">{{item.displayName}}<text class="expire-tag" a:if="{{item.expiringSoon}}">即将到期</text></view>
          <view class="wallet-rule">{{item.summary}}</view>
          <view class="wallet-expire {{item.expiringSoon ? 'warn' : ''}}">{{item.expireText}}<text a:if="{{item.expiringSoon && item.daysLeft != null}}"> · 剩{{item.daysLeft}}天</text></view>
        </view>
        <view class="wallet-use" catchTap="goMenu">去使用</view>
      </view>
    </view>

    <view class="card" a:if="{{walletLoading || vouchers.length || !hideMemberEmptyWallet}}">
      <view class="title">我的代金券</view>
      <view class="tip" a:if="{{walletLoading}}">加载中...</view>
      <view class="tip" a:elif="{{!vouchers.length}}">暂无可用代金券</view>
      <view class="wallet-item voucher {{item.expiringSoon ? 'expiring' : ''}}" a:for="{{vouchers}}" a:key="id">
        <view class="wallet-main">
          <view class="wallet-name">{{item.displayName}}<text class="expire-tag" a:if="{{item.expiringSoon}}">即将到期</text></view>
          <view class="wallet-rule">{{item.summary}}</view>
          <view class="wallet-expire {{item.expiringSoon ? 'warn' : ''}}">{{item.expireText}}<text a:if="{{item.expiringSoon && item.daysLeft != null}}"> · 剩{{item.daysLeft}}天</text></view>
        </view>
        <view class="wallet-use" catchTap="goMenu">去使用</view>
      </view>
    </view>

    <view class="card" a:if="{{!phone}}">
      <view class="title">绑定手机号</view>
      <view class="tip">授权头像、昵称、手机号用于累计积分、会员打折及出餐提醒。手机号仅来自支付宝官方授权，防止被冒用。</view>
      <button
        a:if="{{canAlipayPhone && needPrivacyAgree}}"
        id="agree-phone-btn"
        class="btn-primary ali-phone"
        open-type="agreePrivacyAuthorization"
        onAgreePrivacyAuthorization="onPrivacyAgreeForPhone"
      >同意隐私并绑定手机号</button>
      <button
        a:elif="{{canAlipayPhone}}"
        class="btn-primary ali-phone"
        open-type="getAuthorize"
        scope="phoneNumber"
        onGetAuthorize="onGetPhoneAuthorize"
        onAuthError="onGetPhoneAuthorizeFail"
      >支付宝一键绑定手机号</button>
      <block a:if="{{showDevTips}}">
        <view class="manual-phone">
          <view class="or-line">调试用（仅开发环境，生产走官方授权）</view>
          <button class="btn-primary manual-phone-btn" size="mini" onTap="mockPhoneAuthorize">模拟一键授权获取手机号</button>
          <input
            class="phone-input"
            type="number"
            maxlength="11"
            placeholder="或手动输入11位手机号"
            value="{{phoneInput}}"
            onInput="onPhoneInput"
          />
          <button class="btn-primary manual-phone-btn" size="mini" loading="{{savingPhone}}" onTap="bindManualPhone">保存手输手机号</button>
        </view>
      </block>
      <view class="tip" a:else>当前小程序主体暂未开通支付宝一键取号能力，暂不能绑定手机号，不影响正常点餐。</view>
    </view>

    <view class="card">
      <view class="title-row social-toggle" onTap="toggleMoreServices">
        <view class="social-title-wrap">
          <view class="title">更多服务</view>
          <view class="social-summary">口味偏好 · 隐私设置{{showQueueEntry ? ' · 排队' : ''}}</view>
        </view>
        <text class="social-chevron">{{moreServicesExpanded ? '▾' : '›'}}</text>
      </view>
      <block a:if="{{moreServicesExpanded}}">
        <view class="more-block">
          <view class="pref-section-title">智能口味爱好</view>
          <view class="tip" a:if="{{prefsEmpty}}">支付成功后，系统会自动累计您常点的规格口味，点餐时智能预选。</view>
          <block a:else>
            <view class="tip">支付成功后更新画像，点餐时智能预选。</view>
            <view class="pref-section" a:if="{{prefsConfirmed.length}}">
              <view class="pref-item" a:for="{{prefsConfirmed}}" a:key="key">
                <view class="pref-main">
                  <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
                  <text class="pref-meta">{{item.freqText}}</text>
                </view>
                <text class="pref-badge confirmed">{{item.statusText}}</text>
              </view>
            </view>
            <view class="pref-section" a:if="{{prefsLearning.length}}">
              <view class="pref-item" a:for="{{prefsLearning}}" a:key="key">
                <view class="pref-main">
                  <text class="pref-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
                  <text class="pref-meta">{{item.freqText}}</text>
                </view>
                <text class="pref-badge learning">{{item.statusText}}</text>
              </view>
            </view>
            <button class="btn-primary" onTap="goMenu">按爱好去点餐</button>
          </block>
        </view>
        <view class="more-block">
          <view class="privacy-row link-row" onTap="goFlashSale">
            <text>限量免费抢购</text>
            <text class="arrow">›</text>
          </view>
          <view class="tip">射洪霸王面限量免费，抢到资格后到店出示核销码，逾期自动作废。</view>
        </view>
        <view class="more-block" a:if="{{showQueueEntry}}">
          <view class="privacy-row link-row" onTap="goQueue">
            <text>排队取号</text>
            <text class="arrow">›</text>
          </view>
          <view class="tip">高峰可先取号，叫号前提醒就近等位。</view>
        </view>
        <view class="more-block">
          <view class="pref-section-title">个性化推荐与隐私</view>
          <view class="tip">仅在同意时收集点餐行为以优化推荐；可随时关闭或清除画像。行为事件保留不超过 90 天。</view>
          <view class="privacy-row">
            <text class="privacy-label">个性化推荐</text>
            <switch
              checked="{{recommendOptIn === 1}}"
              onChange="onToggleRecommend"
              color="#ff6b35"
              disabled="{{updatingOptIn}}"
            />
          </view>
          <view class="privacy-row" a:if="{{showFaceWelcome}}">
            <text class="privacy-label">人脸迎宾</text>
            <switch
              checked="{{faceEnabled}}"
              onChange="onToggleFace"
              color="#ff6b35"
              disabled="{{updatingFace}}"
            />
          </view>
          <view class="tip" a:if="{{showFaceWelcome}}">开启后需动作挑战并用前置摄像头实拍；仅用于到店迎宾。</view>
          <view class="privacy-row link-row" onTap="onViewTasteProfile">
            <text>查看我的口味画像</text>
            <text class="arrow">›</text>
          </view>
          <view class="privacy-row link-row danger" onTap="onClearTasteProfile">
            <text>清除口味画像</text>
            <text class="arrow">›</text>
          </view>
          <view class="tip consent-tip" a:if="{{consentVersion}}">同意版本 {{consentVersion}}<text a:if="{{consentAt}}"> · {{consentAt}}</text></view>
        </view>
      </block>
    </view>
  </block>

  </view>

  <view class="profile-mask" a:if="{{showTasteProfile}}" onTap="closeTasteProfile">
    <view class="profile-sheet" catchTap="">
      <view class="sheet-title">我的口味画像</view>
      <scroll-view scroll-y class="sheet-body">
        <view a:if="{{!tasteProfile || (!tasteProfile.dimensions.CATEGORY.length && !tasteProfile.dimensions.PRODUCT.length && !tasteProfile.dimensions.TASTE_TAG.length && !tasteProfile.spec_preferences.length)}}" class="tip">暂无画像数据，完成订单后会自动学习。</view>
        <block a:else>
          <view class="dim-group" a:if="{{tasteProfile.dimensions.CATEGORY.length}}">
            <view class="dim-title">品类偏好</view>
            <view class="dim-item" a:for="{{tasteProfile.dimensions.CATEGORY}}" a:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" a:if="{{tasteProfile.dimensions.PRODUCT.length}}">
            <view class="dim-title">单品偏好</view>
            <view class="dim-item" a:for="{{tasteProfile.dimensions.PRODUCT}}" a:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" a:if="{{tasteProfile.dimensions.TASTE_TAG.length}}">
            <view class="dim-title">口味标签</view>
            <view class="dim-item" a:for="{{tasteProfile.dimensions.TASTE_TAG}}" a:key="target_key">
              <text class="dim-name">{{item.target_name || item.target_key}}</text>
              <text class="dim-score">权重 {{item.score}}</text>
            </view>
          </view>
          <view class="dim-group" a:if="{{tasteProfile.spec_preferences.length}}">
            <view class="dim-title">规格偏好</view>
            <view class="dim-item" a:for="{{tasteProfile.spec_preferences}}" a:key="option_code">
              <text class="dim-name">{{item.category}} · {{item.option_name || item.option_code}}</text>
              <text class="dim-score">下单 {{item.order_count}} 次</text>
            </view>
          </view>
        </block>
      </scroll-view>
      <button class="btn-primary" onTap="closeTasteProfile">关闭</button>
    </view>
  </view>
</view>
