.page { padding: 24rpx 24rpx calc(300rpx + env(safe-area-inset-bottom)); }
.loading-tip { text-align: center; color: #999; padding: 80rpx 0; font-size: 26rpx; }
.warn-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7e6;
  color: #d48806;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.warn-action { color: #1677ff; font-weight: 600; }
.item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}
.item.invalid { opacity: 0.72; background: #fafafa; }
.thumb-wrap {
  flex-shrink: 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f3f3f3;
}
.thumb { width: 100%; height: 100%; display: block; }
.thumb.placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: #1677ff; font-weight: 700; font-size: 32rpx;
  background: #e6f4ff;
}
.info { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 600; flex: 1; min-width: 0; }
.special-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #1677ff;
  border: 1rpx solid #91caff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.special-tip { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.invalid-tag { font-size: 24rpx; color: #ff4d4f; margin-top: 8rpx; }
.opts { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.unit { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.actions { text-align: right; flex-shrink: 0; margin-left: 8rpx; }
.qty { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.btn {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  background: #f5f5f5; border-radius: 8rpx; font-size: 32rpx;
}
.num { min-width: 40rpx; text-align: center; font-size: 28rpx; }
.line-total { font-size: 28rpx; color: #1677ff; margin-top: 12rpx; font-weight: 600; }
.del { display: inline-block; font-size: 24rpx; color: #999; margin-top: 12rpx; }
.footer {
  position: fixed; left: 0; right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #fff; padding: 20rpx 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  z-index: 10;
}
.footer-action {
  width: 168rpx;
  flex-shrink: 0;
}
.sum-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.sum {
  font-size: 28rpx;
  font-weight: 600;
  color: #1677ff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.sum-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
  white-space: nowrap;
}
.footer-link,
.footer-btn {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
  line-height: 1;
}
.footer-link {
  color: #1677ff;
  border: 1rpx solid #1677ff;
  background: #fff;
}
.footer-btn {
  color: #fff;
  background: #1677ff;
}
.footer-btn.is-disabled {
  opacity: 0.5;
}
.empty {
  text-align: center;
  margin-top: 100rpx;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; }
.empty-desc { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.empty-btn {
  margin-top: 40rpx;
  width: 280rpx;
  height: 72rpx;
  font-size: 28rpx;
  padding: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
