.page { padding: 24rpx 24rpx calc(300rpx + env(safe-area-inset-bottom)); }
.loading-tip { text-align: center; color: #999; padding: 80rpx 0; font-size: 26rpx; }
.warn-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7e6;
  color: #d48806;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
.warn-action { color: #1677ff; font-weight: 600; }
.item {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}
.item.invalid { opacity: 0.72; background: #fafafa; }
.thumb-wrap {
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f3f3f3;
}
.thumb { width: 100%; height: 100%; display: block; }
.thumb.placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: #1677ff; font-weight: 700; font-size: 32rpx;
  background: #e6f4ff;
}
.info {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}
.special-tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #1677ff;
  border: 1rpx solid #91caff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.special-tip { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.invalid-tag { font-size: 24rpx; color: #ff4d4f; margin-top: 8rpx; }
.opts {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  line-height: 1.5;
  word-wrap: break-word;
}
.unit { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.actions {
  flex-shrink: 0;
  margin-left: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  align-self: stretch;
}
.actions-top {
  flex-shrink: 0;
  width: 100%;
  text-align: right;
}
.qty {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}
.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
}
.qty-num {
  min-width: 40rpx;
  margin: 0 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #333;
}
.line-total {
  display: block;
  font-size: 28rpx;
  color: #e64340;
  margin-top: 12rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  width: 100%;
}
.del-wrap {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  min-height: 0;
}
.del {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  background: transparent;
  border: none;
  padding: 0;
}
.footer {
  position: fixed; left: 0; right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  background: #fff; padding: 20rpx 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.06);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  z-index: 10;
}
.footer-action {
  width: 168rpx;
  flex-shrink: 0;
}
.footer-action + .sum-wrap {
  margin-left: 16rpx;
}
.sum-wrap + .footer-action {
  margin-left: 16rpx;
}
.sum-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.sum {
  font-size: 28rpx;
  font-weight: 600;
  color: #e64340;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.sum-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
  white-space: nowrap;
}
.footer-link,
.footer-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
}
.footer-link {
  color: #1677ff;
  border: 1rpx solid #1677ff;
  background: #fff;
}
.footer-btn {
  color: #fff;
  background: #1677ff;
}
.footer-btn.is-disabled {
  opacity: 0.5;
}
.empty {
  text-align: center;
  margin-top: 100rpx;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #333; }
.empty-desc { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.empty-btn {
  margin-top: 40rpx;
  width: 280rpx;
  height: 72rpx;
  font-size: 28rpx;
}
