<view class="page">
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    seatLabel="{{seatLabel}}"
    compact="{{true}}"
    onTableChange="onTableChange"
  />

  <view class="loading-tip" a:if="{{loading}}">正在校验购物车...</view>

  <view class="empty" a:elif="{{!cart.length}}">
    <view class="empty-icon">🛒</view>
    <view class="empty-title">购物车是空的</view>
    <view class="empty-desc">去菜单挑选喜欢的面食吧</view>
    <button class="btn-ghost empty-btn" onTap="goMenu">继续点餐</button>
  </view>

  <block a:else>
    <view class="warn-bar" a:if="{{invalidCount > 0}}">
      <text>{{invalidCount}} 件商品不可下单（下架/售罄）</text>
      <text class="warn-action" onTap="clearInvalid">清除</text>
    </view>

    <view class="item {{item.invalid ? 'invalid' : ''}}" enable-flex a:for="{{cart}}" a:key="index">
      <view class="thumb-wrap" style="{{thumbStyle}}">
        <image a:if="{{item.imageUrl}}" class="thumb" src="{{item.imageUrl}}" mode="aspectFill" />
        <view a:else class="thumb placeholder">{{item.name[0] || '餐'}}</view>
      </view>
      <view class="info">
        <view class="name-row" enable-flex>
          <view class="name">{{item.name}}</view>
          <text class="special-tag" a:if="{{item.no_member_discount}}">特价</text>
        </view>
        <view class="invalid-tag" a:if="{{item.invalid}}">{{item.invalidReason}}</view>
        <view class="opts" a:elif="{{item.option_text}}">{{item.option_text}}</view>
        <view class="special-tip" a:elif="{{item.no_member_discount}}">不参与会员/券优惠</view>
        <view class="unit" a:if="{{!item.invalid}}">单价 ¥{{item.unit_price}}</view>
      </view>
      <view class="actions" enable-flex>
        <view class="actions-top">
          <view class="qty" enable-flex a:if="{{!item.invalid}}">
            <view class="qty-btn" data-index="{{index}}" data-delta="-1" onTap="changeQty">−</view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn" data-index="{{index}}" data-delta="1" onTap="changeQty">+</view>
          </view>
          <view class="line-total" a:if="{{!item.invalid}}">¥{{item.subtotal}}</view>
        </view>
        <view class="del-wrap" enable-flex>
          <view class="del" data-index="{{index}}" onTap="removeItem">删除</view>
        </view>
      </view>
    </view>

    <view class="footer" enable-flex>
      <view class="footer-action">
        <view class="footer-link" onTap="goMenu">继续点餐</view>
      </view>
      <view class="sum-wrap">
        <text class="sum">合计 ¥{{total}}</text>
        <text class="sum-sub" a:if="{{count}}">共 {{count}} 件</text>
      </view>
      <view class="footer-action">
        <view class="footer-btn {{invalidCount > 0 || count === 0 ? 'is-disabled' : ''}}" onTap="goConfirm">去结算</view>
      </view>
    </view>
  </block>
</view>
