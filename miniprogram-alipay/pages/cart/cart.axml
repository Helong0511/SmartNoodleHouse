<view class="page">
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    compact="{{true}}"
  />
  <view class="empty" a:if="{{!loading && !cart.length}}">
    <text>购物车是空的</text>
    <button class="btn-ghost" onTap="goMenu">继续点餐</button>
  </view>
  <block a:else>
    <view class="item" a:for="{{cart}}" a:key="index">
      <view class="thumb-wrap" style="{{thumbStyle}}">
        <image a:if="{{item.imageUrl}}" class="thumb" src="{{item.imageUrl}}" mode="aspectFill" />
        <view a:else class="thumb placeholder">{{item.name[0] || '餐'}}</view>
      </view>
      <view class="info">
        <view class="name-row">
          <view class="name">{{item.name}}</view>
          <text class="special-tag" a:if="{{item.no_member_discount}}">特价</text>
        </view>
        <view class="opts" a:if="{{item.option_text}}">{{item.option_text}}</view>
        <view class="special-tip" a:elif="{{item.no_member_discount}}">不参与会员/券优惠</view>
        <view class="unit">单价 ¥{{item.unit_price}}</view>
      </view>
      <view class="actions">
        <view class="qty">
          <text class="btn" data-index="{{index}}" data-delta="-1" onTap="changeQty">−</text>
          <text class="num">{{item.quantity}}</text>
          <text class="btn" data-index="{{index}}" data-delta="1" onTap="changeQty">+</text>
        </view>
        <view class="line-total">¥{{item.subtotal}}</view>
        <text class="del" data-index="{{index}}" onTap="removeItem">删除</text>
      </view>
    </view>
    <view class="footer">
      <button class="btn-ghost footer-link" onTap="goMenu">继续点餐</button>
      <text class="sum">合计 ¥{{total}}</text>
      <button class="btn-primary" onTap="goConfirm">去结算</button>
    </view>
  </block>
</view>
