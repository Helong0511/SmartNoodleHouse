<view class="page">
  <privacy-popup id="privacy-popup" />

  <view class="hero">
    <image class="brand-logo" src="/assets/logo.png" mode="aspectFill" />
    <view class="sub" a:if="{{storeName}}">{{storeName}}</view>
    <view class="sub" a:if="{{hasTable}}">{{seatLabel}} {{tableName}}</view>
    <view class="sub" a:elif="{{!loading && ready}}">尚未绑定桌台</view>
    <view class="sub" a:else>正在识别桌台...</view>
  </view>

  <view class="card" a:if="{{loading}}"><text>登录中，请稍候...</text></view>

  <view class="card" a:elif="{{ready}}">
    <view class="title">{{showMemberPrompt ? '注册会员，享受更多便利' : '欢迎回来'}}</view>
    <view class="desc">{{showMemberPrompt ? memberText : '完善头像、昵称、手机号后开始点餐。'}}</view>

    <view class="privacy-box" a:if="{{needPrivacyAgree}}">
      <view class="privacy-text">
        使用头像、昵称、手机号前，请先阅读并同意
        <text class="link" onTap="openPrivacyContract">《小程序隐私政策》</text>
      </view>
      <button
        id="agree-btn"
        class="btn-primary privacy-agree"
        open-type="agreePrivacyAuthorization"
        onAgreePrivacyAuthorization="onPrivacyAgree"
      >同意隐私政策</button>
    </view>

    <form onSubmit="onFormSubmit">
      <view class="profile-block">
        <view class="avatar-wrap">
          <button
            a:if="{{canChooseAvatar}}"
            class="avatar-btn"
            open-type="chooseAvatar"
            onChooseAvatar="onChooseAvatar"
          >
            <view class="avatar-inner">
              <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" a:if="{{avatarUrl}}" />
              <text class="avatar-ph" a:else>头</text>
            </view>
          </button>
          <view a:else class="avatar-btn avatar-static" onTap="onPickLocalAvatar">
            <view class="avatar-inner">
              <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" a:if="{{avatarUrl}}" />
              <text class="avatar-ph" a:else>头</text>
            </view>
          </view>
          <text class="avatar-label">{{canChooseAvatar ? '支付宝头像' : '点选头像'}}</text>
        </view>

        <view class="nick-wrap">
          <input
            a:if="{{useAlipayNickname}}"
            class="input nick"
            type="nickname"
            name="nickname"
            maxlength="20"
            placeholder="点此获取支付宝昵称"
            value="{{nickname}}"
            onInput="onNicknameInput"
            onBlur="onNicknameBlur"
            onNicknameReview="onNicknameReview"
          />
          <input
            a:else
            class="input nick"
            type="text"
            name="nickname"
            maxlength="20"
            placeholder="请输入昵称（2-20字）"
            value="{{nickname}}"
            onInput="onNicknameInput"
            onBlur="onNicknameBlur"
          />
          <text class="avatar-label">{{useAlipayNickname ? '点输入框→键盘上方选昵称' : '手动输入昵称'}}</text>
        </view>
      </view>

      <button class="btn-ghost album-btn" catchTap="onPickLocalAvatar">从相册选择头像</button>

      <view class="phone-box">
        <view class="phone-title">手机号</view>
        <view class="phone-ok" a:if="{{phone}}">已绑定 {{phone}}</view>
        <block a:else>
          <button
            a:if="{{canAlipayPhone && needPrivacyAgree}}"
            id="agree-phone-btn"
            class="btn-ghost phone-btn"
            open-type="agreePrivacyAuthorization"
            onAgreePrivacyAuthorization="onPrivacyAgreeForPhone"
          >同意隐私并授权手机号</button>
          <button
            a:elif="{{canAlipayPhone}}"
            class="btn-ghost phone-btn"
            open-type="getAuthorize"
            scope="phoneNumber"
            onGetAuthorize="onGetPhoneAuthorize"
            onAuthError="onGetPhoneAuthorizeFail"
          >支付宝授权手机号</button>
          <input
            class="input phone-input"
            type="number"
            maxlength="11"
            placeholder="请输入11位手机号"
            value="{{phoneInput}}"
            onInput="onPhoneInput"
          />
          <view class="dev-tip" a:if="{{!canAlipayPhone}}">个人主体请手输手机号；企业开通能力后在 .env 设 ENABLE_ALIPAY_PHONE_BIND=true 并重启后端</view>
        </block>
      </view>

      <view class="dev-tip" a:if="{{showDevTips && privacyTip}}">{{privacyTip}}</view>
      <view class="dev-tip debug" a:if="{{showDevTips && debugInfo}}">{{debugInfo}}</view>

      <button class="btn-primary" catchTap="onSubmitRegister" loading="{{saving}}">{{showMemberPrompt ? '注册并开始点餐' : '保存并开始点餐'}}</button>
    </form>

    <button class="btn-ghost skip" onTap="goMenu">先点餐，稍后再改</button>
    <button class="btn-ghost skip" onTap="scanTable">{{hasTable ? '重新扫码换桌' : '扫一扫绑桌'}}</button>
    <button class="btn-ghost skip" onTap="goMember">会员中心</button>
  </view>
</view>
