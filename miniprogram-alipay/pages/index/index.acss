.page { padding: 32rpx; }
.hero {
  background: linear-gradient(135deg, #1677ff, #69b1ff);
  color: #fff; border-radius: 24rpx; padding: 48rpx 32rpx; margin-bottom: 32rpx;
}
.brand-logo {
  display: block;
  width: 160rpx;
  height: 200rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.92);
}
.sub { margin-top: 12rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; }
.title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { color: #666; line-height: 1.6; margin-bottom: 24rpx; }

.profile-block {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.avatar-wrap {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.nick-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.avatar-btn {
  width: 96rpx;
  height: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #e6f4ff;
  line-height: 1 !important;
  display: block !important;
  box-sizing: border-box;
  border: none;
  position: relative;
}
.avatar-inner {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.avatar-img {
  width: 96rpx;
  height: 96rpx;
  display: block;
  border-radius: 50%;
}
.avatar-ph {
  color: #1677ff;
  font-weight: 700;
  font-size: 32rpx;
  line-height: 1;
}
.avatar-static {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e6f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
  background: #f5f5f5;
}
.avatar.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6f4ff;
  color: #1677ff;
  font-weight: 700;
  font-size: 32rpx;
}
.avatar-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #999;
  text-align: center;
  line-height: 1.3;
}
.input.nick {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  height: 96rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.profile-btn { margin-bottom: 8rpx; }
.album-btn { margin-bottom: 16rpx; }
.phone-box { margin: 8rpx 0 16rpx; }
.phone-title { font-weight: 600; margin-bottom: 12rpx; }
.phone-ok { color: #07c160; font-size: 26rpx; margin-bottom: 8rpx; }
.phone-input {
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  background: #fafafa;
}
.dev-tip { color: #999; font-size: 22rpx; line-height: 1.5; margin-bottom: 20rpx; }
.dev-tip.debug { color: #bbb; font-size: 20rpx; word-break: break-all; }
.phone-btn { margin-bottom: 8rpx; }
.privacy-box {
  background: #f0f7ff;
  border: 1px solid #bae0ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.privacy-text { color: #666; font-size: 24rpx; line-height: 1.6; margin-bottom: 16rpx; }
.privacy-agree { margin-top: 8rpx; }
.link { color: #1677ff; }
.skip { margin-top: 20rpx; }
