.page { padding: 24rpx 24rpx 140rpx; }
.top { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.table { font-weight: 600; }
.member { color: #1677ff; }
.cat { font-size: 30rpx; font-weight: 600; margin: 24rpx 0 8rpx; }

.product {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.thumb-wrap {
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.thumb { width: 100%; height: 100%; display: block; }

.thumb.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #e6f4ff, #f5f5f5);
}

.ph-text { font-size: 40rpx; color: #1677ff; font-weight: 700; }

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
}

.price { color: #1677ff; font-size: 34rpx; font-weight: 700; margin-top: 12rpx; }

.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #1677ff;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 48rpx;
  z-index: 10;
}

@media (min-width: 600px) {
  .product.wide { padding: 24rpx; }
  .name { font-size: 32rpx; }
}
