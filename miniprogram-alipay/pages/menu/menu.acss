.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #f7f7f7;
}
.search-wrap { flex-shrink: 0; padding: 0 24rpx 12rpx; }
.scan-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff7e6;
  color: #d48806;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
}
.scan-bar .scan-icon { font-size: 32rpx; }
.search {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}
.pref-bar {
  flex-shrink: 0;
  margin: 0 24rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  background: #f0f7ff;
  color: #1677ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.pref-main {
  flex: 1;
  min-width: 0;
}

.pref-title {
  display: block;
  font-weight: 600;
  font-size: 22rpx;
  margin-bottom: 6rpx;
  color: #1677ff;
}

.pref-brief {
  color: #666;
  line-height: 1.5;
  word-break: break-all;
}

.pref-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pref-tag {
  background: #fff;
  color: #666;
  border: 1rpx solid #b3d4ff;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.pref-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.pref-toggle,
.pref-link {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 0;
}

.pref-link {
  color: #1677ff;
}
.loading-tip, .empty-tip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}
.menu-layout {
  flex: 1;
  min-height: 0;
  display: flex;
  overflow: hidden;
}
.cat-nav {
  width: 168rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  height: 100%;
}
.cat-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.4;
  border-left: 6rpx solid transparent;
}
.cat-item.on {
  background: #fff;
  color: #1677ff;
  font-weight: 600;
  border-left-color: #1677ff;
}
.menu-body { flex: 1; height: 100%; background: #fff; }
.cat-section { padding: 0 16rpx; }
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  padding: 20rpx 8rpx 12rpx;
}
.product {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1px solid #f5f5f5;
}
.main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.quick-add {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  align-self: center;
  line-height: 52rpx;
  text-align: center;
  background: #e6f4ff;
  color: #1677ff;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: 700;
}
.thumb-wrap {
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f3f3f3;
}
.thumb { width: 100%; height: 100%; display: block; }
.thumb.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #e6f4ff, #f5f5f5);
}
.ph-text { font-size: 36rpx; color: #1677ff; font-weight: 700; }
.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.name-row { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.special-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #1677ff;
  border: 1rpx solid #91caff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.desc {
  color: #999;
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.price { color: #1677ff; font-size: 32rpx; font-weight: 700; margin-top: 8rpx; }
.body-pad { height: 140rpx; }
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #333;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-radius: 48rpx;
  z-index: 20;
}
.cart-icon { font-size: 32rpx; }
.cart-total { margin-left: auto; font-weight: 700; font-size: 32rpx; color: #91caff; }
