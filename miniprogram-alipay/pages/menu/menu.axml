<view class="page">
  <privacy-popup id="privacy-popup" />
  <store-bar compact="{{true}}" onTableChange="onTableChange" />

  <view class="scan-bar" a:if="{{!hasTable && !loading}}" onTap="scanTable">
    <text class="scan-icon">📷</text>
    <text>未绑定桌台，点击扫描桌台二维码</text>
  </view>

  <view
    class="table-order-bar"
    a:if="{{hasTable && !isTakeawayChannel && tableOrderCount}}"
    onTap="goOrders"
  >
    <view class="table-order-main">
      <text class="table-order-title">本桌已下单</text>
      <text class="table-order-brief">{{tableOrdersBrief}}</text>
    </view>
    <text class="table-order-link">查看 ›</text>
  </view>

  <view class="search-wrap" a:if="{{showMenuSearch}}">
    <input
      class="search"
      placeholder="搜索菜品"
      value="{{keyword}}"
      onInput="onSearch"
      confirm-type="search"
    />
  </view>

  <!-- favoritesOnly 时即使 favCount=0 也保留入口，防止筛选死局 -->
  <view class="fav-bar" a:if="{{favCount || favoritesOnly}}">
    <view class="fav-chip {{favoritesOnly ? 'on' : ''}}" catchTap="toggleFavFilter">♥ 收藏 · {{favCount}}</view>
  </view>

  <view class="pref-bar compact" a:if="{{showMenuSmartTaste && prefCount}}">
    <view class="pref-main" onTap="togglePrefExpand">
      <text class="pref-title">智能口味 · {{prefCount}}</text>
      <view class="pref-tags" a:if="{{prefExpanded}}">
        <text class="pref-tag" a:for="{{prefItems}}" a:key="{{item}}">{{item}}</text>
      </view>
      <text class="pref-brief" a:else>{{prefSummary}}</text>
    </view>
    <view class="pref-actions">
      <text class="pref-toggle" catchTap="togglePrefExpand">{{prefExpanded ? '收起' : '展开'}}</text>
      <text class="pref-link" catchTap="goMember">会员</text>
    </view>
  </view>

  <view
    class="reco-fold"
    a:if="{{showMenuGuessYouLike && recoReady && recoStoreId}}"
    onTap="toggleRecoExpand"
  >
    <text class="reco-fold-title">猜你喜欢</text>
    <text class="reco-fold-chevron">{{recoExpanded ? '▾' : '›'}}</text>
  </view>
  <recommend-strip
    a:if="{{showMenuGuessYouLike && recoReady && recoStoreId && recoExpanded}}"
    storeId="{{recoStoreId}}"
    scene="recommend_menu"
    trackScene="recommend"
    onOpen="onRecommendOpen"
    onAdd="onRecommendAdd"
  />

  <skeleton a:if="{{loading && !categories.length}}" type="menu" rows="{{5}}" />

  <view class="menu-layout" a:elif="{{categories.length}}">
    <scroll-view class="cat-nav" scroll-y="{{true}}">
      <view
        class="cat-item {{activeCat === item.id ? 'on' : ''}}"
        a:for="{{categories}}"
        a:key="id"
        data-id="{{item.id}}"
        onTap="onCatTap"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view
      class="menu-body"
      scroll-y="{{true}}"
      scroll-into-view="{{scrollInto}}"
      scroll-with-animation="{{true}}"
      onScroll="onMenuBodyScroll"
      onScrollToUpper="onMenuBodyScrollTop"
    >
      <block a:for="{{categories}}" a:key="id">
        <view id="cat-{{item.id}}" class="cat-section">
          <view class="cat-title">{{item.name}}</view>
          <view
            class="product {{isWide ? 'wide' : ''}} {{p.unavailable ? 'is-unavailable' : ''}}"
            a:for="{{item.products}}"
            a:for-item="p"
            a:key="id"
          >
            <view class="main" onTap="openProduct" data-id="{{p.id}}">
              <view class="thumb-wrap" style="{{p.thumbStyle}}">
                <image a:if="{{p.imageUrl}}" class="thumb" src="{{p.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
                <view a:else class="thumb placeholder">
                  <text class="ph-text">{{p.name[0] || '餐'}}</text>
                </view>
                <view class="sold-mask" a:if="{{p.unavailable}}">{{p.unavailableLabel || '已售罄'}}</view>
                <view class="fav-btn {{p.fav ? 'on' : ''}}" catchTap="toggleFav" data-id="{{p.id}}">♥</view>
              </view>
              <view class="info">
                <view class="name-row">
                  <view class="name">{{p.name}}</view>
                  <view class="tag-row" enable-flex>
                    <text class="flag-tag sold" a:if="{{p.unavailable}}">{{p.unavailableLabel || '已售罄'}}</text>
                    <text class="flag-tag hot" a:elif="{{p.is_hot}}">热销</text>
                    <text class="flag-tag reco" a:if="{{!p.unavailable && p.is_recommended}}">推荐</text>
                    <text class="special-tag" a:if="{{!p.unavailable && p.no_member_discount}}">特价</text>
                  </view>
                </view>
                <view class="desc" a:if="{{p.description && !p.unavailable}}">{{p.description}}</view>
                <view class="price">¥{{p.price}}</view>
              </view>
            </view>
            <view
              a:if="{{!p.unavailable}}"
              class="quick-add"
              catchTap="quickAdd"
              data-id="{{p.id}}"
              data-name="{{p.name}}"
              data-price="{{p.price}}"
              data-image="{{p.imageUrl}}"
              data-has-options="{{p.has_options}}"
              data-no-member-discount="{{p.no_member_discount}}"
            >+</view>
            <view a:else class="quick-add is-disabled">+</view>
          </view>
        </view>
      </block>
      <view class="body-pad"></view>
    </scroll-view>
  </view>

  <view
    class="empty-tip {{favoritesOnly ? 'empty-tip-action' : ''}}"
    a:elif="{{!loading && !categories.length}}"
    catchTap="exitFavFilter"
  >{{favoritesOnly ? '暂无收藏菜品，点击查看全部' : '暂无菜品'}}</view>

  <view class="cart-mask" a:if="{{cartSheetOpen && cart.length}}" catchTap="closeCartSheet"></view>
  <view class="cart-sheet {{cartSheetOpen ? 'open' : ''}}" a:if="{{cart.length}}">
    <view class="cart-sheet-head" enable-flex>
      <text class="cart-sheet-title">点餐明细</text>
      <text class="cart-sheet-clear" a:if="{{invalidCount > 0}}" catchTap="clearInvalidCart">清除失效</text>
    </view>
    <scroll-view class="cart-sheet-body" scroll-y="{{true}}">
      <view class="cart-item {{item.invalid ? 'invalid' : ''}}" enable-flex a:for="{{cart}}" a:key="cartKey">
        <view class="cart-thumb-wrap" style="{{cartThumbStyle}}">
          <image a:if="{{item.imageUrl}}" class="cart-thumb" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
          <view a:else class="cart-thumb placeholder">{{item.name[0] || '餐'}}</view>
        </view>
        <view class="cart-info">
          <view class="cart-name-row" enable-flex>
            <view class="cart-name">{{item.name}}</view>
            <text class="special-tag" a:if="{{item.no_member_discount}}">特价</text>
          </view>
          <view class="cart-invalid" a:if="{{item.invalid}}">{{item.invalidReason}}</view>
          <view class="cart-opts" a:elif="{{item.option_text}}">{{item.option_text}}</view>
          <view class="cart-unit" a:if="{{!item.invalid}}">单价 ¥{{item.unit_price}}</view>
        </view>
        <view class="cart-actions" enable-flex>
          <view class="actions-top">
            <view class="qty" enable-flex a:if="{{!item.invalid}}">
              <view class="qty-btn" data-index="{{index}}" data-delta="-1" catchTap="changeCartQty">−</view>
              <text class="qty-num">{{item.quantity}}</text>
              <view class="qty-btn" data-index="{{index}}" data-delta="1" catchTap="changeCartQty">+</view>
            </view>
            <view class="line-total" a:if="{{!item.invalid}}">¥{{item.subtotal}}</view>
          </view>
          <view class="del-wrap" enable-flex>
            <view class="del" data-index="{{index}}" catchTap="removeCartItem">删除</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="checkout-footer" enable-flex a:if="{{cart.length}}">
    <view class="footer-action">
      <view class="footer-link" catchTap="onFooterLeftTap">{{cartSheetOpen ? '继续点餐' : '点餐明细'}}</view>
    </view>
    <view class="sum-wrap" catchTap="onFooterLeftTap">
      <text class="sum">合计 ¥{{cartTotal}}</text>
      <text class="sum-sub" a:if="{{cartCount}}">共 {{cartCount}} 件</text>
    </view>
    <view class="footer-action">
      <view
        class="footer-btn {{invalidCount > 0 || cartCount === 0 ? 'is-disabled' : ''}}"
        catchTap="goCheckout"
      >去结算</view>
    </view>
  </view>
</view>
