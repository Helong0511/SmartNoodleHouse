<view class="page">
  <privacy-popup id="privacy-popup" />
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    seatLabel="{{seatLabel}}"
    compact="{{true}}"
    onTableChange="onTableChange"
  />

  <view class="scan-bar" a:if="{{!hasTable && !loading}}" onTap="scanTable">
    <text class="scan-icon">📷</text>
    <text>未绑定桌台，点击扫描桌台二维码</text>
  </view>

  <view class="search-wrap">
    <input
      class="search"
      placeholder="搜索菜品"
      value="{{keyword}}"
      onInput="onSearch"
      confirm-type="search"
    />
  </view>

  <view class="pref-bar" a:if="{{prefCount}}">
    <view class="pref-main" onTap="togglePrefExpand">
      <text class="pref-title">智能口味</text>
      <view class="pref-tags" a:if="{{prefExpanded}}">
        <text class="pref-tag" a:for="{{prefItems}}" a:key="{{item}}">{{item}}</text>
      </view>
      <text class="pref-brief" a:else>{{prefSummary}}</text>
    </view>
    <view class="pref-actions">
      <text class="pref-toggle" a:if="{{prefCount > 3}}" catchTap="togglePrefExpand">{{prefExpanded ? '收起' : '展开'}}</text>
      <text class="pref-link" catchTap="goMember">会员</text>
    </view>
  </view>

  <skeleton a:if="{{loading && !categories.length}}" type="menu" rows="{{5}}" />

  <view class="menu-layout" a:elif="{{categories.length}}">
    <scroll-view class="cat-nav" scroll-y="{{true}}">
      <view
        class="cat-item {{activeCat === item.id ? 'on' : ''}}"
        a:for="{{categories}}"
        a:key="id"
        data-id="{{item.id}}"
        onTap="onCatTap"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view
      class="menu-body"
      scroll-y="{{true}}"
      scroll-into-view="{{scrollInto}}"
      scroll-with-animation="{{true}}"
    >
      <block a:for="{{categories}}" a:key="id">
        <view id="cat-{{item.id}}" class="cat-section">
          <view class="cat-title">{{item.name}}</view>
          <view
            class="product {{isWide ? 'wide' : ''}}"
            a:for="{{item.products}}"
            a:for-item="p"
            a:key="id"
          >
            <view class="main" onTap="openProduct" data-id="{{p.id}}">
              <view class="thumb-wrap" style="{{p.thumbStyle}}">
                <image a:if="{{p.imageUrl}}" class="thumb" src="{{p.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
                <view a:else class="thumb placeholder">
                  <text class="ph-text">{{p.name[0] || '餐'}}</text>
                </view>
              </view>
              <view class="info">
                <view class="name-row">
                  <view class="name">{{p.name}}</view>
                  <text class="special-tag" a:if="{{p.no_member_discount}}">特价</text>
                </view>
                <view class="desc" a:if="{{p.description}}">{{p.description}}</view>
                <view class="price">¥{{p.price}}</view>
              </view>
            </view>
            <view
              class="quick-add"
              catchTap="quickAdd"
              data-id="{{p.id}}"
              data-name="{{p.name}}"
              data-price="{{p.price}}"
              data-image="{{p.imageUrl}}"
              data-has-options="{{p.has_options}}"
              data-no-member-discount="{{p.no_member_discount}}"
            >+</view>
          </view>
        </view>
      </block>
      <view class="body-pad"></view>
    </scroll-view>
  </view>

  <view class="empty-tip" a:elif="{{!loading && !categories.length}}">暂无菜品</view>
</view>
