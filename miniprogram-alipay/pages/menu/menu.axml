<view class="page">
  <view class="top">
    <text class="table" a:if="{{tableName}}">桌号 {{tableName}}</text>
    <text class="member" onTap="goMember">会员 · 口味</text>
  </view>
  <view class="pref-bar" a:if="{{prefSummary}}" onTap="goMember">
    <text>{{prefSummary}}</text>
    <text class="more">详情</text>
  </view>
  <block a:for="{{categories}}" a:key="id">
    <view class="cat">{{item.name}}</view>
    <view
      class="product {{isWide ? 'wide' : ''}}"
      a:for="{{item.products}}"
      a:for-item="p"
      a:key="id"
      onTap="openProduct"
      data-id="{{p.id}}"
    >
      <view class="thumb-wrap" style="{{p.thumbStyle}}">
        <image
          a:if="{{p.imageUrl}}"
          class="thumb"
          src="{{p.imageUrl}}"
          mode="aspectFill"
          lazy-load
        />
        <view a:else class="thumb placeholder">
          <text class="ph-text">{{p.name[0] || '餐'}}</text>
        </view>
      </view>
      <view class="info">
        <view class="name-row">
          <view class="name">{{p.name}}</view>
          <text class="special-tag" a:if="{{p.no_member_discount}}">特价</text>
        </view>
        <view class="desc" a:if="{{p.description}}">{{p.description}}</view>
        <view class="price">¥{{p.price}}</view>
      </view>
    </view>
  </block>
  <view class="cart-bar" onTap="goCart">购物车 {{cartCount}} · ¥{{cartTotal}}</view>
</view>
