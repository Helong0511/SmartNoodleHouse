<view class="page">
  <store-bar
    storeName="{{storeName}}"
    storeNo="{{storeNo}}"
    storeAddress="{{storeAddress}}"
    storePhone="{{storePhone}}"
    tableName="{{tableName}}"
    tableNo="{{tableNo}}"
    compact="{{true}}"
  />

  <skeleton a:if="{{loading && !orders.length}}" type="order" rows="{{4}}" />

  <view class="empty" a:elif="{{!loading && !orders.length}}">
    <view class="empty-title">暂无订单</view>
    <view class="empty-desc">点餐完成后可在此查看进度，并一键再来一单</view>
    <button class="btn-primary" onTap="goMenu">去点餐</button>
  </view>

  <block a:else>
    <view class="order" a:for="{{orders}}" a:key="id" onTap="openOrder" data-id="{{item.id}}">
      <view class="order-head">
        <view class="head-left">
          <text class="pickup-chip {{item.isReady ? 'ready' : ''}}" a:if="{{item.showPickupBanner}}">
            {{item.isTakeaway ? item.pickupCode : item.pickupLabel}} · {{item.customerStatusLabel}}
          </text>
          <text class="ono" a:else>{{item.order_no}}</text>
        </view>
        <text class="st">{{item.status_label || item.status}}</text>
      </view>
      <view class="place" a:if="{{item.placeText}}">{{item.placeText}}</view>
      <view class="order-body">{{item.item_summary}}</view>
      <view class="order-foot">
        <text class="meta-t">{{item.timeText}} · ¥{{item.total_amount}}<text a:if="{{item.discount_amount > 0}}" class="discount">（已优惠¥{{item.discount_amount}}）</text> · {{item.payLabel}}</text>
        <button
          class="btn-mini"
          size="mini"
          catchTap="reorderOrder"
          data-id="{{item.id}}"
          disabled="{{!item.can_reorder || reorderingId == item.id}}"
        >再来一单</button>
      </view>
    </view>
    <view class="list-foot">
      <text a:if="{{loadingMore}}">加载中...</text>
      <text a:elif="{{noMore}}">— 没有更多了 —</text>
    </view>
  </block>
</view>
