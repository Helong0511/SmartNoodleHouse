.page { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.price { color: #1677ff; font-size: 36rpx; margin: 12rpx 0 24rpx; }
.group { margin-bottom: 28rpx; }
.gname { font-weight: 600; margin-bottom: 12rpx; }
.opt { display: inline-block; padding: 12rpx 24rpx; margin: 0 12rpx 12rpx 0; background: #f2f2f2; border-radius: 32rpx; }
.opt.on { background: #e6f4ff; color: #1677ff; border: 1px solid #1677ff; }
