<view class="page">
  <view class="tip">金额由服务器重新计算，防止篡改</view>
  <view class="member-bar" a:if="{{isMember && memberLevelName}}">
    <text class="badge">{{memberLevelName}}</text>
    <text a:if="{{memberDiscountText}}">享 {{memberDiscountText}} 优惠</text>
  </view>
  <view class="table-box" a:if="{{!needPack}}">
    <view class="label">堂食桌号（必选）</view>
    <view a:if="{{tableToken && tableName}}" class="table-on">{{tableName}}</view>
    <picker a:elif="{{tableOptions.length}}" mode="selector" range="{{tableOptions}}" range-key="label" onChange="onPickTable">
      <view class="table-pick">{{pickedLabel || '请选择桌号'}}</view>
    </picker>
    <view a:else class="table-pick hint">请先扫码进入或联系店员协助选桌</view>
  </view>

  <view class="cart-box">
    <view class="label">已选商品</view>
    <view class="cart-line" a:for="{{cartPreview}}" a:key="index">
      <image a:if="{{item.imageUrl}}" class="mini" src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="mini placeholder" a:else>{{item.name[0] || '餐'}}</view>
      <view class="cart-info">
        <view class="cart-name-row">
          <text>{{item.name}} ×{{item.quantity}}</text>
          <text class="special-tag" a:if="{{item.no_member_discount}}">特价</text>
        </view>
        <text class="cart-price">¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="special-hint" a:if="{{hasSpecialItems}}">含特价商品：不参与会员折扣、优惠券及代金券</view>
    <view class="sum-row">
      <text>小计</text>
      <text>¥{{subtotal}}</text>
    </view>
    <view class="sum-row discount" a:if="{{hasDiscount}}">
      <text>会员优惠{{memberDiscountText ? '（' + memberDiscountText + '）' : ''}}</text>
      <text>-¥{{discountAmount}}</text>
    </view>
    <view class="sum-row discount" a:if="{{hasCouponDiscount}}">
      <text>优惠券</text>
      <text>-¥{{couponDiscountAmount}}</text>
    </view>
    <view class="sum-row discount" a:if="{{hasVoucherDiscount}}">
      <text>代金券</text>
      <text>-¥{{voucherDiscountAmount}}</text>
    </view>
    <view class="sum-row" a:if="{{needPack}}">
      <text>打包费（预估）</text>
      <text>¥{{packingFee}}</text>
    </view>
    <view class="sum-row total">
      <text>应付约</text>
      <text>¥{{payEstimate}}</text>
    </view>
  </view>

  <view class="coupon-box" a:if="{{coupons.length}}">
    <view class="label">优惠券</view>
    <picker mode="selector" range="{{couponPickerLabels}}" onChange="onPickCoupon">
      <view class="coupon-pick">{{selectedCouponLabel}}</view>
    </picker>
  </view>
  <view class="coupon-box" a:if="{{vouchers.length}}">
    <view class="label">代金券</view>
    <picker mode="selector" range="{{voucherPickerLabels}}" onChange="onPickVoucher">
      <view class="coupon-pick">{{selectedVoucherLabel}}</view>
    </picker>
  </view>

  <view class="pack-box">
    <view class="label">用餐方式</view>
    <view class="pack-row">
      <view class="pack-opt {{!needPack ? 'on' : ''}}" data-pack="0" onTap="onPack">堂食</view>
      <view class="pack-opt {{needPack ? 'on' : ''}}" data-pack="1" onTap="onPack">打包外带</view>
    </view>
    <view class="pack-tip" a:if="{{needPack}}">打包按商品餐盒费加收，以服务器结算为准</view>
  </view>
  <textarea class="remark" placeholder="备注" value="{{remark}}" onInput="onRemark" />
  <view class="pay">支付方式：支付宝</view>
  <button class="btn-primary" loading="{{loading}}" onTap="submit">提交并支付</button>
</view>
