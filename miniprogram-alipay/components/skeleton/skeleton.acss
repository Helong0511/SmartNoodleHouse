.sk-wrap { padding: 0 24rpx; }
.sk-block {
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.2s ease-in-out infinite;
  border-radius: 8rpx;
}
@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sk-search { height: 72rpx; margin: 16rpx 0; border-radius: 36rpx; }
.sk-menu-layout { display: flex; height: calc(100vh - 280rpx); }
.sk-nav { width: 168rpx; flex-shrink: 0; }
.sk-nav-item { height: 72rpx; margin-bottom: 12rpx; }
.sk-body { flex: 1; padding-left: 20rpx; }
.sk-product { display: flex; margin-bottom: 28rpx; }
.sk-thumb { width: 160rpx; height: 160rpx; flex-shrink: 0; border-radius: 12rpx; }
.sk-lines { flex: 1; margin-left: 20rpx; padding-top: 8rpx; }
.sk-line { height: 28rpx; margin-bottom: 16rpx; }
.sk-line-lg { width: 70%; }
.sk-line-sm { width: 40%; }

.sk-order-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk-order-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sk-order-head .sk-line-lg { width: 55%; }
.sk-order-head .sk-line-sm { width: 80rpx; }

.sk-product-detail { padding: 0; }
.sk-hero { width: 100%; height: 420rpx; border-radius: 0; }
.sk-pd-body { padding: 24rpx; }
.sk-price { width: 160rpx; height: 40rpx; margin: 24rpx 0; }

.sk-member { padding: 0; }
.sk-member-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.sk-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; flex-shrink: 0; }
.sk-m-lines { flex: 1; margin-left: 24rpx; }
.sk-card { height: 120rpx; border-radius: 20rpx; margin-bottom: 20rpx; }
