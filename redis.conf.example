# SmartNoodleHouse Redis 生产配置模板
# 主机/systemd 单机部署：复制为 /etc/redis/redis.conf 并使用 redis-server 启动。
# 容器部署须按容器网络调整 bind 与 REDIS_URL（容器内 127.0.0.1 不是宿主机/其他容器）；
# 仅允许专用容器私网互通，禁止为方便连接而绑定公网网卡或开放公网 6379。

# ── 网络 ──
# 默认单机部署只监听本机；禁止将 Redis 直接绑定 0.0.0.0 或公网网卡。
# 多机部署必须显式改成专用私网 IP，并用安全组/防火墙限制应用服务器来源。
bind 127.0.0.1
protected-mode yes
port 6379

# ── 认证（必须设置强密码）──
requirepass REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── 内存管理 ──
# 必须设置 maxmemory，禁止 64 位 Redis 默认无限制增长；512mb 是小型单店部署的保守示例，
# 按实测数据集、主机 RAM、MySQL/OS 占用调整。不要超过可用内存预算，并为 AOF/RDB fork 的
# copy-on-write 峰值、客户端缓冲和碎片预留足够空间。容量不足时应扩容/清理，不要盲目放大。
maxmemory 512mb
# 本项目 Redis 混合承载缓存、限流、一次性凭证、活体挑战和分布式锁。
# 必须使用 noeviction：达到 maxmemory 后写入返回 OOM，由关键路径 fail-closed，
# 避免 allkeys-lru 淘汰仍有效的锁、限流计数或一次性凭证，破坏安全/并发语义。
maxmemory-policy noeviction
# 纯缓存与协调/安全状态如需独立淘汰策略，应拆成两个 Redis 实例；纯缓存实例可按业务容忍度使用 allkeys-lru。

# ── AOF 持久化（优先于 RDB，数据安全性更高）──
appendonly yes
appendfilename "appendonly.aof"
# 每秒刷盘，在性能与数据安全间取平衡（最多丢 1s 数据）
appendfsync everysec
# 重写时不同步刷盘，避免 IO 阻塞
no-appendfsync-on-rewrite yes
# AOF 自动重写触发条件
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# ── RDB 持久化（作为 AOF 的补充灾备）──
save 900 1
save 300 10
save 60 10000
# RDB 文件压缩（CPU 换空间，通常值得）
rdbcompression yes
dbfilename dump.rdb

# ── 慢查询 ──
# 超过 10ms 的命令记录到慢日志
slowlog-log-slower-than 10000
slowlog-max-len 128

# ── 客户端 ──
# 连接超时 300s（清理空闲连接）
timeout 300
# 最大客户端连接数
# maxclients 1000

# ── 主从配置（如需高可用）───
# 主从切换时锁丢失风险：建议 Leader 锁使用 Redlock 或 fencing token
# replicaof <master-ip> <master-port>
# masterauth REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── 安全加固 ──
# 禁用危险命令
rename-command FLUSHDB ""
rename-command FLUSHALL ""
rename-command KEYS ""
rename-command CONFIG "CONFIG_9f3a2b7c"
