# =============================================================================
# 生产环境 — Ubuntu 22.04.5 服务器
#
# 用法：在服务器项目根目录复制为 .env
#   cp .env.production.example .env
#
# 配套配置（发布前必改）：
#   域名须已完成 ICP 备案并解析到中国大陆服务器（见 README「国内上线：服务器与 ICP 备案」）
#   微信小程序  miniprogram-wechat/config/env.js → PROD_API_BASE、ENABLE_WX_PRIVACY_APIS=true
#   支付宝小程序 miniprogram-alipay/config/env.js → PROD_API_BASE、ENABLE_ALIPAY_PRIVACY_APIS=true
#   微信 IDE    project.config.json → setting.urlCheck=true
#   Nginx       nginx/smart-noodle.conf → server_name、SSL 证书
#   systemd     systemd/smart-noodle.service
#
# 填写真实域名、数据库、支付密钥；切勿提交 .env 到 Git
# 部署命令：scripts/生产部署-ubuntu.txt
# =============================================================================

# -----------------------------------------------------------------------------
# 应用基础
# -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=SmartNoodleHouse
# Nginx 对外 443，uvicorn 仅监听本机回环
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# -----------------------------------------------------------------------------
# 数据库 / 缓存（同机或内网地址）
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/smart_noodle_house?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# 认证与安全（必须使用强随机密钥）
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
FACE_ENCRYPTION_KEY=replace-with-face-encryption-key-32bytes!!

# -----------------------------------------------------------------------------
# 生产禁止一切 mock
# -----------------------------------------------------------------------------
ALLOW_PAYMENT_MOCK=false
ALLOW_AUTH_MOCK=false
ALLOW_OPENCV_FACE_FALLBACK=false
ALLOW_DELIVERY_MOCK=false
ENABLE_RATE_LIMIT=true

# -----------------------------------------------------------------------------
# 跨域、H5 一码通扫、桌台码
# -----------------------------------------------------------------------------
# 对外 HTTPS 域名（与 Nginx server_name、小程序合法域名一致）
CORS_ORIGINS=https://your-domain.com
H5_PUBLIC_BASE_URL=https://your-domain.com
# 桌台码跳转小程序正式版（勿填 develop）
MINI_PROGRAM_ENV_VERSION=release
# DEV_LAN_HOST 仅本地开发使用，生产留空

# -----------------------------------------------------------------------------
# 前端 Vite（npm run build 后由 Nginx 托管 dist）
# -----------------------------------------------------------------------------
# 生产构建使用相对路径，由 Nginx 反代 /api 到 uvicorn
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# 文件上传（建议使用绝对路径）
# -----------------------------------------------------------------------------
UPLOAD_DIR=/var/www/smart-noodle/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
STORAGE_BACKEND=local
# 若用对象存储，改为 s3 并填写下方 S3_* 项
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
JSON_LOGS=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Webhook 安全（生产建议配置支付平台回调 IP 白名单）
# -----------------------------------------------------------------------------
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_REQUIRE_ALLOWLIST=true

# -----------------------------------------------------------------------------
# 微信（小程序 + 支付，全部必填）
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wxd0964c5d02b1549d
WECHAT_APP_SECRET=35f34d83ed4a921c84ea38c4a451ac18
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/etc/smart-noodle/certs/wechat_apiclient_key.pem
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_PLATFORM_CERT_PATH=/etc/smart-noodle/certs/wechat_platform_cert.pem
WECHAT_SUBSCRIBE_TEMPLATE_ORDER_READY=

# -----------------------------------------------------------------------------
# 支付宝（小程序 + 支付，全部必填）
# -----------------------------------------------------------------------------
# 小程序/应用 AppID（须与 miniprogram-alipay 配置一致）
ALIPAY_APP_ID=2021006196676140

# 应用私钥
ALIPAY_PRIVATE_

# 支付宝公钥
ALIPAY_PUBLIC_

# 开放平台「接口内容加密」AES；测支付宝授权手机号时填写，留空可手输手机号
ALIPAY_AES_KEY=bdhMews43oA7OcDXO/nXdA==
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/order/result
# -----------------------------------------------------------------------------
# 小程序隐私能力开关（经 GET /api/v1/miniprogram/config 下发；改后须重启后端）
# -----------------------------------------------------------------------------
# 【支付宝】头像 chooseAvatar / 昵称 nickname / 一键手机号
# true=显示平台授权入口；false=仅手输或相册（个人主体手机号须 false）
ENABLE_ALIPAY_AVATAR=true
ENABLE_ALIPAY_NICKNAME=true
ENABLE_ALIPAY_PHONE_BIND=true
# 【微信】头像 chooseAvatar / 昵称 nickname / 一键手机号
ENABLE_WX_AVATAR=true
ENABLE_WX_NICKNAME=true
ENABLE_WX_PHONE_BIND=true
# -----------------------------------------------------------------------------
# 注册欢迎券（微信/支付宝完成会员注册时自动发 1 张）
# -----------------------------------------------------------------------------
# 须与 coupon_templates.name 完全一致，且模板 status=1
# 换券：后台改模板名，或新建模板后把本项改成新名称并重启后端
WELCOME_COUPON_NAME=新客满30减5


MEITUAN_APP_ID=
MEITUAN_APP_SECRET=
MEITUAN_SHOP_ID=
MEITUAN_NOTIFY_URL=https://your-domain.com/api/v1/delivery/meituan/notify
MEITUAN_API_BASE=https://waimaiopen.meituan.com

ELEME_APP_ID=
ELEME_APP_SECRET=
ELEME_SHOP_ID=
ELEME_ACCESS_TOKEN=
ELEME_NOTIFY_URL=https://your-domain.com/api/v1/delivery/eleme/notify
ELEME_API_BASE=https://open-api.shop.ele.me/api/v1

DELIVERY_AUTO_CONFIRM=false

# -----------------------------------------------------------------------------
# 厨房热敏小票打印（推荐芯烨 XP-80T USB+WiFi）
# XP-80T WiFi = 局域网 ESC/POS（PRINTER_MODE=local + PRINTER_HOST），不是云打印
# 芯烨云 API（PRINTER_MODE=xpyun）仅用于云打印机型号，见 https://www.xpyun.net
# -----------------------------------------------------------------------------
# 打印总开关。有打印机时 true，并按模式配齐 PRINTER_HOST 或 XPYUN_* 凭证
XPYUN_ENABLED=false
PRINTER_MODE=local
PRINTER_HOST=
PRINTER_PORT=9100
XPYUN_PRINT_COPIES=1
# 芯烨云模式专用（XP-80T 局域网版不需要）
XPYUN_USER=
XPYUN_USER_KEY=
XPYUN_PRINTER_SN=
XPYUN_API_BASE=https://open.xpyun.net/api/openapi/xprinter
XPYUN_VOICE=2
# 【生产必须 false】禁止模拟打印；未配齐凭证时运行时报错，启动也会拒绝 ALLOW_PRINT_MOCK=true
ALLOW_PRINT_MOCK=false

# -----------------------------------------------------------------------------
# TTS / 摄像头 / 人脸识别
# -----------------------------------------------------------------------------
TTS_PROVIDER=local
TTS_VOICE=zh-CN
CAMERA_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
PROCESS_ROLE=leader
ENABLE_RECOGNITION_WORKER=1

# -----------------------------------------------------------------------------
# 业务参数
# -----------------------------------------------------------------------------
ORDER_PAYMENT_TIMEOUT_MINUTES=15
KITCHEN_AUTO_COMPLETE_MINUTES=20
VISITOR_DATA_RETENTION_DAYS=7
OPERATION_LOG_RETENTION_DAYS=90
WELCOME_COOLDOWN_SECONDS=60
FACE_MATCH_THRESHOLD=0.75
FACE_CONFIRM_FRAMES=3

# -----------------------------------------------------------------------------
# 顾客叫号屏访问令牌（建议设置，屏端 URL 加 ?token=）
# -----------------------------------------------------------------------------
DISPLAY_SCREEN_TOKEN=

# -----------------------------------------------------------------------------
# 初始化超管（首次部署执行 python scripts/init_admin.py）
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=你的强密码
# ADMIN_DISPLAY_NAME=系统管理员
